</node>
<node id="Hypokalemia">
  <data key="d0">Hypokalemia</data>
  <data key="d1">concept</data>
  <data key="d2">Hypokalemia is a condition characterized by below-normal potassium levels in blood serum, affecting nerve impulse conduction, muscle contraction, cell membrane function, and enzyme activity.</data>
  <data key="d3">chunk-f8a0239df88721094e3c51f8a7373134</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410760</data>
