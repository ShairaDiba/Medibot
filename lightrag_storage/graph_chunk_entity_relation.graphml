<node id="Immune Globulin">
  <data key="d0">Immune Globulin</data>
  <data key="d1">artifact</data>
  <data key="d2">Immune globulin is a preparation of antibodies given for short‑term protection against Hepatitis A after exposure.</data>
  <data key="d3">chunk-97bc31370eb8948b543aaf5f06eb9116</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405386</data>
</node>
<node id="Havrix Vaccine">
  <data key="d0">Havrix Vaccine</data>
  <data key="d1">artifact</data>
  <data key="d2">Havrix vaccine is a two‑dose vaccine that provides long‑term immunity against Hepatitis A.</data>
  <data key="d3">chunk-97bc31370eb8948b543aaf5f06eb9116</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405386</data>
</node>
<node id="Blood Test for HAV">
  <data key="d0">Blood Test for HAV</data>
  <data key="d1">method</data>
  <data key="d2">Blood test for HAV is a diagnostic method used to detect HAV infection and confirm Hepatitis A diagnosis.</data>
  <data key="d3">chunk-97bc31370eb8948b543aaf5f06eb9116</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405387</data>
</node>
<node id="Antiemetic">
  <data key="d0">Antiemetic</data>
  <data key="d1">artifact</data>
  <data key="d2">Antiemetic is a type of drug administered to control nausea and vomiting associated with Hepatitis A.</data>
  <data key="d3">chunk-97bc31370eb8948b543aaf5f06eb9116</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405387</data>
</node>
<node id="Contamination">
  <data key="d0">Contamination</data>
  <data key="d1">concept</data>
  <data key="d2">Contamination is the process by which food or water becomes exposed to the HAV virus through human waste, enabling transmission.</data>
  <data key="d3">chunk-97bc31370eb8948b543aaf5f06eb9116</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405387</data>
</node>
<node id="Epidemic">
  <data key="d0">Epidemic</data>
  <data key="d1">concept</data>
  <data key="d2">Epidemic describes a situation where a large number of Hepatitis A infections occur in a short period due to rapid transmission.</data>
  <data key="d3">chunk-97bc31370eb8948b543aaf5f06eb9116</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405387</data>
</node>
<node id="Fructose 1-Phosphate Aldolase">
  <data key="d0">Fructose 1-Phosphate Aldolase</data>
  <data key="d1">concept</data>
  <data key="d2">Fructose 1-phosphate aldolase is an alternative name for the enzyme Aldolase B, whose deficiency causes hereditary fructose intolerance.</data>
  <data key="d3">chunk-36c53d0d3d0b154d1cafa4ae311eafc9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405399</data>
</node>
