<node id="Oozing">
  <data key="d0">Oozing</data>
  <data key="d1">concept</data>
  <data key="d2">Oozing is a symptom that may appear in infected wounds due to bacterial activity.</data>
  <data key="d3">chunk-691c137b75421e29ad257ff721c4b853</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786384845</data>
</node>
<node id="Minor Wounds">
  <data key="d0">Minor Wounds</data>
  <data key="d1">concept</data>
  <data key="d2">Minor wounds are small injuries such as cuts, scrapes, or burns that can be treated with topical antibiotics to promote quicker healing.</data>
  <data key="d3">chunk-691c137b75421e29ad257ff721c4b853</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786384845</data>
