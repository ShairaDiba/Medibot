  <data key="d0">Haptoglobin Test</data>
  <data key="d1">method</data>
  <data key="d2">Diagnostic test used to evaluate a person for hemolytic anemia by measuring haptoglobin levels.</data>
  <data key="d3">chunk-6dcc52e74701dc594a5093895fbb8763</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403210</data>
</node>
<node id="Haptoglobin">
  <data key="d0">Haptoglobin</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A blood protein that binds free hemoglobin released from destroyed red blood cells to preserve iron.&lt;SEP&gt;Haptoglobin is a blood protein whose decreased levels indicate hemolysis and are associated with various conditions like liver disease and inherited deficiencies.</data>
  <data key="d3">chunk-6dcc52e74701dc594a5093895fbb8763&lt;SEP&gt;chunk-3a5fe7cfd2eb995bee47dc8e7a28fbbf</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403289</data>
</node>
<node id="Iron">
  <data key="d0">Iron</data>
  <data key="d1">naturalobject</data>
  <data key="d2">An essential mineral component of hemoglobin required for its function.&lt;SEP&gt;Iron is a trace` incomplete. So need corrected full description.</data>
  <data key="d3">chunk-6dcc52e74701dc594a5093895fbb8763&lt;SEP&gt;chunk-37a7bbdf4b8bdf03a0eb8a72a9561fd6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404180</data>
</node>
<node id="Macrophage">
  <data key="d0">Macrophage</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A type of white blood cell that transports the haptoglobin-hemoglobin complex to the liver.&lt;SEP&gt;Macrophages are immune cells that normally display Class II HLA antigens.</data>
  <data key="d3">chunk-6dcc52e74701dc594a5093895fbb8763&lt;SEP&gt;chunk-59ae7c2e485dd251483e45f48ced8031</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409381</data>
</node>
<node id="Acute Phase Reactant">
  <data key="d0">Acute Phase Reactant</data>
  <data key="d1">concept</data>
  <data key="d2">Proteins whose plasma concentrations increase or decrease in response to inflammation; haptoglobin is one.</data>
  <data key="d3">chunk-6dcc52e74701dc594a5093895fbb8763</data>
