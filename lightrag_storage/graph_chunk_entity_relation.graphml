  <data key="d0">H-2 Blockers</data>
  <data key="d1">concept</data>
  <data key="d2">H-2 Blockers is a disease/condition entry focusing on modulation of immune response, respiration, and acid secretion.</data>
  <data key="d3">chunk-91f1f0521effbc46ec1f542169ae21ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402778</data>
