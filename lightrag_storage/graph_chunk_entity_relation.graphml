<node id="Epiglottitis">
  <data key="d0">Epiglottitis</data>
  <data key="d1">concept</data>
  <data key="d2">Epiglottitis is a throat infection listed as a key term related to Croup.&lt;SEP&gt;Epiglottitis is inflammation of the epiglottis that can be caused by H. influenzae and may obstruct the airway.</data>
  <data key="d3">chunk-246a5f7e2057972c85a02d08655d00e9&lt;SEP&gt;chunk-bbc235c34c37663eef619f2c8affbe76</data>
  <data key="d4">unknown_source</data>
