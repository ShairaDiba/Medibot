  <data key="d5">1786424338</data>
</node>
<node id="Liver Biopsy">
  <data key="d0">Liver Biopsy</data>
  <data key="d1">method</data>
  <data key="d2">Liver biopsy is an invasive diagnostic procedure employed to evaluate hemochromatosis.&lt;SEP&gt;Liver Biopsy is a diagnostic procedure where a tissue sample of the liver is examined to confirm autoimmune hepatitis.</data>
  <data key="d3">chunk-3978e5151245a8ce567b224992eabb69&lt;SEP&gt;chunk-5d78fea89c4fad7d739948de01e91d4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405162</data>
</node>
<node id="Transferrin‑Iron Saturation">
  <data key="d0">Transferrin‑Iron Saturation</data>
  <data key="d1">data</data>
  <data key="d2">Transferrin‑iron saturation is a blood measurement used in iron studies to screen for hemochromatosis.</data>
  <data key="d3">chunk-5d78fea89c4fad7d739948de01e91d4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404756</data>
</node>
<node id="Ferritin Concentration">
  <data key="d0">Ferritin Concentration</data>
  <data key="d1">data</data>
  <data key="d2">Ferritin concentration is a blood measurement used in iron studies to screen for hemochromatosis.</data>
