  <data key="d0">Septicemia</data>
  <data key="d1">concept</data>
  <data key="d2">Septicemia is a bloodstream infection listed as a key term related to acute lymphangitis.</data>
  <data key="d3">chunk-bead2f9ad4273b49f336c30d5e85e2f1</data>
  <data key="d4">unknown_source</data>
