  <data key="d1">naturalobject</data>
  <data key="d2">Medicinal Herbs are plant-derived substances that can be toxic if consumed excessively.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422326</data>
</node>
