<node id="Prescription Drug">
  <data key="d0">Prescription Drug</data>
  <data key="d1">artifact</data>
  <data key="d2">A prescription drug is a medication prescribed by a healthcare professional that may provide immediate relief for insomnia.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Herbal Remedy">
  <data key="d0">Herbal Remedy</data>
  <data key="d1">artifact</data>
  <data key="d2">An herbal remedy is a plant‑based treatment that may be used for insomnia but often does not produce immediate effects.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412301</data>
</node>
<node id="Transient Insomnia">
  <data key="d0">Transient Insomnia</data>
  <data key="d1">concept</data>
  <data key="d2">Transient Insomnia is an alternative name for acute insomnia, describing a short‑term inability to sleep.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
