<node id="Polycystic Kidney Disease">
  <data key="d0">Polycystic Kidney Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Polycystic Kidney Disease is a life‑threatening genetic disorder characterized by fluid‑filled cysts forming in the kidneys.</data>
  <data key="d3">chunk-d855036a34135250bf6b6942f08845d7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422502</data>
</node>
<node id="Autosomal Dominant Polycystic Kidney Disease">
  <data key="d0">Autosomal Dominant Polycystic Kidney Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Autosomal Dominant Polycystic Kidney Disease is a common adult form of Polycystic Kidney Disease inherited as a dominant trait.</data>
  <data key="d3">chunk-d855036a34135250bf6b6942f08845d7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422502</data>
</node>
<node id="National Kidney and Urologic Disease Information Clearinghouse">
  <data key="d0">National Kidney and Urologic Disease Information Clearinghouse</data>
  <data key="d1">organization</data>
  <data key="d2">National Kidney and Urologic Disease Information Clearinghouse is an organization referenced in the text providing information about Polycystic Kidney Disease.</data>
  <data key="d3">chunk-d855036a34135250bf6b6942f08845d7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422503</data>
</node>
