</node>
<node id="Diagnostic and Statistical Manual of Mental Disorders (DSM–IV)">
  <data key="d0">Diagnostic and Statistical Manual of Mental Disorders (DSM–IV)</data>
  <data key="d1">artifact</data>
  <data key="d2">The DSM–IV is the fourth edition, text revision (2000) of the Diagnostic and Statistical Manual of Mental Disorders that defines personality disorders.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420001</data>
</node>
<node id="Temperament">
  <data key="d0">Temperament</data>
  <data key="d1">concept</data>
  <data key="d2">Temperament is described as a person's innate or biologically shaped basic disposition influencing personality disorders.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420001</data>
</node>
<node id="Character">
  <data key="d0">Character</data>
  <data key="d1">concept</data>
  <data key="d2">Character is defined as the set of attitudes shaped by family environment that interacts with temperament in the development of personality disorders.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420001</data>
</node>
<node id="Family Environment">
  <data key="d0">Family Environment</data>
  <data key="d1">concept</data>
  <data key="d2">Family environment is the external context that interacts with a child's temperament and character, contributing to personality disorders.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420001</data>
</node>
<node id="Human Infants">
  <data key="d0">Human Infants</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Human infants are noted to vary in sensitivity to light, noise, activity level, and adaptability, reflecting innate temperament traits.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420001</data>
</node>
<node id="Psychiatrists">
  <data key="d0">Psychiatrists</data>
  <data key="d1">person</data>
  <data key="d2">Psychiatrists are medical professionals who historically believed personality disorders responded poorly to treatment but now recognize potential for change.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420001</data>
</node>
<node id="Neuroleptic">
  <data key="d0">Neuroleptic</data>
  <data key="d1">concept</data>
  <data key="d2">Neuroleptic is a term for older antipsychotic medications such as haloperidol, mentioned in the context of prevention.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420001</data>
</node>
<node id="Exacerbation">
  <data key="d0">Exacerbation</data>
  <data key="d1">concept</data>
  <data key="d2">Exacerbation refers to periods of worsening in personality disorders.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420002</data>
</node>
<node id="Remission">
  <data key="d0">Remission</data>
  <data key="d1">concept</data>
  <data key="d2">Remission denotes periods of improvement in personality disorders.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420002</data>
</node>
<node id="Early Identification">
  <data key="d0">Early Identification</data>
  <data key="d1">method</data>
  <data key="d2">Early identification is a preventive method targeting children at risk of developing personality disorders.</data>
  <data key="d3">chunk-8b20a7bdac3dcdeae955d7f5fcff8809</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420002</data>
</node>
<node id="Pervasive Developmental Disorder">
  <data key="d0">Pervasive Developmental Disorder</data>
  <data key="d1">concept</data>
  <data key="d2">Pervasive developmental disorders comprise five conditions-Asperger syndrome, autistic disorder, childhood disintegrative disorder, pervasive developmental disorder not otherwise specified, and Rett’s syndrome-grouped due to similar communication, motor, and social skill deficits.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Autistic Disorder">
  <data key="d0">Autistic Disorder</data>
  <data key="d1">concept</data>
  <data key="d2">Autistic disorder is one of the five conditions grouped under pervasive developmental disorders, sharing deficits in communication, motor, and social skills.&lt;SEP&gt;Aut</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Childhood Disintegrative Disorder">
  <data key="d0">Childhood Disintegrative Disorder</data>
  <data key="d1">concept</data>
  <data key="d2">Childhood disintegrative disorder is a condition within pervasive developmental disorders characterized by a severe loss of previously acquired skills.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Pervasive Developmental Disorder Not Otherwise Specified">
  <data key="d0">Pervasive Developmental Disorder Not Otherwise Specified</data>
  <data key="d1">concept</data>
  <data key="d2">Pervasive developmental disorder not otherwise specified represents cases that do not meet criteria for the other specific disorders but share similar developmental deficits.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Retts Syndrome">
  <data key="d0">Retts Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Rett’s syndrome is a pervasive developmental disorder linked to a mutation in the MECP2 gene, affecting primarily females.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="MECP2">
  <data key="d0">MECP2</data>
  <data key="d1">data</data>
  <data key="d2">MECP2 is a gene whose mutation is present in 80% of individuals affected by Rett’s syndrome.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Brain Structure Abnormalities">
  <data key="d0">Brain Structure Abnormalities</data>
  <data key="d1">concept</data>
  <data key="d2">Brain structure abnormalities are hypothesized as possible contributors to pervasive developmental disorders.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Genetic Mutation">
  <data key="d0">Genetic Mutation</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic mutations are proposed as potential causes for pervasive developmental disorders.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Brain Function Alterations">
  <data key="d0">Brain Function Alterations</data>
  <data key="d1">concept</data>
  <data key="d2">Alterations in brain function are suggested as possible contributors to pervasive developmental disorders.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Convulsions">
  <data key="d0">Convulsions</data>
  <data key="d1">concept</data>
  <data key="d2">Convulsions are neurological conditions commonly found in individuals with pervasive developmental disorders.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Educational Programs">
  <data key="d0">Educational Programs</data>
  <data key="d1">method</data>
  <data key="d2">Educational programs for children with pervasive developmental disorders require a highly structured learning environment, low teacher–student ratios, and strong parental involvement.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Social Skills Training">
  <data key="d0">Social Skills Training</data>
  <data key="d1">method</data>
  <data key="d2">Social skills training is a therapeutic approach that can benefit individuals with pervasive developmental disorders.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Psychiatric Medications">
  <data key="d0">Psychiatric Medications</data>
  <data key="d1">artifact</data>
  <data key="d2">Psychiatric medications may help control particular behavior difficulties in pervasive developmental disorders.</data>
  <data key="d3">chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420019</data>
</node>
<node id="Pet Therapy">
  <data key="d0">Pet Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Pet therapy is listed as&lt;SEP&gt;Pet Therapy is an alternative therapy that utilizes trained animals and handlers to achieve therapeutic goals with patients, synonymous with Animal-Assisted Therapy.</data>
  <data key="d3">chunk-b8c896b91f897e5bbbd177234ee62ef5&lt;SEP&gt;chunk-8e02da87d46351e723d1298ee7642793</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420490</data>
</node>
<node id="Blood Pressure Measurement">
  <data key="d0">Blood Pressure Measurement</data>
  <data key="d1">method</data>
  <data key="d2">Blood pressure measurement comparing values above and below the pain point is used to diagnose Peripheral Vascular Disease.</data>
  <data key="d3">chunk-2718c6e6fa21ad7d51803e9bd95a0fa3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420076</data>
</node>
<node id="Perinatal Infection">
  <data key="d0">Perinatal Infection</data>
  <data key="d1">concept</data>
  <data key="d2">A severe infection transmitted from a mother to her baby during pregnancy, delivery, or shortly after birth, caused by bacteria or viruses.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420095</data>
</node>
<node id="Pelvic Inflammatory Disease">
  <data key="d0">Pelvic Inflammatory Disease</data>
  <data key="d1">concept</data>
  <data key="d2">A reproductive tract condition caused by Chlamydia trachomatis infection.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420095</data>
</node>
<node id="Ectopic Pregnancy">
  <data key="d0">Ectopic Pregnancy</data>
  <data key="d1">concept</data>
  <data key="d2">A pregnancy where the fertilized egg implants outside the uterus, associated with Chlamydia trachomatis infection.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420096</data>
</node>
<node id="Premature Rupture Of Membranes">
  <data key="d0">Premature Rupture Of Membranes</data>
  <data key="d1">concept</data>
  <data key="d2">Early breaking of the fetal membranes that can be induced by Chlamydia trachomatis infection.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420096</data>
</node>
<node id="Early Labor">
  <data key="d0">Early Labor</data>
  <data key="d1">concept</data>
  <data key="d2">Onset of labor earlier than term, which can be triggered by Chlamydia trachomatis infection.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420096</data>
</node>
<node id="Peripheral Vascular Disease">
  <data key="d0">Peripheral Vascular Disease</data>
  <data key="d3">chunk-2718c6e6fa21ad7d51803e9bd95a0fa3</data>
  <data key="d2">Peripheral Vascular Disease involves the cardiovascular system.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420105</data>
</node>
<node id="Periodontal Disease">
  <data key="d0">Periodontal Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Periodontal Disease is a chronic inflammatory disease affecting the tissues that support and anchor the teeth, leading to destruction of gums, alveolar bone, and tooth root layers.</data>
  <data key="d3">chunk-c98e85575a0fbf6c6f4d4ea25dc15ea4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420175</data>
</node>
<node id="Gums">
  <data key="d0">Gums</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gums, also called gingiva, are pink-colored mucus membranes covering parts of the teeth and the alveolar bone.</data>
  <data key="d3">chunk-c98e85575a0fbf6c6f4d4ea25dc15ea4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420175</data>
</node>
<node id="Periodontal Ligament">
  <data key="d0">Periodontal Ligament</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Periodontal Ligament is the main connective tissue component of the gums, supporting and anchoring teeth within the alveolar bone.</data>
  <data key="d3">chunk-c98e85575a0fbf6c6f4d4ea25dc15ea4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420175</data>
</node>
<node id="Alveolar Bone">
  <data key="d0">Alveolar Bone</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Alveolar Bone comprises the ridge of the jaw that holds the teeth and is destroyed in advanced periodontal disease.</data>
  <data key="d3">chunk-c98e85575a0fbf6c6f4d4ea25dc15ea4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420175</data>
</node>
<node id="Cementum">
  <data key="d0">Cementum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cementum is a calcified structure covering the lower portions of the teeth, vulnerable to damage from periodontal disease.</data>
  <data key="d3">chunk-c98e85575a0fbf6c6f4d4ea25dc15ea4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420175</data>
</node>
<node id="Tartar">
  <data key="d0">Tartar</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Tartar is hardened plaque that is difficult to remove by brushing and requires professional dental cleaning.</data>
  <data key="d3">chunk-c98e85575a0fbf6c6f4d4ea25dc15ea4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420175</data>
</node>
<node id="Gingivitis">
  <data key="d0">Gingivitis</data>
  <data key="d1">concept</data>
  <data key="d2">Gingivitis is inflammation of the gums that can be aggravated by hormones, pregnancy, puberty, birth control pills, and certain drugs.</data>
  <data key="d3">chunk-c98e85575a0fbf6c6f4d4ea25dc15ea4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420175</data>
</node>
