  <data key="d2">Bone marrow transplant is an experimental treatment option mentioned for Adrenoleukodystrophy.</data>
  <data key="d3">chunk-b1571076590b816bc3bb0de3b67b9a10</data>
  <data key="d4">unknown_source</data>
