  <data key="d3">chunk-fea6119439079b171fb416dd0c1a0f6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377851</data>
</node>
<node id="Histamine">
  <data key="d0">Histamine</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Histamine is a chemical released from mast cells during allergic responses.&lt;SEP&gt;Histamine is a chemical released by mast cells that contributes to allergic symptoms.&lt;SEP&gt;Histamine is a chemical released by mast cells that contributes to allergic symptoms.&lt;SEP&gt;Histamine is a biochemical that reaches H-2 receptors and triggers increased secretion of stomach acid.</data>
  <data key="d3">chunk-e59ab8338831484ea61486c70a6ad038&lt;SEP&gt;chunk-fea6119439079b171fb416dd0c1a0f6a&lt;SEP&gt;chunk-91f1f0521effbc46ec1f542169ae21ee</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402778</data>
</node>
<node id="TH1 Cell">
  <data key="d0">TH1 Cell</data>
  <data key="d1">naturalobject</data>
  <data key="d2">TH1 Cell is a T‑helper cell subtype that fights bacteria and viruses and protects against allergies.</data>
  <data key="d3">chunk-fea6119439079b171fb416dd0c1a0f6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377851</data>
</node>
<node id="TH2 Cell">
  <data key="d0">TH2 Cell</data>
  <data key="d1">naturalobject</data>
  <data key="d2">TH2 Cell is a T‑helper cell subtype that promotes excessive IgE production, increasing allergy likelihood.</data>
  <data key="d3">chunk-fea6119439079b171fb416dd0c1a0f6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377851</data>
