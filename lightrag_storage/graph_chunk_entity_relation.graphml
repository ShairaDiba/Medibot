  <data key="d0">Clotting Factors</data>
  <data key="d1">concept</data>
  <data key="d2">Clotting factors are substances in the blood that facilitate coagulation, and deficiencies can be identified via the Partial Thromboplastin Time test.</data>
  <data key="d3">chunk-ec14d30df69d510d9dcaa9c0f8a32fd9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419126</data>
