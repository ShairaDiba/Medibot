  <data key="d0">Hemochromatisis</data>
  <data key="d1">concept</data>
  <data key="d2">Hemochromatisis is a common, easily and effectively treated condition whose diagnosis may be difficult due to overlapping symptoms with other medical problems.</data>
  <data key="d3">chunk-7bace5728e2cd20cde6babfc53bd224f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404961</data>
