  <data key="d5">1786426878</data>
</node>
<node id="Pustular">
  <data key="d0">Pustular</data>
  <data key="d3">chunk-27addf854956380fbaa2c0b20a96027b</data>
  <data key="d2">Rashes can be described as pustular, a type consisting of pus‑containing skin blisters.</data>
