<node id="Edema">
  <data key="d0">Edema</data>
  <data key="d1">concept</data>
  <data key="d2">Edema is fluid accumulation in tissue, mentioned as a medical term in the description.&lt;SEP&gt;Edema is a symptom involving fluid accumulation in the abdomen and under the skin, associated with hepatitis B.</data>
  <data key="d3">chunk-b5a65a1c3cf6b8503607afdabf8b0202&lt;SEP&gt;chunk-8edba73be60673b1668775ee43b5d8dd</data>
  <data key="d4">unknown_source</data>
