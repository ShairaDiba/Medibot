  <data key="d1">method</data>
  <data key="d2">An imaging modality employing x‑rays, described as the type of test that PTHC represents.</data>
  <data key="d3">chunk-6c5e751c6db20a49f7ca0a341eadc654</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419483</data>
</node>
<node id="Digestive System">
  <data key="d0">Digestive System</data>
  <data key="d1">concept</data>
  <data key="d2">The digestive system receives bile from the liver and can be affected by flow disruptions.</data>
  <data key="d3">chunk-6c5e751c6db20a49f7ca0a341eadc654</data>
