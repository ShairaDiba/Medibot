  <data key="d0">Mucocutaneous Infections</data>
  <data key="d1">concept</data>
  <data key="d2">Mucocutaneous infections are skin and mucous membrane infections common in AIDS patients.</data>
  <data key="d3">chunk-86d3c253b310c081f68af15bdade4f77</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786376523</data>
</node>
