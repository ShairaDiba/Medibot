  <data key="d0">DNA Analysis</data>
  <data key="d1">method</data>
  <data key="d2">Technique to identify carriers of gene for hereditary fructose intolerance.</data>
  <data key="d3">chunk-e2668ae388ce75891b60c313b7cab62b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405558</data>
</node>
<node id="Hereditary Fructose Intolerance">
  <data key="d0">Hereditary Fructose Intolerance</data>
  <data key="d1">concept</data>
  <data key="d2">Hereditary disorder mentioned in prevention context, carriers can be identified.</data>
  <data key="d3">chunk-e2668ae388ce75891b60c313b7cab62b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405558</data>
</node>
<node id="Diet">
  <data key="d0">Diet</data>
  <data key="d1">concept</data>
  <data key="d2">Nutritional regimen whose control influences prognosis of the disease.&lt;SEP&gt;Diet refers to the pattern of food consumption influencing hyperlipoproteinemia.&lt;SEP&gt;Diet refers to dietary modifications, such as avoiding certain foods and beverages, recommended to manage indigestion symptoms.&lt;SEP&gt;Diet refers to the food intake, which the text states has no restrictions before or after parentage testing.&lt;SEP&gt;Diet refers to nutritional guidance, included as a component of polarity therapy.&lt;SEP&gt;A specific diet is recommended for patients after portal vein bypass.&lt;SEP&gt;Diet is an aspect discussed in prepregnancy counseling focusing on food intake.</data>
  <data key="d3">chunk-09ac7fad90c3ef5bbb1366ea8a473928&lt;SEP&gt;chunk-b785ff55416d26c9c9d2574c29ca4711&lt;SEP&gt;chunk-ca4ee33fbe169b1bec7c819c96b35eb6&lt;SEP&gt;chunk-696bd50fdda11571d3f3a3dd02534eb4&lt;SEP&gt;chunk-e2668ae388ce75891b60c313b7cab62b&lt;SEP&gt;chunk-0562388bfd043886184b76d26796a668&lt;SEP&gt;chunk-2c10b11558c17065dc27bd62ccb0fb84</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423559</data>
</node>
<node id="Hiatal Hernia">
  <data key="d0">Hiatal Hernia</data>
  <data key="d1">concept</data>
  <data key="d2">A condition where a weakness or gap in the diaphragm's large muscle creates an opening allowing the stomach to move into the chest.</data>
  <data key="d3">chunk-4bcaad1542ea8e041fd9f427e13e25c0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405603</data>
</node>
<node id="Congenital Hiatal Hernia">
  <data key="d0">Congenital Hiatal Hernia</data>
  <data key="d1">concept</data>
  <data key="d2">A form of hiatal hernia that can exist at birth.</data>
  <data key="d3">chunk-4bcaad1542ea8e041fd9f427e13e25c0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405603</data>
</node>
<node id="Diaphragm">
  <data key="d0">Diaphragm</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A large dome‑shaped sheet of muscle tissue spanning the left and right ribcage that separates the thoracic cavity from the abdominal cavity.&lt;SEP&gt;The diaphragm is a dome‑shaped muscle separating the chest and abdomen that expands the chest cavity for inhalation.&lt;SEP&gt;The diaphragm is strained...&lt;SEP&gt;The diaphragm is a muscular partition separating the thoracic and abdominal cavities, which may be removed during extrapleural pneumonectomy.</data>
  <data key="d3">chunk-c9098e6c377264351e34498ab20d1d2b&lt;SEP&gt;chunk-4bcaad1542ea8e041fd9f427e13e25c0&lt;SEP&gt;chunk-f81367bc23721681b080e8e55f88ab71&lt;SEP&gt;chunk-9afe775e3de6a2ede3813b294c2d7085</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422129</data>
</node>
<node id="Thoracic Cavity">
  <data key="d0">Thoracic Cavity</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The cavity within the chest that the diaphragm separates from the abdominal cavity.</data>
  <data key="d3">chunk-4bcaad1542ea8e041fd9f427e13e25c0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405603</data>
</node>
<node id="Esophageal Hiatus">
  <data key="d0">Esophageal Hiatus</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The area in the diaphragm through which the esophagus passes.</data>
  <data key="d3">chunk-4bcaad1542ea8e041fd9f427e13e25c0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405603</data>
</node>
<node id="Hernia Repair">
  <data key="d0">Hernia Repair</data>
  <data key="d1">method</data>
  <data key="d2">Hernia repair is a surgical procedure that returns a protruding organ to its original position by addressing a weakness in the abdominal wall.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405643</data>
</node>
<node id="General Surgeon">
  <data key="d0">General Surgeon</data>
  <data key="d1">person</data>
  <data key="d2">General surgeon is the medical professional who performs hernia repairs in hospitals or outpatient surgical facilities.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405643</data>
</node>
<node id="Outpatient Surgical Facility">
  <data key="d0">Outpatient Surgical Facility</data>
  <data key="d1">organization</data>
  <data key="d2">Outpatient surgical facility is a medical center where hernia repairs can be performed, often allowing same‑day discharge.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405643</data>
</node>
<node id="Herniorrhaphy">
  <data key="d0">Herniorrhaphy</data>
  <data key="d1">method</data>
  <data key="d2">Herniorrhaphy is a type of hernia repair used for simpler hernias, involving returning intestines to their proper place and mending the abdominal wall defect.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405643</data>
</node>
<node id="Hernioplasty">
  <data key="d0">Hernioplasty</data>
  <data key="d1">method</data>
  <data key="d2">Hernioplasty is a type of hernia repair used for larger hernias, involving placement of plastic or steel mesh to reinforce the abdominal wall.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405643</data>
</node>
<node id="Mesh">
  <data key="d0">Mesh</data>
  <data key="d1">artifact</data>
  <data key="d2">Mesh, made of plastic or steel, is a material added to the abdominal wall during hernioplasty to repair and reinforce a weak spot.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405643</data>
</node>
<node id="Gangrene">
  <data key="d0">Gangrene</data>
  <data key="d1">concept</data>
  <data key="d2">Gangrene is a key term listed, indicating a severe tissue‑death condition that can be a complication of hernia repair.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405644</data>
</node>
<node id="Improper Exercise">
  <data key="d0">Improper Exercise</data>
  <data key="d1">concept</data>
  <data key="d2">Improper exercise is described as a cause that can weaken abdominal muscles, contributing to hernias.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405644</data>
</node>
<node id="Poor Lifting Techniques">
  <data key="d0">Poor Lifting Techniques</data>
  <data key="d1">concept</data>
  <data key="d2">Poor lifting techniques are described as a cause of muscle weakening that may result in hernias.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405644</data>
</node>
<node id="Clear Liquid Diet">
  <data key="d0">Clear Liquid Diet</data>
  <data key="d1">content</data>
  <data key="d2">Clear liquid diet is recommended for patients after hernia repair until gastrointestinal function returns.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405644</data>
</node>
<node id="Antibiotic Ointment">
  <data key="d0">Antibiotic Ointment</data>
  <data key="d1">artifact</data>
  <data key="d2">Antibiotic ointment is mentioned as part of postoperative care after hernia repair.</data>
  <data key="d3">chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405644</data>
</node>
<node id="Body Systems">
  <data key="d0">Body Systems</data>
  <data key="d1">concept</data>
  <data key="d2">Physiological systems (neurological, gastrointestinal, musculoskeletal, renal) mentioned as potentially affected by herniated disk.&lt;SEP&gt;Body Systems refers to the physiological systems mentioned: endocrine, reproductive, and ophthalmological.</data>
  <data key="d3">chunk-3aaa529cbf4202ca2218a48e019cb104&lt;SEP&gt;chunk-e6d5f82c915dbc402d1fdeb23f98439f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412165</data>
</node>
<node id="Radiographic Tests">
  <data key="d0">Radiographic Tests</data>
  <data key="d1">method</data>
  <data key="d2">Imaging procedures such as X-ray and Myelography used to diagnose and locate herniated disks.</data>
  <data key="d3">chunk-3aaa529cbf4202ca2218a48e019cb104</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405680</data>
</node>
<node id="Corticosteroid">
  <data key="d0">Corticosteroid</data>
  <data key="d1">concept</data>
  <data key="d2">An anti-inflammatory drug administered in epidural steroid injections to reduce nerve inflammation.</data>
  <data key="d3">chunk-3aaa529cbf4202ca2218a48e019cb104</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405680</data>
</node>
<node id="Anti-inflammatory Drug">
  <data key="d0">Anti-inflammatory Drug</data>
  <data key="d1">concept</data>
  <data key="d2">Medication class used to reduce inflammation around nerve roots in herniated disk treatment.</data>
  <data key="d3">chunk-3aaa529cbf4202ca2218a48e019cb104</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405680</data>
</node>
<node id="Annulus Fibrosus">
  <data key="d0">Annulus Fibrosus</data>
  <data key="d3">chunk-3aaa529cbf4202ca2218a48e019cb104</data>
  <data key="d2">Annulus Fibrosus surrounds the Intervertebral Disk as its tough outer layer.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405680</data>
