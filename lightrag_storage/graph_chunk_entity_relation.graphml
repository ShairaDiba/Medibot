<node id="Bleeding Disorders">
  <data key="d0">Bleeding Disorders</data>
  <data key="d1">concept</data>
  <data key="d2">Bleeding disorders are medical conditions characterized by abnormal bleeding, which are investigated using the Partial Thromboplastin Time test.&lt;SEP&gt;Bleeding Disorders are medical conditions associated with low platelet counts or abnormal platelets.</data>
  <data key="d3">chunk-ec14d30df69d510d9dcaa9c0f8a32fd9&lt;SEP&gt;chunk-c07ccd2ac226d52ffc3c4068cddb090e</data>
