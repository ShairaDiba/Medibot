  <data key="d0">Curvature of the Penis</data>
  <data key="d1">concept</data>
  <data key="d2">Curvature of the penis is a symptom and alternative name for Peyronie's disease describing the bent shape of an erect penis.</data>
  <data key="d3">chunk-91b63fc7d102b55c2843666075d6ad7e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420389</data>
