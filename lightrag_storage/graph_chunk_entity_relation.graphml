  <data key="d0">High-Pressure Water Washing</data>
  <data key="d1">method</data>
  <data key="d2">High-pressure water washing is the technique of cleaning a bite wound by washing it with water under high pressure.</data>
  <data key="d3">chunk-b12e63d79b206980d9b85d5beb720662</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409037</data>
