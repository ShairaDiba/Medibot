  <data key="d0">Autosomal Dominant</data>
  <data key="d1">concept</data>
  <data key="d2">Inheritance pattern of the disease, involving a single copy of altered gene.</data>
  <data key="d3">chunk-e2668ae388ce75891b60c313b7cab62b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405557</data>
</node>
