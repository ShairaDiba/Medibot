  <data key="d0">Radiopaque Dye</data>
  <data key="d1">artifact</data>
  <data key="d2">Radiopaque Dye is the dye applied during an angiogram to provide radiopacity for vessel visualization.</data>
  <data key="d3">chunk-f414d4fa06aded8c4be440d5be905e48</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403839</data>
</node>
<node id="Heart Murmur">
  <data key="d0">Heart Murmur</data>
  <data key="d1">concept</data>
  <data key="d2">A heart murmur is an abnormal or extra sound heard during the heartbeat cycle, produced by turbulent or uneven blood flow through heart valves.&lt;SEP&gt;An abnormal heart sound that worsens with the Valsalva maneuver, indicative of hypertrophic cardiomyopathy.</data>
  <data key="d3">chunk-3167aac9bbeb660fe5ef8b641759df31&lt;SEP&gt;chunk-e534c2f61dae08dd6e4ae98c00c82c7d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410466</data>
</node>
<node id="Innocent Heart Murmur">
  <data key="d0">Innocent Heart Murmur</data>
  <data key="d1">concept</data>
  <data key="d2">A normal harmless type of heart murmur that does not affect health and requires no treatment.</data>
  <data key="d3">chunk-3167aac9bbeb660fe5ef8b641759df31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403943</data>
</node>
<node id="Pathologic Heart Murmur">
  <data key="d0">Pathologic Heart Murmur</data>
  <data key="d1">concept</data>
  <data key="d2">An abnormal harmful type of heart murmur caused by structural problems and may require treatment.</data>
  <data key="d3">chunk-3167aac9bbeb660fe5ef8b641759df31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403943</data>
</node>
<node id="Congenital Heart Murmur">
  <data key="d0">Congenital Heart Murmur</data>
  <data key="d1">concept</data>
  <data key="d2">A heart murmur present at birth, classified as a type of innocent or pathologic murmur depending on cause.</data>
  <data key="d3">chunk-3167aac9bbeb660fe5ef8b641759df31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403943</data>
</node>
<node id="Diastolic Murmur">
  <data key="d0">Diastolic Murmur</data>
  <data key="d1">concept</data>
  <data key="d2">A type of heart murmur that occurs during the heart's relaxation phase.</data>
  <data key="d3">chunk-3167aac9bbeb660fe5ef8b641759df31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403943</data>
</node>
<node id="Systolic Murmur">
  <data key="d0">Systolic Murmur</data>
  <data key="d1">concept</data>
  <data key="d2">A type of heart murmur that occurs during the heart's contraction phase.</data>
  <data key="d3">chunk-3167aac9bbeb660fe5ef8b641759df31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403943</data>
</node>
<node id="Turbulent Blood Flow">
  <data key="d0">Turbulent Blood Flow</data>
  <data key="d1">concept</data>
  <data key="d2">Irregular blood movement that creates audible sounds and can cause heart murmurs.</data>
  <data key="d3">chunk-3167aac9bbeb660fe5ef8b641759df31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403943</data>
</node>
<node id="Stress">
  <data key="d0">Stress</data>
  <data key="d1">concept</data>
  <data key="d2">A physical or mental strain that can contribute to the occurrence of heart murmurs.&lt;SEP&gt;Stress is a lifestyle factor that contributes to hyperlipoproteinemia.&lt;SEP&gt;Stress is a condition whose symptoms may be alleviated through reflexology.</data>
  <data key="d3">chunk-09ac7fad90c3ef5bbb1366ea8a473928&lt;SEP&gt;chunk-e261bddabf1598318602d5ab776f60c1&lt;SEP&gt;chunk-3167aac9bbeb660fe5ef8b641759df31</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426921</data>
</node>
<node id="Anemia">
  <data key="d0">Anemia</data>
  <data key="d1">concept</data>
  <data key="d2">A condition with low red blood cell count that can contribute to the occurrence of heart murmurs.&lt;SEP&gt;Anemia is a medical condition characterized by insufficient hemoglobin, leading to reduced oxygen transport.</data>
  <data key="d3">chunk-80e03e36082a52818b6740d8905c8a42&lt;SEP&gt;chunk-3167aac9bbeb660fe5ef8b641759df31</data>
