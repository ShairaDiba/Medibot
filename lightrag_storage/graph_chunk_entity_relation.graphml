  <data key="d4">unknown_source</data>
  <data key="d5">1786403745</data>
</node>
<node id="Heart Transplantation">
  <data key="d0">Heart Transplantation</data>
  <data key="d1">concept</data>
  <data key="d2">Heart Transplantation is a surgical procedure replacing a diseased heart with a donor organ, considered a last‑resort treatment for severe heart failure.&lt;SEP&gt;Heart Transplantation is a medical procedure that replaces a patient’s diseased or injured heart with a healthy donor heart, classified as a critical disease/condition affecting the cardiovascular system.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46&lt;SEP&gt;chunk-d99d14117824aa2b5637825772676446</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404041</data>
</node>
<node id="Dietary Changes">
  <data key="d0">Dietary Changes</data>
  <data key="d1">method</data>
  <data key="d2">Dietary Changes involve adjusting nutrient intake, such as reducing salt, to manage fluid retention in heart failure patients.&lt;SEP&gt;dietary modifications that can prevent kidney stones.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46&lt;SEP&gt;chunk-2a51c332fdfaf8c96be6ab58c809b221</data>
  <data key="d4">unknown_source</data>
