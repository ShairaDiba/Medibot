<node id="Dopamine">
  <data key="d0">Dopamine</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Dopamine is a neurotransmitter associated with the reward and euphoria experienced in addiction.&lt;SEP&gt;Dopamine is an excitatory neurotransmitter whose levels are increased by antidepressant drugs.&lt;SEP&gt;Dopamine is a neurotransmitter whose availability may be increased by appetite suppressant drugs.</data>
  <data key="d3">chunk-99238eefb790bd6f517ddd61b96753ae&lt;SEP&gt;chunk-2df310a5eb710fa15878efbe7d25bc7d&lt;SEP&gt;chunk-fff53a187c372ebdee1b2526a7ad3f69</data>
