<node id="Red Streaks">
  <data key="d0">Red Streaks</data>
  <data key="d1">concept</data>
  <data key="d2">Red streaks are wide, painful red lines traveling from the infection site to the armpit or groin, characteristic of acute lymphangitis.</data>
  <data key="d3">chunk-bead2f9ad4273b49f336c30d5e85e2f1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786374572</data>
