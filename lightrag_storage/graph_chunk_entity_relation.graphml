<node id="Croup">
  <data key="d0">Croup</data>
  <data key="d3">chunk-246a5f7e2057972c85a02d08655d00e9&lt;SEP&gt;chunk-87321e135d28e3df1041f920f312fe88</data>
  <data key="d2">Croup arises from an upper respiratory viral infection affecting the larynx and trachea.&lt;SEP&gt;Croup is a temporary, highly transmissible viral condition in children that commonly causes cough and usually resolves within three to six days.</data>
  <data key="d1">concept</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786397322</data>
</node>
<node id="Diphtheria">
