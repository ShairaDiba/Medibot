<node id="Process Addiction">
  <data key="d0">Process Addiction</data>
  <data key="d1">concept</data>
  <data key="d2">Process addiction refers to compulsive engagement in activities rather than substances, classified as a type of addiction.</data>
  <data key="d3">chunk-2df310a5eb710fa15878efbe7d25bc7d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786373999</data>
</node>
<node id="Relapse">
  <data key="d0">Relapse</data>
  <data key="d1">concept</data>
  <data key="d2">Relapse is the return to substance or activity use after a period of abstinence, common in addiction.</data>
  <data key="d3">chunk-2df310a5eb710fa15878efbe7d25bc7d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786373999</data>
</node>
<node id="Tolerance">
  <data key="d0">Tolerance</data>
  <data key="d1">concept</data>
  <data key="d2">Tolerance is the increasing need for more of a substance to achieve the same effect, characteristic of addiction.</data>
  <data key="d3">chunk-2df310a5eb710fa15878efbe7d25bc7d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786373999</data>
