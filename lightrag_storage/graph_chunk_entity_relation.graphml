  <data key="d3">chunk-b1b905af9bb1602798ef23bcfc2818c2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424230</data>
</node>
<node id="Vitamin D Deficiency">
  <data key="d0">Vitamin D Deficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Vitamin D deficiency causes bone pain and is a nutritional deficiency observed in Primary Biliary Cirrhosis.</data>
  <data key="d3">chunk-eff6cb4281c913c830bd641c706365c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424269</data>
</node>
<node id="Vitamin A Deficiency">
  <data key="d0">Vitamin A Deficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Vitamin A deficiency leads to night blindness and is associated with Primary Biliary Cirrhosis.</data>
  <data key="d3">chunk-eff6cb4281c913c830bd641c706365c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424269</data>
</node>
<node id="Vitamin E Deficiency">
  <data key="d0">Vitamin E Deficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Vitamin E deficiency may cause skin rashes and is linked to Primary Biliary Cirrhosis.</data>
  <data key="d3">chunk-eff6cb4281c913c830bd641c706365c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424269</data>
</node>
<node id="Essential Fatty Acid Deficiency">
  <data key="d0">Essential Fatty Acid Deficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Essential fatty acid deficiency can result in skin rashes and is noted in Primary Biliary Cirrhosis.</data>
  <data key="d3">chunk-eff6cb4281c913c830bd641c706365c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424269</data>
</node>
<node id="Ultraviolet Light Treatment">
  <data key="d0">Ultraviolet Light Treatment</data>
  <data key="d1">method</data>
  <data key="d2">Ultraviolet Light Treatment is a therapeutic method where upper skin layers are peeled off, used by dermatologists for Primary Biliary Cirrhosis.</data>
  <data key="d3">chunk-eff6cb4281c913c830bd641c706365c5</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424269</data>
</node>
