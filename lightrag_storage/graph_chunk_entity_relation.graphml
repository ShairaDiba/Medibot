<node id="Male Sexual Characteristics">
  <data key="d0">Male Sexual Characteristics</data>
  <data key="d1">concept</data>
  <data key="d2">Male sexual characteristics are physical traits such as facial hair, deeper voice, and musculature that are promoted by androgens.</data>
  <data key="d3">chunk-170bf8fe0c421cc796fb1a155cc92877</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786378854</data>
</node>
<node id="Tachycardia">
  <data key="d0">Tachycardia</data>
  <data key="d1">concept</data>
  <data key="d2">Tachycardia is an increased heart rate that can result from anabolic steroid use.</data>
  <data key="d3">chunk-170bf8fe0c421cc796fb1a155cc92877</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786378855</data>
