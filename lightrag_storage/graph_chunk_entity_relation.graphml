  <data key="d4">unknown_source</data>
  <data key="d5">1786375757</data>
</node>
<node id="Scar Tissue">
  <data key="d0">Scar Tissue</data>
  <data key="d1">concept</data>
  <data key="d2">Scar tissue is the fibrous material that composes adhesions and other healing structures.&lt;SEP&gt;Scar Tissue is the fibrous tissue that forms during wound healing, requiring blood vessel formation and fibroblast activity, and can be reduced by anti-inflammatory medications.&lt;SEP&gt;Scar tissue forms in the liver when damaged cells are replaced, leading to cirrhosis.</data>
  <data key="d3">chunk-6f6deb35c161bfdda7d3d14623d9a411&lt;SEP&gt;chunk-4c6845350ae9cecf9ea358b18b2d581b&lt;SEP&gt;chunk-385137de84f314dee795aa333d206111</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405261</data>
</node>
<node id="Blood Vessels">
  <data key="d0">Blood Vessels</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Blood vessels are connective tissue structures incorporated into adhesions.&lt;SEP&gt;Blood vessels are the circulatory tubes that dilate when alpha1 receptors are blocked, allowing easier blood flow.&lt;SEP&gt;Blood vessels are the target of angiographic imaging.&lt;SEP&gt;Blood vessels are the target of angiographic imaging.&lt;SEP&gt;Blood vessels within the mucus membranes provide the blood supply necessary for cartilage nutrition.&lt;SEP&gt;The blood vessels of the pulmonary artery that may become narrowed in pulmonary hypertension.</data>
  <data key="d3">chunk-6c5f40938298f68915d43c1e7cdd62e8&lt;SEP&gt;chunk-8428275c084088f8ee4bf166316b6e01&lt;SEP&gt;chunk-b10aa104383eb3ba74165d13d525ae5c&lt;SEP&gt;chunk-e1d14811c0b5a6299d4e8dbc3a469d37&lt;SEP&gt;chunk-4c6845350ae9cecf9ea358b18b2d581b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426310</data>
</node>
