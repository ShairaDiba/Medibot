  <data key="d0">Occupational Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Occupational therapy is a rehabilitative method to help paralytic Polio patients regain daily functional abilities.</data>
  <data key="d3">chunk-6a43117074cce1d59c31131832dfa007</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422232</data>
</node>
