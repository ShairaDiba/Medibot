  <data key="d4">unknown_source</data>
  <data key="d5">1786422232</data>
</node>
<node id="Hot Packs">
  <data key="d0">Hot Packs</data>
  <data key="d1">artifact</data>
  <data key="d2">Hot packs are therapeutic tools applied to relieve muscle aches in paralytic Polio patients.&lt;SEP&gt;Hot Packs are heat therapy devices applied to relieve pain and inflammation in Postpolio Syndrome.</data>
  <data key="d3">chunk-c71b04609b9999bd4f4017776dc567f0&lt;SEP&gt;chunk-6a43117074cce1d59c31131832dfa007</data>
