  <data key="d4">unknown_source</data>
  <data key="d5">1786404944</data>
</node>
<node id="Lung Disease">
  <data key="d0">Lung Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Lung disease refers to pulmonary conditions that may be identified during evaluation of hemoptysis.</data>
  <data key="d3">chunk-5bc0e87b467a3072004e86dd7a21ec8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404944</data>
</node>
<node id="Laboratory Tests">
  <data key="d0">Laboratory Tests</data>
  <data key="d1">method</data>
  <data key="d2">Laboratory tests are diagnostic procedures that include blood tests and analysis of sputum to identify causes of hemoptysis.&lt;SEP&gt;Laboratory tests of blood and urine samples are used to diagnose hyperemesis gravidarum.&lt;SEP&gt;Laboratory tests are diagnostic procedures used to identify pyelonephritis, including urinalysis, urine culture, and blood cell count.&lt;SEP&gt;Laboratory tests are diagnostic procedures used to identify pyelonephritis, including urinalysis, urine culture, and blood</data>
  <data key="d3">chunk-2600a22cecd1107559c673a4542b5d0f&lt;SEP&gt;chunk-cea23812b7285588a42ea7c6a323d1b6&lt;SEP&gt;chunk-5bc0e87b467a3072004e86dd7a21ec8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426590</data>
</node>
<node id="Clotting Disorders">
  <data key="d0">Clotting Disorders</data>
  <data key="d1">concept</data>
  <data key="d2">Clotting disorders are medical conditions checked by blood tests when investigating hemoptysis.</data>
  <data key="d3">chunk-5bc0e87b467a3072004e86dd7a21ec8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404945</data>
</node>
<node id="Food Particles">
  <data key="d0">Food Particles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Food particles are substances that may appear in blood tests, indicating possible gastrointestinal sources of hemoptysis.</data>
  <data key="d3">chunk-5bc0e87b467a3072004e86dd7a21ec8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404945</data>
</node>
<node id="Fungi">
  <data key="d0">Fungi</data>
  <data key="d1">creature</data>
  <data key="d2">Fungi are microorganisms that can be detected in sputum tests for hemoptysis.&lt;SEP&gt;Fungi are a group of organisms that can act as infective agents, leading to fungal infectious diseases.&lt;SEP&gt;Fungi are a class of organisms that can lead to pneumonia infections.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202&lt;SEP&gt;chunk-47a3a83e48113d48f0a14a70afb7ebf8&lt;SEP&gt;chunk-5bc0e87b467a3072004e86dd7a21ec8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421792</data>
</node>
<node id="Parasites">
  <data key="d0">Parasites</data>
  <data key="d1">creature</data>
  <data key="d2">Parasites are microorganisms that can be detected in sputum tests for hemoptysis.&lt;SEP&gt;Parasites are organisms included among the wide range of causes of pneumonia.</data>
  <data key="d3">chunk-47a3a83e48113d48f0a14a70afb7ebf8&lt;SEP&gt;chunk-5bc0e87b467a3072004e86dd7a21ec8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421792</data>
</node>
