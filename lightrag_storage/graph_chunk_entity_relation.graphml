  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Acquired forms of LQTS can be triggered by adrenaline (epinephrine) usage.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424540</data>
</node>
<node id="Cardiac Arrhythmias">
  <data key="d0">Cardiac Arrhythmias</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Cardiac Arrhythmias are a primary cause of Sudden Death, especially in the young population.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424542</data>
</node>
<node id="Severe Weight Loss">
  <data key="d0">Severe Weight Loss</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Severe weight loss is associated with anorexia nervosa.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424542</data>
</node>
<node id="Antihistamines">
  <data key="d0">Antihistamines</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Acquired forms of LQTS can be triggered by certain antihistamines.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424542</data>
</node>
<node id="Ion Balances">
  <data key="d0">Ion Balances</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Severe weight loss can disrupt ion balances in the heart.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424544</data>
</node>
<node id="Inherited Forms of LQTS">
