<node id="James Braid">
  <data key="d0">James Braid</data>
  <data key="d1">person</data>
  <data key="d2">James Braid is a pioneer who discovered that hypnosis could anesthetize patients for surgery, accidentally observed a patient enter a hypnotic state during an eye examination, and coined the term hypnotherapy after mesmerism fell out of favor."</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
