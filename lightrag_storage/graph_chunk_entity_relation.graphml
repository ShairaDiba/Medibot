  <data key="d1">other</data>
  <data key="d2">genetically linked metabolic disorders affecting enzymes regulating glycogen metabolism, causing varied symptoms such as muscle cramps, enlarged liver, low blood sugar.</data>
  <data key="d3">chunk-25a42943ad0f93e6631565dc2c851d36</data>
  <data key="d4">unknown_source</data>
