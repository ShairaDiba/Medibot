</node>
<node id="Milwaukee">
  <data key="d0">Milwaukee</data>
  <data key="d3">chunk-574b898c062ba598fbc6995f73a3afbf</data>
  <data key="d2">A 1993 outbreak of Cryptosporidiosis affecting over 400,000 persons was traced to Milwaukee's water supply.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786397303</data>
</node>
<node id="Water Supply">
  <data key="d0">Water Supply</data>
  <data key="d3">chunk-574b898c062ba598fbc6995f73a3afbf</data>
  <data key="d2">Contaminated water supplies are a documented source of Cryptosporidiosis infection.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786397305</data>
</node>
