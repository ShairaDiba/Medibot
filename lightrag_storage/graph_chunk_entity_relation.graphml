  <data key="d0">Ancient Greece</data>
  <data key="d1">location</data>
  <data key="d2">Ancient Greece is an ancient civilization cited as an early origin of hypnotherapy practices."</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
