<node id="G-Tube">
  <data key="d0">G-Tube</data>
  <data key="d1">artifact</data>
  <data key="d2">The g-tube is a tube inserted during a gastrostomy to provide feeding or drainage.</data>
  <data key="d3">chunk-1a321ea72ebe4c42d67faa7f47af64c7</data>
