  <data key="d0">Low Blood Fats</data>
  <data key="d1">concept</data>
  <data key="d2">Low blood fats denote the reduced level of circulating lipids in the bloodstream, characteristic of hypolipoproteinemia.</data>
  <data key="d3">chunk-d1e4ccd0ac838eb947c64fb34bbe1307</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410742</data>
