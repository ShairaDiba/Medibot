<node id="Adult Respiratory Distress Syndrome">
  <data key="d0">Adult Respiratory Distress Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Adult Respiratory Distress Syndrome (ARDS) is a syndrome of lung failure characterized by rapid accumulation of fluid in the lungs and is considered one of the most important forms of respiratory failure.</data>
  <data key="d3">chunk-436bf04244acb1c38f4b291e7d30ec94</data>
  <data key="d4">unknown_source</data>
