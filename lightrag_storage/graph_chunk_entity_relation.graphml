<node id="Recurrence">
  <data key="d0">Recurrence</data>
  <data key="d1">concept</data>
  <data key="d2">Recurrence refers to the possibility that Allergic Purpura may return after initial resolution.&lt;SEP&gt;Recurrence describes the reappearance of genital herpes outbreaks after a period of latency.</data>
  <data key="d3">chunk-784ba38e8bfe9ffbf875f5ee96725a4d&lt;SEP&gt;chunk-e46cef0181d6e65ea01360302ddd1f7b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400649</data>
</node>
