  <data key="d2">Complementary and alternative (CAM) treatments are non‑conventional therapeutic approaches incorporated into integrative medicine.</data>
  <data key="d3">chunk-6d18ad91bb57e38afe9e037c977bc3b6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412424</data>
