  <data key="d5">1786402844</data>
</node>
<node id="Gulf War Syndrome">
  <data key="d0">Gulf War Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Gulf War Syndrome is a disease/disorder describing a wide spectrum of illnesses and symptoms reported by United States and allied soldiers who served in the Persian Gulf War.</data>
  <data key="d3">chunk-b66d2f56572161b690b85278b6a11f68</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402898</data>
</node>
<node id="United States Allied Soldiers">
  <data key="d0">United States Allied Soldiers</data>
  <data key="d1">person</data>
  <data key="d2">United States Allied Soldiers are the military personnel from the United States and its allies who served in the Persian Gulf War and reported Gulf War Syndrome.</data>
  <data key="d3">chunk-b66d2f56572161b690b85278b6a11f68</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402898</data>
</node>
<node id="Persian Gulf War">
  <data key="d0">Persian Gulf War</data>
  <data key="d1">event</data>
  <data key="d2">Persian Gulf War was the conflict fought in 1990–1991 during which Gulf War Syndrome cases emerged among veterans.</data>
  <data key="d3">chunk-b66d2f56572161b690b85278b6a11f68</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402898</data>
</node>
<node id="Department of Defense">
  <data key="d0">Department of Defense</data>
  <data key="d1">organization</data>
  <data key="d2">Department of Defense is the U.S. defense agency that collected data from veterans reporting Gulf War-related illnesses.</data>
  <data key="d3">chunk-b66d2f56572161b690b85278b6a11f68</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402898</data>
</node>
<node id="Veterans Administration">
  <data key="d0">Veterans Administration</data>
  <data key="d1">organization</data>
  <data key="d2">Veterans Administration is the U.S. agency that registered veterans with Gulf War-related illnesses and contributed data for research.</data>
  <data key="d3">chunk-b66d2f56572161b690b85278b6a11f68</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402898</data>
</node>
<node id="Department of Veterans Affairs">
  <data key="d0">Department of Veterans Affairs</data>
  <data key="d1">organization</data>
  <data key="d2">Department of Veterans Affairs conducted research, including a 2006 study, on Gulf War Syndrome.</data>
  <data key="d3">chunk-b66d2f56572161b690b85278b6a11f68</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402898</data>
</node>
<node id="2006 Study">
  <data key="d0">2006 Study</data>
  <data key="d1">content</data>
  <data key="d2">The 2006 Study by the Department of Veterans Affairs concluded that Gulf War Syndrome does not constitute a single illness.</data>
  <data key="d3">chunk-b66d2f56572161b690b85278b6a11f68</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786402898</data>
</node>
<node id="Respiratory">
  <data key="d0">Respiratory</data>
  <data key="d1">concept</data>
  <data key="d2">Respiratory refers to the respiratory body system affected by Gulf War Syndrome.</data>
