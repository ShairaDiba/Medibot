  <data key="d0">Cancer Treatment</data>
  <data key="d1">concept</data>
  <data key="d2">Cancer treatment refers to medical interventions aimed at treating cancer, which was described as a breakthrough area for antiangiogenesis.</data>
  <data key="d3">chunk-43384133dfe3fd1b2a03d01d15878f94</data>
  <data key="d4">unknown_source</data>
