<node id="Eye Examination">
  <data key="d0">Eye Examination</data>
  <data key="d1">event</data>
  <data key="d2">Eye examination is the medical procedure during which James Braid observed a patient entering a hypnotic state.</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
