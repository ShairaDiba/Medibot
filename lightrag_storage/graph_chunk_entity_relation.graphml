  <data key="d5">1786409632</data>
</node>
<node id="Huntington Chorea">
  <data key="d0">Huntington Chorea</data>
  <data key="d1">other</data>
  <data key="d2">Huntington chorea is an alternative name for Huntington’s disease, referencing the involuntary movements.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409632</data>
</node>
<node id="Dance (Greek word)">
  <data key="d0">Dance (Greek word)</data>
  <data key="d1">concept</data>
  <data key="d2">The Greek word for “dance” describes the characteristic movements and gave rise to the term “chorea”.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409632</data>
</node>
<node id="Woody Guthrie">
  <data key="d0">Woody Guthrie</data>
  <data key="d1">person</data>
  <data key="d2">Woody Guthrie was a U.S. folk singer who died from Huntington’s disease.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409632</data>
</node>
<node id="HTT Gene">
  <data key="d0">HTT Gene</data>
  <data key="d1">concept</data>
  <data key="d2">The HTT gene is a genetic element whose mutations cause Huntington’s disease and encodes the huntingtin protein.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409632</data>
</node>
<node id="Huntingtin Protein">
  <data key="d0">Huntingtin Protein</data>
  <data key="d1">concept</data>
  <data key="d2">Huntingtin protein is produced from the HTT gene and, when mutated, includes an expanded CAG repeat that contributes to neuronal toxicity.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409633</data>
</node>
<node id="CAG Trinucleotide Repeat">
  <data key="d0">CAG Trinucleotide Repeat</data>
  <data key="d1">concept</data>
  <data key="d2">The CAG trinucleotide repeat is a DNA segment within the HTT gene that, when expanded, leads to an abnormal huntingtin protein.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409633</data>
</node>
