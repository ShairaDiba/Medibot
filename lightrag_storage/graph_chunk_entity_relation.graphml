</node>
<node id="Pain">
  <data key="d0">Pain</data>
  <data key="d1">concept</data>
  <data key="d2">Pain is a sensation that amputation may aim to relieve.&lt;SEP&gt;Pain described as tearing, ripping, or stabbing is a symptom associated with aortic dissection and may be reported by patients with aortic valve insufficiency.&lt;SEP&gt;Pain is a symptom experienced under the right ribs by patients with autoimmune hepatitis.&lt;SEP&gt;Pain is a sensation of discomfort that can be reduced by rest and elevation during immobilization.&lt;SEP&gt;Pain is listed as a possible risk associated with physical therapy.&lt;SEP&gt;Pain is a possible complication experienced after a prostate needle biopsy.</data>
  <data key="d3">chunk-f9a8349d932728e6875da544c19a0cc3&lt;SEP&gt;chunk-83aebc72b8b7f7141e25e88c35f39530&lt;SEP&gt;chunk-abbfd6cbf4afd6662ba2707fbc17c147&lt;SEP&gt;chunk-e8411522bdeb607aaa222e6502bca7dc&lt;SEP&gt;chunk-097e88fc7e1ff542a919812e0d0d508a&lt;SEP&gt;chunk-3978e5151245a8ce567b224992eabb69</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424846</data>
</node>
<node id="Traumatic Injury">
  <data key="d0">Traumatic Injury</data>
  <data key="d1">concept</data>
  <data key="d2">Traumatic injury is a cause that can lead to amputation.</data>
  <data key="d3">chunk-097e88fc7e1ff542a919812e0d0d508a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786379125</data>
</node>
<node id="Amyloid">
  <data key="d0">Amyloid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Amyloid refers to the abnormal protein that forms deposits in organs in amyloidosis.</data>
  <data key="d3">chunk-08dacc20215db14b42730a5441dcba75</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786379169</data>
</node>
<node id="Organ Failure">
  <data key="d0">Organ Failure</data>
  <data key="d1">concept</data>
  <data key="d2">Organ failure is a severe outcome that can result from amyloidosis impairing normal organ function.</data>
  <data key="d3">chunk-08dacc20215db14b42730a5441dcba75</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786379169</data>
</node>
<node id="Death">
  <data key="d0">Death</data>
  <data key="d1">concept</data>
  <data key="d2">Death is a possible ultimate outcome of amyloidosis when organ failure occurs.&lt;SEP&gt;Death is a possible fatal outcome of untreated anaphylaxis.&lt;SEP&gt;Death is a possible fatal outcome of untreated anaphylaxis.</data>
  <data key="d3">chunk-08dacc20215db14b42730a5441dcba75&lt;SEP&gt;chunk-e59ab8338831484ea61486c70a6ad038</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786383938</data>
</node>
<node id="Malnutrition">
  <data key="d0">Malnutrition</data>
  <data key="d1">concept</data>
  <data key="d2">Malnutrition is a condition caused by impaired nutrient absorption due to gastrointestinal involvement in amyloidosis.&lt;SEP&gt;Malnutrition is a condition that can lead to nondeliberate immunosuppression.</data>
  <data key="d3">chunk-08dacc20215db14b42730a5441dcba75&lt;SEP&gt;chunk-b29429d857edf1192105634eda51b928</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411668</data>
</node>
