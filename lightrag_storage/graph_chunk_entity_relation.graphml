  <data key="d1">concept</data>
  <data key="d2">Salicylate Poisoning is a specific type of poisoning caused by excessive ingestion of salicylates such as aspirin.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422326</data>
</node>
