  <data key="d0">Personal Hygiene</data>
  <data key="d1">method</data>
  <data key="d2">Personal hygiene entails individual practices that reduce the risk of acquiring amebiasis.</data>
  <data key="d3">chunk-02e1b300199e25407d954c8745371d3a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786378555</data>
