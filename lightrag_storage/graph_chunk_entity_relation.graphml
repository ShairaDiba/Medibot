  <data key="d0">Kegel Exercises</data>
  <data key="d1">method</data>
  <data key="d2">Kegel exercises involve squeezing pelvic floor muscles that stop urine flow and can strengthen the pelvic floor to lessen symptoms of pelvic relaxation.</data>
  <data key="d3">chunk-2d8fe6834775c118dee9d1addc0b895c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419540</data>
</node>
<node id="Estrogen Supplements">
  <data key="d0">Estrogen Supplements</data>
  <data key="d1">artifact</data>
  <data key="d2">Estrogen supplements are hormonal supplements that can strengthen pelvic floor muscles and are used as a treatment option for pelvic relaxation.</data>
  <data key="d3">chunk-2d8fe6834775c118dee9d1addc0b895c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419540</data>
</node>
<node id="Perforated Septum">
  <data key="d0">Perforated Septum</data>
  <data key="d1">concept</data>
  <data key="d2">Perforated Septum is a disease condition characterized by a hole in the nasal septum.</data>
  <data key="d3">chunk-6c5f40938298f68915d43c1e7cdd62e8</data>
  <data key="d4">unknown_source</data>
