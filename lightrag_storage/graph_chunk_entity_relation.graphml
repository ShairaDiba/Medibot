  <data key="d5">1786403548</data>
</node>
<node id="Altha Roberts Edgren">
  <data key="d0">Altha Roberts Edgren</data>
  <data key="d1">person</data>
  <data key="d2">Altha Roberts Edgren is a name listed under causes, though their specific connection to Hartnup disease is not detailed.</data>
  <data key="d3">chunk-3a5fe7cfd2eb995bee47dc8e7a28fbbf</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403291</data>
