  <data key="d5">1786424273</data>
</node>
<node id="Progressive Supranuclear Palsy">
  <data key="d0">Progressive Supranuclear Palsy</data>
  <data key="d1">concept</data>
  <data key="d2">Progressive supranuclear palsy (PSP) is a rare disease that gradually destroys nerve cells in brain regions controlling eye movements, breathing, and muscle coordination.</data>
  <data key="d3">chunk-2408b24dbbf82011285a46aaece84afd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424338</data>
</node>
<node id="Steele-Richardson-Olszewski Syndrome">
  <data key="d0">Steele-Richardson-Olszewski Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Steele-Richardson-Olszewski Syndrome is an alternative name for Progressive Supranuclear Palsy, a rare neurodegenerative disease.</data>
  <data key="d3">chunk-2408b24dbbf82011285a46aaece84afd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424338</data>
</node>
<node id="Brain Stem">
  <data key="d0">Brain Stem</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Brain stem is a brain structure closest to the spinal cord, involved in controlling vital functions, movement, sensation, and nerves supplying the head and neck, and is affected by Progressive Supranuclear Palsy.</data>
  <data key="d3">chunk-2408b24dbbf82011285a46aaece84afd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424338</data>
</node>
<node id="Basal Ganglia">
  <data key="d0">Basal Ganglia</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Basal ganglia are brain structures at the base of the cerebral hemispheres involved in controlling movement, and are affected by Progressive Supranuclear Palsy.</data>
  <data key="d3">chunk-2408b24dbbf82011285a46aaece84afd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424338</data>
</node>
<node id="Dopaminergic Medications">
  <data key="d0">Dopaminergic Medications</data>
  <data key="d1">artifact</data>
  <data key="d2">Dopaminergic medications are drugs sometimes given to relieve symptoms of Progressive Supranuclear Palsy, though their effectiveness is usually disappointing.</data>
  <data key="d3">chunk-2408b24dbbf82011285a46aaece84afd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424338</data>
</node>
