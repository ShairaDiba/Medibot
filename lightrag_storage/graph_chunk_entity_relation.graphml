  <data key="d0">Staphylococci</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Staphylococci bacteria are a group of microorganisms that may also cause acute lymphangitis.&lt;SEP&gt;Staphylococci are bacteria that are usually the cause of impetigo infections.</data>
  <data key="d3">chunk-bead2f9ad4273b49f336c30d5e85e2f1&lt;SEP&gt;chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
