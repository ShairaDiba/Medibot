<node id="Stool Softeners">
  <data key="d0">Stool Softeners</data>
  <data key="d1">method</data>
  <data key="d2">Stool softeners are used to relieve constipation and aid healing of hemorrhoids and fissures.&lt;SEP&gt;Stool softeners are used to relieve constipation and aid healing of hemorrhoids and fissures.</data>
  <data key="d3">chunk-7cf07655a8780ee831372742398affa8</data>
  <data key="d4">unknown_source</data>
