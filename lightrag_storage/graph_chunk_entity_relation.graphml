<node id="Wounds">
  <data key="d0">Wounds</data>
  <data key="d1">concept</data>
  <data key="d2">Wounds are injuries that can become infected if left untreated, leading to bacterial multiplication and symptoms such as pain, redness, swelling, itching, and oozing.</data>
  <data key="d3">chunk-691c137b75421e29ad257ff721c4b853</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786384845</data>
</node>
<node id="Redness">
  <data key="d0">Redness</data>
  <data key="d1">concept</data>
  <data key="d2">Redness is a symptom described as a result of bacterial infection in untreated wounds.</data>
  <data key="d3">chunk-691c137b75421e29ad257ff721c4b853</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786384845</data>
