  <data key="d0">Stomach Pumping</data>
  <data key="d1">method</data>
  <data key="d2">Stomach pumping is another term for gastric lavage, used to remove poison from the stomach.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422327</data>
</node>
