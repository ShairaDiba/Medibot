  <data key="d5">1786404945</data>
</node>
<node id="Pulmonary Embolism">
  <data key="d0">Pulmonary Embolism</data>
  <data key="d1">concept</data>
  <data key="d2">Pulmonary embolism is a vascular condition listed as a key term related to hemoptysis.&lt;SEP&gt;Pulmonary embolism is an obstruction of a blood vessel in the lungs, usually due to a blood clot, classified as a critical disease affecting cardiovascular, respiratory, hematological, and oncological systems.</data>
  <data key="d3">chunk-1e66944fd1dc54d886432ccbb215e62e&lt;SEP&gt;chunk-5bc0e87b467a3072004e86dd7a21ec8c</data>
