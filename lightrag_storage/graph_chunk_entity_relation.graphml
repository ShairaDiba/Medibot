  <data key="d0">Physician Prescription</data>
  <data key="d1">method</data>
  <data key="d2">Physician prescription is required to obtain the listed antibiotics.</data>
  <data key="d3">chunk-b1b905af9bb1602798ef23bcfc2818c2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424230</data>
