  <data key="d1">method</data>
  <data key="d2">Low‑impact Aerobic Exercise encompasses gentle aerobic activities such as walking, bicycling, and swimming, recommended for heart failure patients.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403746</data>
</node>
<node id="Coronary Artery Bypass">
  <data key="d0">Coronary Artery Bypass</data>
  <data key="d1">method</data>
  <data key="d2">Coronary Artery Bypass is a surgical procedure that reroutes blood flow around a blocked coronary artery, used to treat coronary artery disease and prevent heart failure.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403746</data>
