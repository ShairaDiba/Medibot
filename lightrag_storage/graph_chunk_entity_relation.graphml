  <data key="d0">Peptic Ulcer Disease (PUD)</data>
  <data key="d1">other</data>
  <data key="d2">PUD is a gastrointestinal disorder that may be diagnosed in patients presenting with indigestion during endoscopic examination.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411744</data>
</node>
<node id="Stomach Cancer">
  <data key="d0">Stomach Cancer</data>
  <data key="d1">other</data>
  <data key="d2">Stomach cancer is a serious condition that can be discovered in a small percentage of patients who undergo endoscopy for indigestion symptoms.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411744</data>
</node>
<node id="Functional Dyspepsia">
  <data key="d0">Functional Dyspepsia</data>
  <data key="d1">other</data>
  <data key="d2">Functional dyspepsia is a subtype of indigestion where patients typically respond well to non‑invasive treatments.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411744</data>
</node>
<node id="Alcoholic Beverages">
  <data key="d0">Alcoholic Beverages</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Alcoholic beverages are drinks containing alcohol that are advised to be reduced or eliminated to improve indigestion.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411745</data>
</node>
<node id="Caffeinated Drinks">
  <data key="d0">Caffeinated Drinks</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Caffeinated drinks are beverages containing caffeine that are recommended to be limited for indigestion relief.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411745</data>
</node>
<node id="Tobacco Products">
  <data key="d0">Tobacco Products</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Tobacco products are smoking items whose use is linked to worsened indigestion and whose cessation aids symptom improvement.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411745</data>
</node>
<node id="Food Diary">
  <data key="d0">Food Diary</data>
  <data key="d1">artifact</data>
  <data key="d2">A food diary is a record kept by patients documenting food intake,</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411745</data>
</node>
<node id="Psychological Factors">
  <data key="d0">Psychological Factors</data>
  <data key="d1">concept</data>
  <data key="d2">Psychological factors are mental or emotional influences that may be identified through food diaries in patients with indigestion.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411745</data>
</node>
<node id="Dietary Factors">
  <data key="d0">Dietary Factors</data>
  <data key="d1">concept</data>
  <data key="d2">Dietary factors are food-related influences that may be identified through food diaries in patients with indigestion.</data>
  <data key="d3">chunk-696bd50fdda11571d3f3a3dd02534eb4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411745</data>
</node>
<node id="Infant Massage">
  <data key="d0">Infant Massage</data>
  <data key="d1">method</data>
  <data key="d2">Infant massage refers to massage therapy specifically applied to infants, typically using oil or lotion by a trained and licensed massage therapist, and may be used for premature infants or those with motor, gastrointestinal problems or prenatal cocaine exposure.</data>
  <data key="d3">chunk-e03f4e63fc8716fd3ee8d9a8c4f4b983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411761</data>
</node>
<node id="Indian Milking">
  <data key="d0">Indian Milking</data>
  <data key="d1">method</data>
  <data key="d2">Indian Milking is a gentle stroking technique applied to an infant’s legs as part of infant massage.</data>
  <data key="d3">chunk-e03f4e63fc8716fd3ee8d9a8c4f4b983</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411761</data>
</node>
<node id="Mononucleosis">
  <data key="d0">Mononucleosis</data>
  <data key="d3">chunk-1d76104bef49b3189628a31424cb580f</data>
  <data key="d2">Mononucleosis is mentioned as a disease that may lead to infertility, indicating a complication relationship.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411800</data>
</node>
<node id="85% Pregnancy Rate">
  <data key="d0">85% Pregnancy Rate</data>
  <data key="d3">chunk-1d76104bef49b3189628a31424cb580f</data>
  <data key="d2">Mayo Clinic provides the statistic that about 85% of couples become pregnant within 12 months of trying.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411800</data>
</node>
<node id="10–15% Infertility Rate">
  <data key="d0">10–15% Infertility Rate</data>
  <data key="d3">chunk-1d76104bef49b3189628a31424cb580f</data>
  <data key="d2">Mayo Clinic supplies the data indicating that infertility affects about 10–15% of couples at any given time.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411801</data>
</node>
<node id="Inclusion Conjunctivitis">
  <data key="d0">Inclusion Conjunctivitis</data>
  <data key="d1">concept</data>
  <data key="d2">Inclusion Conjunctivitis is an inflammation of the conjunctiva caused by the bacterium Chlamydia trachomatis, also known by several alternative names.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Chlamydia Trachomatis">
  <data key="d0">Chlamydia Trachomatis</data>
  <data key="d1">creature</data>
  <data key="d2">Chlamydia trachomatis is a bacterium that infects the conjunctiva and causes inclusion conjunctivitis.&lt;SEP&gt;A bacterial pathogen that is the most common sexually transmitted disease in the United States and can cause perinatal infection.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5&lt;SEP&gt;chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420095</data>
</node>
<node id="Ludwig Halberstaedter">
  <data key="d0">Ludwig Halberstaedter</data>
  <data key="d1">person</data>
  <data key="d2">Ludwig Halberstaedter was a Polish dermatologist who co‑discovered Chlamydia trachomatis in 1907.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Stanislaus Von Prowazek">
  <data key="d0">Stanislaus Von Prowazek</data>
  <data key="d1">person</data>
  <data key="d2">Stanislaus von Prowazek was a Czech zoologist who co‑discovered Chlamydia trachomatis in 1907.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Neonatal Inclusion Conjunctivitis">
  <data key="d0">Neonatal Inclusion Conjunctivitis</data>
  <data key="d1">concept</data>
  <data key="d2">Neonatal Inclusion Conjunctivitis is the form of inclusion conjunctivitis that appears in newborns after passage through an infected birth canal.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Adult Inclusion Conjunctivitis">
  <data key="d0">Adult Inclusion Conjunctivitis</data>
  <data key="d1">concept</data>
  <data key="d2">Adult Inclusion Conjunctivitis is the form of inclusion conjunctivitis that appears in adults.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Inclusion Blennorrhea">
  <data key="d0">Inclusion Blennorrhea</data>
  <data key="d1">concept</data>
  <data key="d2">Inclusion Blennorrhea is an alternative name for inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Chlamydial Conjunctivitis">
  <data key="d0">Chlamydial Conjunctivitis</data>
  <data key="d1">concept</data>
  <data key="d2">Chlamydial Conjunctivitis is an alternative name for inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Swimming Pool Conjunctivitis">
  <data key="d0">Swimming Pool Conjunctivitis</data>
  <data key="d1">concept</data>
  <data key="d2">Swimming Pool Conjunctivitis is an alternative name for inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Cervicitis">
  <data key="d0">Cervicitis</data>
  <data key="d1">concept</data>
  <data key="d2">Cervicitis is inflammation of the uterine cervix, noted as a condition that should be treated in mothers of infected newborns.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Tetracycline">
  <data key="d0">Tetracycline</data>
  <data key="d1">artifact</data>
  <data key="d2">Tetracycline is an antibiotic used in ointment form to treat inclusion conjunctivitis in newborns.&lt;SEP&gt;Tetracycline is an oral antibiotic used for spirillary infection when patients are allergic to penicillins.</data>
  <data key="d3">chunk-d82066907ae788a5c895e3b1bededab3&lt;SEP&gt;chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426663</data>
</node>
<node id="Erythromycin">
  <data key="d0">Erythromycin</data>
  <data key="d1">artifact</data>
  <data key="d2">Erythromycin is an antibiotic administered as ointment or drops for treating and preventing inclusion conjunctivitis.&lt;SEP&gt;Erythromycin is an oral antibiotic used for streptobacillary infection when patients are allergic to penicillins.</data>
  <data key="d3">chunk-d82066907ae788a5c895e3b1bededab3&lt;SEP&gt;chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426663</data>
</node>
<node id="Azithromycin">
  <data key="d0">Azithromycin</data>
  <data key="d1">artifact</data>
  <data key="d2">Azithromycin is an antibiotic used orally for extended treatment of inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Tetracycline Ointment">
  <data key="d0">Tetracycline Ointment</data>
  <data key="d1">artifact</data>
  <data key="d2">Tetracycline ointment is applied to the conjunctiva of newborns as part of inclusion conjunctivitis therapy.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Erythromycin Ophthalmic Ointment">
  <data key="d0">Erythromycin Ophthalmic Ointment</data>
  <data key="d1">artifact</data>
  <data key="d2">Erythromycin ophthalmic ointment is applied to the eyes of newborns for treating inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411828</data>
</node>
<node id="Erythromycin Drops">
  <data key="d0">Erythromycin Drops</data>
  <data key="d1">artifact</data>
  <data key="d2">Erythromycin drops are instilled into the newborn’s eye at birth to prevent inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411829</data>
</node>
<node id="Silver Nitrate">
  <data key="d0">Silver Nitrate</data>
  <data key="d1">artifact</data>
  <data key="d2">Silver nitrate is mentioned as an ineffective preventive agent for inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411829</data>
</node>
<node id="Conjunctiva">
  <data key="d0">Conjunctiva</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The conjunctiva is the membrane lining the eyelids and covering the sclera, which becomes inflamed in inclusion conjunctivitis.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411829</data>
</node>
<node id="Sclera">
  <data key="d0">Sclera</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The sclera is the white part of the eyeball that is covered by the conjunctiva.</data>
  <data key="d3">chunk-7648c26f13059b47c92543db67233b45</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411829</data>
</node>
<node id="Infectious Disease">
  <data key="d0">Infectious Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Infectious disease is defined as any illness caused by an infective agent such as a germ, microbe, or parasite.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411861</data>
</node>
<node id="Communicable Disease">
  <data key="d0">Communicable Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Communicable disease is an alternative name for infectious disease, referring to illnesses that can be transmitted between individuals.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411861</data>
</node>
<node id="Infective Agent">
  <data key="d0">Infective Agent</data>
  <data key="d1">concept</data>
  <data key="d2">Infective agents are germs, microbes, or parasites-including bacteria, viruses, fungi, parasitic protozoa, and worms-that cause infectious diseases.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411861</data>
</node>
<node id="Parasitic Protozoa">
  <data key="d0">Parasitic Protozoa</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Parasitic protozoa are single-celled organisms that function as infective agents and can cause protozoal infectious diseases.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411861</data>
</node>
<node id="Measles">
  <data key="d0">Measles</data>
  <data key="d1">concept</data>
  <data key="d2">Measles is a specific infectious disease mentioned in the text, illustrated by a teenager case.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411862</data>
</node>
<node id="Common Cold">
  <data key="d0">Common Cold</data>
  <data key="d1">concept</data>
  <data key="d2">Common cold is a frequent, usually mild infectious disease that typically resolves quickly without medical treatment.&lt;SEP&gt;The common cold is a milder respiratory illness that is less debilitating than influenza.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202&lt;SEP&gt;chunk-bc626b00afed53316810372730831c40</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412317</data>
</node>
<node id="Pneumonia">
  <data key="d0">Pneumonia</data>
  <data key="d1">concept</data>
  <data key="d2">Pneumonia is a severe infectious disease that can be life‑threatening according to the text.&lt;SEP&gt;Pneumonia is a lung infection that can be caused by bacteria, amoebae, viruses, fungi, parasites, or non‑infectious inhalation of substances.&lt;SEP&gt;An infection of the lungs that can be caused by bacteria, viruses, or fungi, leading to fluid buildup and impaired oxygen exchange.&lt;SEP&gt;Pneumonia is an inflammatory infection of the lung parenchyma that can lead to pleural effusion.</data>
  <data key="d3">chunk-448825a5baf21347c5a8fd84c362669b&lt;SEP&gt;chunk-8ebc91deb19a2b42710150361b08958e&lt;SEP&gt;chunk-47a3a83e48113d48f0a14a70afb7ebf8&lt;SEP&gt;chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422151</data>
</node>
<node id="Vaccines">
  <data key="d0">Vaccines</data>
  <data key="d1">artifact</data>
  <data key="d2">Vaccines are biomedical artifacts that provide immunity and help prevent infectious diseases.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411862</data>
</node>
<node id="Yogurt">
  <data key="d0">Yogurt</data>
  <data key="d1">artifact</data>
  <data key="d2">Yogurt containing healthy gut bacteria is described as a food product that can ease gastrointestinal symptoms and lower infection incidence in children.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411862</data>
</node>
<node id="Physical Exam">
  <data key="d0">Physical Exam</data>
  <data key="d1">method</data>
  <data key="d2">Physical exam is a diagnostic procedure that assesses breathing patterns, respiratory rate, temperature, and other symptoms to diagnose infectious diseases.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411862</data>
</node>
<node id="Alternative Therapies">
  <data key="d0">Alternative Therapies</data>
  <data key="d1">method</data>
  <data key="d2">Alternative therapies are various home or non‑conventional treatments mentioned as options for managing infectious diseases.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411862</data>
</node>
<node id="Sally Greenhill">
  <data key="d0">Sally Greenhill</data>
  <data key="d1">person</data>
  <data key="d2">Sally Greenhill is credited as a photographer for the image of a teenager with measles, as noted in the text.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411863</data>
</node>
<node id="Richard Greenhill">
  <data key="d0">Richard Greenhill</data>
  <data key="d1">person</data>
  <data key="d2">Richard Greenhill is credited alongside Sally Greenhill as a photographer for the measles image.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411863</data>
</node>
<node id="Alamy">
  <data key="d0">Alamy</data>
  <data key="d1">organization</data>
  <data key="d2">Alamy is the organization associated with the photographers Sally and Richard Greenhill, likely the image source.</data>
  <data key="d3">chunk-bf8d23aad485a31e434afa128d656202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411863</data>
</node>
<node id="Incompetent Cervix">
  <data key="d0">Incompetent Cervix</data>
  <data key="d1">concept</data>
  <data key="d2">Incompetent cervix is a medical condition where the cervix is abnormally weak and gradually widens during pregnancy, potentially causing repeated pregnancy losses or premature delivery.</data>
  <data key="d3">chunk-1cc9b041882b1ffceb3664e339701aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411901</data>
</node>
<node id="Premature Delivery">
  <data key="d0">Premature Delivery</data>
  <data key="d1">concept</data>
  <data key="d2">Premature delivery is an early birth occurring before full term, which can result from an incompetent cervix.</data>
  <data key="d3">chunk-1cc9b041882b1ffceb3664e339701aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411901</data>
</node>
<node id="Repeated Pregnancy Losses">
  <data key="d0">Repeated Pregnancy Losses</data>
  <data key="d1">concept</data>
  <data key="d2">Repeated pregnancy losses refer to multiple miscarriages that can occur when an incompetent cervix opens prematurely.</data>
  <data key="d3">chunk-1cc9b041882b1ffceb3664e339701aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411901</data>
</node>
<node id="Anatomical Abnormality">
  <data key="d0">Anatomical Abnormality</data>
  <data key="d1">concept</data>
  <data key="d2">An anatomical abnormality is a structural irregularity that can cause the cervix to become incompetent.</data>
  <data key="d3">chunk-1cc9b041882b1ffceb3664e339701aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411901</data>
</node>
<node id="Trauma to Cervix">
  <data key="d0">Trauma to Cervix</data>
  <data key="d1">concept</data>
  <data key="d2">Trauma to the cervix is physical injury that can contribute to the development of an incompetent cervix.</data>
  <data key="d3">chunk-1cc9b041882b1ffceb3664e339701aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411901</data>
</node>
<node id="Cerclage">
  <data key="d0">Cerclage</data>
  <data key="d1">method</data>
  <data key="d2">Cerclage is a surgical procedure used to correct an incompetent cervix, with a high success rate when performed early in pregnancy.</data>
  <data key="d3">chunk-1cc9b041882b1ffceb3664e339701aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411902</data>
</node>
<node id="Fetal Membranes">
  <data key="d0">Fetal Membranes</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The fetal membranes surround the fetus and can bulge into the cervical opening when the cervix thins and widens.</data>
  <data key="d3">chunk-1cc9b041882b1ffceb3664e339701aa0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411902</data>
</node>
<node id="Induction of Labor">
  <data key="d0">Induction of Labor</data>
  <data key="d1">method</data>
  <data key="d2">Induction of labor involves using artificial means to assist the mother in delivering her baby, typically when pregnancy extends significantly beyond the expected delivery date.</data>
  <data key="d3">chunk-f8fa92ebcec8228939de0a7b767b729f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411944</data>
</node>
<node id="Mother">
  <data key="d0">Mother</data>
  <data key="d1">person</data>
  <data key="d2">Mother is the female who carries and delivers the baby, requiring&lt;SEP&gt;The female parent who can transmit infections to the baby during pregnancy or delivery.&lt;SEP&gt;Mother is the pregnant individual whose health behaviors affect the risk of premature birth.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5&lt;SEP&gt;chunk-f8fa92ebcec8228939de0a7b767b729f&lt;SEP&gt;chunk-0c63f65bb800d3d7fae8a0864fc3cdf3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423566</data>
</node>
<node id="Baby">
  <data key="d0">Baby</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5&lt;SEP&gt;chunk-32995d0e87b6ef1faa098707755b406f&lt;SEP&gt;chunk-f8fa92ebcec8228939de0a7b767b729f</data>
  <data key="d2">Induction of labor helps deliver the baby by inducing labor.&lt;SEP&gt;The newborn who can acquire infections from the mother perinatally.&lt;SEP&gt;The newborn baby can be adversely affected by a mother's postpartum depression.</data>
  <data key="d1">person</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422994</data>
</node>
<node id="Amniotic Membrane">
  <data key="d0">Amniotic Membrane</data>
  <data key="d3">chunk-f8fa92ebcec8228939de0a7b767b729f</data>
  <data key="d2">Induction of labor may involve rupturing the amniotic membrane to release fluid.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411947</data>
</node>
<node id="Breaking Water">
  <data key="d0">Breaking Water</data>
  <data key="d3">chunk-f8fa92ebcec8228939de0a7b767b729f</data>
  <data key="d2">Rupturing the amniotic membrane mimics the normal “breaking water” process.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411949</data>
</node>
<node id="Septic Arthritis">
  <data key="d0">Septic Arthritis</data>
  <data key="d1">concept</data>
  <data key="d2">Septic arthritis is an alternative name for infectious arthritis.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411979</data>
</node>
<node id="Pyogenic Arthritis">
  <data key="d0">Pyogenic Arthritis</data>
  <data key="d1">concept</data>
  <data key="d2">Pyogenic arthritis is another synonym for infectious arthritis.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411979</data>
</node>
<node id="Chronic Rheumatoid Arthritis">
  <data key="d0">Chronic Rheumatoid Arthritis</data>
  <data key="d1">concept</data>
  <data key="d2">Chronic rheumatoid arthritis is a high‑risk condition that increases susceptibility to infectious arthritis.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411979</data>
</node>
<node id="Bloodstream">
  <data key="d0">Bloodstream</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The bloodstream is the circulatory fluid through which infectious agents can travel to joints, contributing to infectious arthritis.&lt;SEP&gt;Bloodstream is the fluid circulatory medium in which platelets travel and function.</data>
  <data key="d3">chunk-776b91620577fff4149dbac4a89b46eb&lt;SEP&gt;chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421878</data>
</node>
<node id="Rheumatology">
  <data key="d0">Rheumatology</data>
  <data key="d1">concept</data>
  <data key="d2">Rheumatology is a medical specialty that may be consulted to avoid misdiagnosis of infectious arthritis.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411980</data>
</node>
<node id="History-Taking">
  <data key="d0">History-Taking</data>
  <data key="d1">method</data>
  <data key="d2">History‑taking is a diagnostic method involving patient interview to aid in diagnosing infectious arthritis.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411980</data>
</node>
<node id="Surgical Drainage">
  <data key="d0">Surgical Drainage</data>
  <data key="d1">method</data>
  <data key="d2">Surgical drainage is a therapeutic method involving operative removal of infected joint fluid when antibiotics alone are insufficient.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411981</data>
</node>
<node id="Arthrocentesis">
  <data key="d0">Arthrocentesis</data>
  <data key="d1">method</data>
  <data key="d2">Arthrocentesis is a needle‑based procedure used to aspirate fluid from a joint for both diagnostic and therapeutic purposes in infectious arthritis.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411981</data>
</node>
<node id="70% Recovery Rate">
  <data key="d0">70% Recovery Rate</data>
  <data key="d1">data</data>
  <data key="d2">70% Recovery Rate denotes that about seventy percent of patients with infectious arthritis recover without permanent joint damage.</data>
  <data key="d3">chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411981</data>
</node>
<node id="Herpes Viruses">
  <data key="d0">Herpes Viruses</data>
  <data key="d1">related,taxonomy</data>
  <data key="d2">Epstein-Barr Virus is related to the group of herpes viruses.</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412015</data>
</node>
<node id="Atypical Lymphocytes">
  <data key="d0">Atypical Lymphocytes</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Atypical Lymphocytes are abnormal white blood cells produced during Epstein-Barr virus infection and help in diagnosing infectious mononucleosis.</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412015</data>
</node>
<node id="College Students">
  <data key="d0">College Students</data>
  <data key="d1">concept</data>
  <data key="d2">College Students represent a group with a high infection rate of infectious mononucleosis when not previously exposed to Epstein-Barr virus.</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412015</data>
</node>
<node id="Young Adults">
  <data key="d0">Young Adults</data>
  <data key="d1">concept</data>
  <data key="d2">Young Adults (ages 15–35) are the age group most commonly affected by infectious mononucleosis.</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412015</data>
</node>
<node id="Teenagers">
  <data key="d0">Teenagers</data>
  <data key="d1">concept</data>
  <data key="d2">Teenagers are frequently cited as having a common occurrence of infectious mononucleosis.</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412015</data>
</node>
<node id="Excessive Activity">
  <data key="d0">Excessive Activity</data>
  <data key="d1">concept</data>
  <data key="d2">Excessive Activity denotes strenuous physical exertion that can lead to spleen rupture in patients with infectious mononucleosis.</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412016</data>
</node>
<node id="Throat Lozenges">
  <data key="d0">Throat Lozenges</data>
  <data key="d1">artifact</data>
  <data key="d2">Throat Lozenges are an artifact used to relieve throat discomfort associated with infectious mononucleosis.</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412016</data>
</node>
<node id="Epstein-Barr Virus">
  <data key="d0">Epstein-Barr Virus</data>
  <data key="d3">chunk-cad90a1c52c5adcfcef0c32801d2597f</data>
  <data key="d2">Epstein-Barr Virus is related to the group of herpes viruses.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412021</data>
</node>
<node id="Infection Control">
  <data key="d0">Infection Control</data>
  <data key="d1">concept</data>
  <data key="d2">Infection control refers to policies and procedures used to minimize the risk of spreading infections, especially in hospitals and human or animal healthcare facilities.</data>
  <data key="d3">chunk-eeb1332bf6ed56e93640349f4d43c911</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412061</data>
</node>
<node id="Hospitals">
  <data key="d0">Hospitals</data>
  <data key="d1">organization</data>
  <data key="d2">Hospitals are cited as primary settings where infection control policies and procedures are applied to reduce infection spread.&lt;SEP&gt;Hospitals are settings where psychological tests are administered.</data>
  <data key="d3">chunk-eeb1332bf6ed56e93640349f4d43c911&lt;SEP&gt;chunk-ea87a42e2dfef284d8c503ac77656a7b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425226</data>
</node>
<node id="Inhalation Therapies">
  <data key="d0">Inhalation Therapies</data>
  <data key="d1">concept</data>
  <data key="d2">Inhalation Therapies – Concept – group of respiratory or breathing treatments designed to help restore or improve breathing function in patients with various diseases, conditions, or injuries.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412089</data>
</node>
<node id="Oxygen Chamber Therapy">
  <data key="d0">Oxygen Chamber Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Oxygen Chamber Therapy – Method – a type of inhalation therapy administered in an oxygen chamber, ordered for various conditions.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412089</data>
</node>
<node id="At-Home Oxygen Therapy">
  <data key="d0">At-Home Oxygen Therapy</data>
  <data key="d1">method</data>
  <data key="d2">At-Home Oxygen Therapy – Method – inhalation therapy administered at home for patients with chronic obstructive pulmonary disease.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412089</data>
</node>
<node id="Chronic Obstructive Pulmonary Disease">
  <data key="d0">Chronic Obstructive Pulmonary Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Chronic Obstructive Pulmonary Disease – Concept – a chronic lung disease mentioned as condition for at-home oxygen therapy and chronic hypoxemia.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412089</data>
</node>
<node id="Oxygen Therapy">
  <data key="d0">Oxygen Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Oxygen Therapy – Method – supplemental oxygen provided to patients showing hypoxemia to prevent organ damage, delivered via mask, nasal tube, or trachea.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412089</data>
</node>
<node id="Hypoxemia">
  <data key="d0">Hypoxemia</data>
  <data key="d1">concept</data>
  <data key="d2">Hypoxemia – Concept – decreased oxygen in arterial blood that triggers supplemental oxygen.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412089</data>
</node>
<node id="Medical Mask">
  <data key="d0">Medical Mask</data>
  <data key="d1">artifact</data>
  <data key="d2">Medical Mask – Artifact – device through which oxygen may be administered.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412090</data>
</node>
<node id="Nasal Tube">
  <data key="d0">Nasal Tube</data>
  <data key="d1">artifact</data>
  <data key="d2">Nasal Tube – Artifact – device through which oxygen may be administered.&lt;SEP&gt;Nasal tube is a medical device used to remove air and fluids from the digestive tract of premature infants.</data>
  <data key="d3">chunk-0c63f65bb800d3d7fae8a0864fc3cdf3&lt;SEP&gt;chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423567</data>
</node>
<node id="Liters Per Minute">
  <data key="d0">Liters Per Minute</data>
  <data key="d1">data</data>
  <data key="d2">Liters Per Minute – Data – unit measuring the amount of oxygen flow prescribed.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412090</data>
</node>
<node id="Weaning">
  <data key="d0">Weaning</data>
  <data key="d1">method</data>
  <data key="d2">Weaning – Method – process of reducing dependence on mechanical ventilation.</data>
  <data key="d3">chunk-bf9568ffc5d5bfc55e145a95f45cf030</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412090</data>
</node>
<node id="Insecticide Poisoning">
  <data key="d0">Insecticide Poisoning</data>
  <data key="d1">concept</data>
  <data key="d2">Insecticide poisoning is a disease/condition caused by exposure to chemicals designed to eradicate insects, leading to clinical signs that can progress to death.</data>
  <data key="d3">chunk-35928a40d41ccdf0fbb4216b4772acbc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412131</data>
</node>
<node id="Insecticides">
  <data key="d0">Insecticides</data>
  <data key="d1">concept</data>
  <data key="d2">Insecticides are a group of organophosphate chemicals used to protect against insects, noted for effectiveness and short environmental persistence.</data>
  <data key="d3">chunk-35928a40d41ccdf0fbb4216b4772acbc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412131</data>
</node>
<node id="Organophosphates">
  <data key="d0">Organophosphates</data>
  <data key="d1">concept</data>
  <data key="d2">Organophosphates are a class of chemicals classified as insecticides that act by inhibiting the enzyme acetyl cholinesterase.</data>
  <data key="d3">chunk-35928a40d41ccdf0fbb4216b4772acbc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412131</data>
</node>
<node id="Infertility Drugs">
  <data key="d0">Infertility Drugs</data>
  <data key="d1">artifact</data>
  <data key="d2">Infertility drugs are medicines intended to assist in achieving pregnancy.</data>
  <data key="d3">chunk-e6d5f82c915dbc402d1fdeb23f98439f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412165</data>
</node>
<node id="Ovulation">
  <data key="d0">Ovulation</data>
  <data key="d1">concept</data>
  <data key="d2">Ovulation is the process by which the woman's reproductive system releases eggs regularly.&lt;SEP&gt;Ovulation is the process of releasing an egg from the ovary, a key step in conception.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e&lt;SEP&gt;chunk-e6d5f82c915dbc402d1fdeb23f98439f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412231</data>
</node>
<node id="Endometriosis">
  <data key="d0">Endometriosis</data>
  <data key="d1">concept</data>
  <data key="d2">Endometriosis is a medical condition identified as a key term related to infertility.&lt;SEP&gt;Endometriosis is a condition where uterine lining tissue implants on other organs, potentially contributing to infertility.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e&lt;SEP&gt;chunk-e6d5f82c915dbc402d1fdeb23f98439f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412231</data>
</node>
<node id="Infertility Therapies">
  <data key="d0">Infertility Therapies</data>
  <data key="d1">method</data>
  <data key="d2">Infertility therapies are treatments designed to address infertility, mentioned in the description of Infertility Drugs.&lt;SEP&gt;Infertility therapies are treatments aimed at enabling a woman to become pregnant by addressing causes in the man, the woman, or both partners.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e&lt;SEP&gt;chunk-e6d5f82c915dbc402d1fdeb23f98439f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412229</data>
</node>
<node id="Man">
  <data key="d0">Man</data>
  <data key="d1">concept</data>
  <data key="d2">Man refers to the male partner whose fertility status may affect conception.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412229</data>
</node>
<node id="Couple">
  <data key="d0">Couple</data>
  <data key="d1">concept</data>
  <data key="d2">Couple denotes a man and woman attempting to conceive together.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412230</data>
</node>
<node id="Low Sperm Count">
  <data key="d0">Low Sperm Count</data>
  <data key="d1">concept</data>
  <data key="d2">Low sperm count is identified as the most common cause of male infertility.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412230</data>
</node>
<node id="Male Infertility">
  <data key="d0">Male Infertility</data>
  <data key="d1">concept</data>
  <data key="d2">Male infertility describes infertility caused by issues in the male partner, often related to low sperm count.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412230</data>
</node>
<node id="Fibroid Tumors">
  <data key="d0">Fibroid Tumors</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Fibroid tumors are growths in the uterus that may cause infertility and can be surgically treated.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412231</data>
</node>
<node id="Ovaries">
  <data key="d0">Ovaries</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ovaries are female reproductive organs that may be affected by endometriosis.&lt;SEP&gt;Ovaries are female reproductive organs whose structure and condition can be assessed by pelvic ultrasound.&lt;SEP&gt;Ovaries are female gonads that produce estrogen when stimulated by gonadotropins.</data>
  <data key="d3">chunk-e6407dc79c35579b5387abf2b05a97d0&lt;SEP&gt;chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e&lt;SEP&gt;chunk-6409c7c91c51d8723b72f6697dc5c8cc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423415</data>
</node>
<node id="Fallopian Tubes">
  <data key="d0">Fallopian Tubes</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Fallopian tubes are the ducts through which eggs travel and can be involved in endometriosis.&lt;SEP&gt;Fallopian tubes are structures that transport eggs and can be examined using pelvic ultrasound.</data>
  <data key="d3">chunk-e6407dc79c35579b5387abf2b05a97d0&lt;SEP&gt;chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419824</data>
</node>
<node id="Artificial Insemination">
  <data key="d0">Artificial Insemination</data>
  <data key="d1">method</data>
  <data key="d2">Artificial insemination is a reproductive technique used when sperm count is low or the male is impotent.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
