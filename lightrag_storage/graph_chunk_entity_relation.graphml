  <data key="d1">concept</data>
  <data key="d2">Furosemide is a loop diuretic commonly used to treat fluid overload and can lead to hypokalemia.</data>
  <data key="d3">chunk-f8a0239df88721094e3c51f8a7373134</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410760</data>
