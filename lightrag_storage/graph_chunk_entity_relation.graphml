  <data key="d0">Computed Tomography (CT) Scan</data>
  <data key="d1">method</data>
  <data key="d2">Computed Tomography (CT) Scan is an imaging method used to diagnose head and neck cancers.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403384</data>
</node>
<node id="Positron Emission Tomography (PET) Scan">
  <data key="d0">Positron Emission Tomography (PET) Scan</data>
  <data key="d1">method</data>
  <data key="d2">Positron Emission Tomography (PET) Scan is an imaging method often combined with CT to diagnose head and neck cancers.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403384</data>
</node>
<node id="Bone Scan">
  <data key="d0">Bone Scan</data>
  <data key="d1">method</data>
  <data key="d2">Bone Scan is an imaging test used to detect bone metastasis in patients with advanced head and neck cancer.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403384</data>
</node>
<node id="Reconstructive Surgery">
  <data key="d0">Reconstructive Surgery</data>
  <data key="d1">concept</data>
  <data key="d2">Reconstructive Surgery is a cosmetic or reconstructive procedure performed after drastic lip surgery in head and neck cancer patients.&lt;SEP&gt;Reconstructive surgery focuses on restoring form and function to body parts affected by injury or disease.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309&lt;SEP&gt;chunk-5972068248f50904396788f92782210f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421538</data>
</node>
<node id="Chemotherapy Drugs">
  <data key="d0">Chemotherapy Drugs</data>
  <data key="d1">artifact</data>
  <data key="d2">Chemotherapy Drugs are newer medicinal agents used to treat nasopharyngeal cancer.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403385</data>
</node>
<node id="Early Detection">
  <data key="d0">Early Detection</data>
  <data key="d1">concept</data>
  <data key="d2">Early Detection refers to identifying head and neck cancers at an initial stage, which dramatically improves survival outcomes.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403385</data>
