<node id="Laboratory Testing">
  <data key="d0">Laboratory Testing</data>
  <data key="d1">method</data>
  <data key="d2">Laboratory Testing comprises extensive blood tests used to differentiate autoimmune hepatitis from viral hepatitis.&lt;SEP&gt;Laboratory testing is a diagnostic method used to identify infectious arthritis through analysis of joint fluid or blood.</data>
  <data key="d3">chunk-3978e5151245a8ce567b224992eabb69&lt;SEP&gt;chunk-e7a69ca28e7676455bc1dd105b09f56c</data>
