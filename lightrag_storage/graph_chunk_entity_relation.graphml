  <data key="d0">Skeletal Muscle Mass</data>
  <data key="d1">concept</data>
  <data key="d2">Skeletal muscle mass refers to the amount of muscle attached to the skeleton, which can be increased by anabolic steroids.</data>
  <data key="d3">chunk-170bf8fe0c421cc796fb1a155cc92877</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786378854</data>
