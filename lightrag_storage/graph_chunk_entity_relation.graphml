<node id="Cardiomyopathy">
  <data key="d0">Cardiomyopathy</data>
  <data key="d1">concept</data>
  <data key="d2">Cardiomyopathy is a disease of the heart muscle mentioned as one of the causes of heart failure.&lt;SEP&gt;Cardiomyopathy is an ongoing disease process that damages the muscle wall of the lower chambers of the heart.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46&lt;SEP&gt;chunk-e534c2f61dae08dd6e4ae98c00c82c7d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410465</data>
</node>
<node id="Heart Valve Disease">
  <data key="d0">Heart Valve Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Heart Valve Disease is a condition affecting heart valves that can lead to heart failure.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403744</data>
</node>
<node id="Congenital Heart Disease">
  <data key="d0">Congenital Heart Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Congenital Heart Disease is a birth defect of the heart identified as a cause of heart failure.&lt;SEP&gt;Congenital heart disease is listed as a primary condition within heart disease.</data>
  <data key="d3">chunk-5f36c10fba48ed73bf1306763cd71ea5&lt;SEP&gt;chunk-910d4bcf6932bd29fd1d161e11852b46</data>
  <data key="d4">unknown_source</data>
