  <data key="d0">Acute Heart Attack</data>
  <data key="d3">chunk-8c8d49552280caf72ab37a9086509fbd</data>
  <data key="d2">Acute Heart Attack can cause Pulmonary Edema.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425824</data>
</node>
<node id="Severe Ischemia">
  <data key="d0">Severe Ischemia</data>
  <data key="d3">chunk-8c8d49552280caf72ab37a9086509fbd</data>
  <data key="d2">Severe Ischemia can cause Pulmonary Edema.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425825</data>
</node>
<node id="Volume Overload of Left Ventricle">
  <data key="d0">Volume Overload of Left Ventricle</data>
  <data key="d3">chunk-8c8d49552280caf72ab37a9086509fbd</data>
  <data key="d2">Volume Overload of Left Ventricle can cause Pulmonary Edema.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425826</data>
</node>
<node id="Ptosis">
  <data key="d0">Ptosis</data>
  <data key="d1">concept</data>
  <data key="d2">Ptosis is a drooping upper eyelid condition, also known as blepharoptosis, affecting one or both eyes.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425872</data>
</node>
<node id="Blepharoptosis">
  <data key="d0">Blepharoptosis</data>
  <data key="d1">concept</data>
  <data key="d2">Blepharoptosis is an alternative name for the condition of ptosis, describing a drooping upper eyelid.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425872</data>
</node>
<node id="Levator Muscle">
  <data key="d0">Levator Muscle</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The levator muscle is the muscle that lifts the upper eyelid and its weakening can cause ptosis.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425872</data>
</node>
<node id="Upper Eyelid">
  <data key="d0">Upper Eyelid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The upper eyelid protects the eye and is lifted by the levator muscle; its drooping characterizes ptosis.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425872</data>
</node>
<node id="Myotonic Dystrophy">
  <data key="d0">Myotonic Dystrophy</data>
  <data key="d1">concept</data>
  <data key="d2">Myotonic dystrophy is a disease that can cause ptosis as a symptom.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425872</data>
</node>
<node id="Myasthenia Gravis">
  <data key="d0">Myasthenia Gravis</data>
  <data key="d1">concept</data>
  <data key="d2">Myasthenia gravis is a disease that can cause ptosis and must be ruled out before surgical treatment.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425872</data>
</node>
<node id="Congenital">
  <data key="d0">Congenital</data>
  <data key="d1">concept</data>
  <data key="d2">Congenital refers to ptosis present at birth due to nerve or muscle problems.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425873</data>
</node>
<node id="Hereditary">
  <data key="d0">Hereditary</data>
  <data key="d1">concept</data>
  <data key="d2">Hereditary indicates a genetic component to ptosis.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425873</data>
</node>
<node id="Eyebrow Muscles">
  <data key="d0">Eyebrow Muscles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Eyebrow muscles can be connected to the eyelid during ptosis surgery to improve lift.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425873</data>
</node>
<node id="Aponeurosis">
  <data key="d0">Aponeurosis</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The aponeurosis is a connective tissue that may be reattached to the tarsal plate in ptosis surgery.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425873</data>
</node>
<node id="Tarsal Plate">
  <data key="d0">Tarsal Plate</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The tarsal plate is a structure of the eyelid that can be reattached to the aponeurosis during ptosis surgery.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425873</data>
</node>
<node id="Eyelid Tissue">
  <data key="d0">Eyelid Tissue</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Eyelid tissue may be partially removed in minor ptosis surgery.</data>
  <data key="d3">chunk-bf2a4a7521a933797a5c97cd08b21a3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425873</data>
</node>
<node id="Lung Specialist">
  <data key="d0">Lung Specialist</data>
  <data key="d1">concept</data>
  <data key="d2">Lung Specialist is a medical professional</data>
  <data key="d3">chunk-cd7f0bbeab8e00c6a6c7d5f5f4a7fa44</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425891</data>
</node>
<node id="Moderate">
  <data key="d0">Moderate</data>
  <data key="d1">concept</data>
  <data key="d2">Moderate indicates the severity level applicable to psychotherapy.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425944</data>
</node>
<node id="Talking Cure">
  <data key="d0">Talking Cure</data>
  <data key="d1">concept</data>
  <data key="d2">Talking Cure is the nickname historically used for psychoanalysis.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425944</data>
</node>
<node id="Client">
  <data key="d0">Client</data>
  <data key="d1">person</data>
  <data key="d2">Client is the individual seeking help who engages in psychotherapy with a therapist.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425945</data>
</node>
<node id="Psychological Techniques">
  <data key="d0">Psychological Techniques</data>
  <data key="d1">concept</data>
  <data key="d2">Psychological Techniques are the verbal and mental methods employed in psychotherapy rather than physical or biological interventions.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425945</data>
</node>
<node id="Destructive Behaviors">
  <data key="d0">Destructive Behaviors</data>
  <data key="d1">concept</data>
  <data key="d2">Destructive Behaviors are harmful actions that psychotherapy aims to change.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425945</data>
</node>
<node id="Unhealthy Behaviors">
  <data key="d0">Unhealthy Behaviors</data>
  <data key="d1">concept</data>
  <data key="d2">Unhealthy Behaviors are detrimental patterns that psychotherapy seeks to modify.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425945</data>
</node>
<node id="Thoughts">
  <data key="d0">Thoughts</data>
  <data key="d1">concept</data>
  <data key="d2">Thoughts are mental processes that psychotherapy targets for change.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425945</data>
</node>
<node id="Emotions">
  <data key="d0">Emotions</data>
  <data key="d1">concept</data>
  <data key="d2">Emotions are affective states that psychotherapy aims to help individuals manage.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425945</data>
</node>
<node id="Mutual Trust">
  <data key="d0">Mutual Trust</data>
  <data key="d1">concept</data>
  <data key="d2">Mutual Trust describes the shared confidence between therapist and client that underpins the therapeutic interaction.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425945</data>
</node>
<node id="Verbal Exchange">
  <data key="d0">Verbal Exchange</data>
  <data key="d1">concept</data>
  <data key="d2">Verbal Exchange refers to the spoken communication that characterizes psychotherapy sessions between therapist and client.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425946</data>
</node>
<node id="Therapeutic Interaction">
  <data key="d0">Therapeutic Interaction</data>
  <data key="d1">concept</data>
  <data key="d2">Therapeutic Interaction is the process of counseling characterized by mutual trust and verbal exchange between therapist and client.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425946</data>
</node>
<node id="Treatment Goals">
  <data key="d0">Treatment Goals</data>
  <data key="d1">concept</data>
  <data key="d2">Treatment Goals are the defined objectives that, when met, lead to the termination of psychotherapy.</data>
  <data key="d3">chunk-80bdc5e62cc3de9c461969117469e796</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425946</data>
</node>
<node id="Bronchitis">
  <data key="d0">Bronchitis</data>
  <data key="d1">concept</data>
  <data key="d2">Bronchitis is a lung disease that can be diagnosed with pulmonary function tests.</data>
  <data key="d3">chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425953</data>
</node>
<node id="Emphysema">
  <data key="d0">Emphysema</data>
  <data key="d1">concept</data>
  <data key="d2">Emphysema is a lung disease that can be diagnosed with pulmonary function tests.</data>
  <data key="d3">chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425953</data>
</node>
<node id="Major Lung Surgery">
  <data key="d0">Major Lung Surgery</data>
  <data key="d1">event</data>
  <data key="d2">Major lung surgery is a significant operative procedure for which pulmonary function tests are performed beforehand to assess patient capacity.</data>
  <data key="d3">chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425953</data>
</node>
<node id="Spirometer">
  <data key="d0">Spirometer</data>
  <data key="d1">artifact</data>
  <data key="d2">A spirometer is a machine connected to a tube in basic pulmonary function tests that records exhaled air volume and flow.</data>
  <data key="d3">chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425953</data>
</node>
<node id="Peak Flow Meter">
  <data key="d0">Peak Flow Meter</data>
  <data key="d1">artifact</data>
  <data key="d2">A peak flow meter is a small handheld device that measures how rapidly a person can exhale, helping determine airway narrowing in asthma.</data>
  <data key="d3">chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425954</data>
</node>
<node id="Anna Rovid Spickler">
  <data key="d0">Anna Rovid Spickler</data>
  <data key="d1">person</data>
  <data key="d2">Anna Rovid Spickler, DVM, PhD, is listed as an organization purpose contributor for pulmonary function testing.</data>
  <data key="d3">chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425954</data>
</node>
<node id="Airway Narrowing">
  <data key="d0">Airway Narrowing</data>
  <data key="d1">concept</data>
  <data key="d2">Airway narrowing is the reduction of airway diameter that can be measured by a peak flow meter in asthma patients.</data>
  <data key="d3">chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425954</data>
</node>
<node id="American Heart Association National Center">
  <data key="d0">American Heart Association National Center</data>
  <data key="d1">organization</data>
  <data key="d2">The American Heart Association National Center is a branch of the American Heart Association located at 7272 Greenville Avenue, Dallas, TX, providing contact information and resources.</data>
  <data key="d3">chunk-1e66944fd1dc54d886432ccbb215e62e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426062</data>
</node>
<node id="Lori De Milto">
  <data key="d0">Lori De Milto</data>
  <data key="d1">person</data>
  <data key="d2">Lori De Milto is listed as an author or contributor to the pulmonary embolism entry.</data>
  <data key="d3">chunk-1e66944fd1dc54d886432ccbb215e62e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426062</data>
</node>
<node id="Dallas, TX">
  <data key="d0">Dallas, TX</data>
  <data key="d1">location</data>
  <data key="d2">Dallas, Texas is the city where the American Heart Association National Center is situated.</data>
  <data key="d3">chunk-1e66944fd1dc54d886432ccbb215e62e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426062</data>
</node>
<node id="Puerperal Infection">
  <data key="d0">Puerperal Infection</data>
  <data key="d1">concept</data>
  <data key="d2">Puerperal infection is a bacterial infection occurring after childbirth, also called postpartum fever, most commonly affecting the uterus within the genital tract and capable of spreading to cause sepsis; it is classified as a critical disease.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426140</data>
</node>
<node id="Postpartum Fever">
  <data key="d0">Postpartum Fever</data>
  <data key="d1">concept</data>
  <data key="d2">Postpartum fever is a synonym for puerperal infection, describing fever that arises after delivery.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426140</data>
</node>
<node id="Genital Tract">
  <data key="d0">Genital Tract</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The genital tract includes the reproductive organs where bacterial species normally reside and where puerperal infection often originates.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426140</data>
</node>
<node id="New Mother">
  <data key="d0">New Mother</data>
  <data key="d1">person</data>
  <data key="d2">A new mother is a woman who has recently given birth and is at risk of developing puerperal infection.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426140</data>
</node>
<node id="Cesarean Section">
  <data key="d0">Cesarean Section</data>
  <data key="d1">method</data>
  <data key="d2">Cesarean section is a surgical delivery method associated with a five- to tenfold higher rate of puerperal infection compared to vaginal delivery.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426140</data>
</node>
<node id="Vaginal Delivery">
  <data key="d0">Vaginal Delivery</data>
  <data key="d1">method</data>
  <data key="d2">Vaginal delivery is the natural birth method with a lower incidence (2–4%) of puerperal infection.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426141</data>
</node>
<node id="Maternal Death">
  <data key="d0">Maternal Death</data>
  <data key="d1">concept</data>
  <data key="d2">Maternal death refers to the death of a mother due to complications such as puerperal infection, rare in industrialized nations.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426141</data>
</node>
<node id="Industrialized World">
  <data key="d0">Industrialized World</data>
  <data key="d1">location</data>
  <data key="d2">The industrialized world experiences very rare maternal deaths from puerperal infection.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426141</data>
</node>
<node id="Developing Nations">
  <data key="d0">Developing Nations</data>
  <data key="d1">location</data>
  <data key="d2">Developing nations have a markedly higher maternal death rate from puerperal infection, estimated up to 100 times that of industrialized countries.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426141</data>
</node>
<node id="Bacterial Species">
  <data key="d0">Bacterial Species</data>
  <data key="d1">concept</data>
  <data key="d2">Various bacterial species, normally present in the genital tract, intestine, or skin, can cause puerperal infection.</data>
  <data key="d3">chunk-a6564f0ba00e16734a472181bcd545e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426141</data>
</node>
<node id="Clindamycin">
