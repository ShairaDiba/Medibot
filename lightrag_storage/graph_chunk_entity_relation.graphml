  <data key="d0">Muscle Tone</data>
  <data key="d3">chunk-af3262684a537f83a047b77ed5ae0b70</data>
  <data key="d2">Muscle Tone is a scoring category in Apgar Testing.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388399</data>
</node>
