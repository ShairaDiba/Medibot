<node id="Decibel">
  <data key="d0">Decibel</data>
  <data key="d1">concept</data>
  <data key="d2">Unit of sound intensity indicating energy moving from source to ear; approximately 30 dB for a whisper (safe), 85‑90 dB considered risky for hearing loss, and 140‑165 dB capable of causing considerable hearing loss.</data>
  <data key="d3">chunk-bafb2bd57a03b4eb45b6b85949d2efef</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403702</data>
</node>
<node id="Ear Wax">
  <data key="d0">Ear Wax</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cerumen that can accumulate in the external ear canal, potentially obstructing sound transmission and leading to hearing loss.</data>
  <data key="d3">chunk-bafb2bd57a03b4eb45b6b85949d2efef</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403702</data>
</node>
<node id="Loud Sounds">
  <data key="d0">Loud Sounds</data>
  <data key="d1">concept</data>
  <data key="d2">Extended exposure to high-intensity noises that can damage auditory function and cause hearing loss.</data>
  <data key="d3">chunk-bafb2bd57a03b4eb45b6b85949d2efef</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403702</data>
</node>
<node id="Heredity">
  <data key="d0">Heredity</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic inheritance that can predispose individuals to hearing loss.</data>
  <data key="d3">chunk-bafb2bd57a03b4eb45b6b85949d2efef</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403702</data>
</node>
<node id="Surfer's Ear">
  <data key="d0">Surfer's Ear</data>
  <data key="d1">concept</data>
  <data key="d2">Condition caused by bone overgrowth in the ear canal from repeated cold water exposure, frequently seen in Northern Californian surfers, leading to conductive hearing loss.</data>
  <data key="d3">chunk-bafb2bd57a03b4eb45b6b85949d2efef</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403702</data>
