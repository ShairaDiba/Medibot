  <data key="d5">1786422502</data>
</node>
<node id="Gastric Acid Suppression">
  <data key="d0">Gastric Acid Suppression</data>
  <data key="d1">method</data>
  <data key="d2">Gastric acid suppression is a therapeutic strategy aimed at reducing stomach acid, primarily using proton pump inhibitors.</data>
  <data key="d3">chunk-de288167dfc93e3a334ec826d0c43f8e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786387475</data>
</node>
<node id="Proton Pump Inhibitors">
  <data key="d0">Proton Pump Inhibitors</data>
  <data key="d1">artifact</data>
  <data key="d2">Proton pump inhibitors are the primary class of drugs employed for gastric acid suppression.&lt;SEP&gt;Proton Pump Inhibitors are drugs that reduce stomach acid secretion by temporarily disabling the proton pump enzyme in parietal cells and are approved for short‑term and longer‑term use for specific acid‑related conditions.</data>
  <data key="d3">chunk-de288167dfc93e3a334ec826d0c43f8e&lt;SEP&gt;chunk-b0747cef262212b19792ffedcc3323ca</data>
