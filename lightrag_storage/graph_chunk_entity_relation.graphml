  <data key="d0">End-stage Heart Failure</data>
  <data key="d1">concept</data>
  <data key="d2">End-stage Heart Failure is a severe form of heart disease that does not respond to medical treatment and may qualify patients for Heart Transplantation.</data>
  <data key="d3">chunk-d99d14117824aa2b5637825772676446</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404041</data>
