  <data key="d0">Candidiasis</data>
  <data key="d1">concept</data>
  <data key="d2">Candidiasis is a fungal infection listed as a cause of Proctitis.</data>
  <data key="d3">chunk-dad561d3742857b36b06aba05376ddc3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424475</data>
</node>
<node id="Chlamydia">
  <data key="d0">Chlamydia</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Chlamydia is a sexually transmitted bacterial infection listed as a cause of Proctitis.&lt;SEP&gt;Chlamydia is a sexually transmitted infection that can cause acute prostatitis.</data>
  <data key="d3">chunk-dad561d3742857b36b06aba05376ddc3&lt;SEP&gt;chunk-a62b13a067bbff6ba6a45d67ea3a11ea</data>
