  <data key="d3">chunk-08dacc20215db14b42730a5441dcba75</data>
  <data key="d2">Amyloidosis can cause organ failure by impairing normal body function.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786379171</data>
</node>
<node id="Anaerobic Infection">
  <data key="d0">Anaerobic Infection</data>
  <data key="d1">concept</data>
  <data key="d2">Anaerobic Infection is a disease caused by anaerobic bacteria, characterized by abscess formation, foul-smelling pus, and tissue destruction.</data>
