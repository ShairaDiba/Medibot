  <data key="d0">24-Hour Urine Specimen</data>
  <data key="d1">artifact</data>
  <data key="d2">A 24-Hour Urine Specimen is a urine collection over a full day used for reliable aldosterone measurement.</data>
  <data key="d3">chunk-7913b0884240a87bdd0d8c498ec19f82</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377738</data>
</node>
<node id="Blood Sample">
  <data key="d0">Blood Sample</data>
  <data key="d1">artifact</data>
  <data key="d2">A Blood Sample is a specimen of blood drawn for aldosterone testing.&lt;SEP&gt;Blood sample is a specimen taken from a patient for laboratory analysis in diagnosing hyperemesis gravidarum.&lt;SEP&gt;A blood sample is a specimen required for the PRA test.</data>
