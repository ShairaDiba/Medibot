  <data key="d4">unknown_source</data>
  <data key="d5">1786411498</data>
</node>
<node id="Healing Process">
  <data key="d0">Healing Process</data>
  <data key="d3">chunk-f9a8349d932728e6875da544c19a0cc3</data>
  <data key="d2">Rest speeds the healing process by minimizing stress on the injured area.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411244</data>
</node>
<node id="Immunoelectrophoresis">
  <data key="d0">Immunoelectrophoresis</data>
  <data key="d1">method</data>
  <data key="d2">Immunoelectrophoresis is a laboratory method that determines blood levels of three major immunoglobulins by separating serum proteins in agar gel with an electric current and identifying them using antiserum.</data>
  <data key="d3">chunk-6b9fc1b34d14fc269e1a1fcf2a895892</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411303</data>
</node>
<node id="Gamma Globulin Electrophoresis">
  <data key="d0">Gamma Globulin Electrophoresis</data>
  <data key="d1">method</data>
  <data key="d2">Gamma Globulin Electrophoresis is an alternative name for the Immunoelectrophoresis method.</data>
  <data key="d3">chunk-6b9fc1b34d14fc269e1a1fcf2a895892</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411303</data>
</node>
<node id="Immunoglobulin M">
  <data key="d0">Immunoglobulin M</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Immunoglobulin M (IgM) is one of the three major immunoglobulins whose blood level is measured by Immunoelectrophoresis.</data>
  <data key="d3">chunk-6b9fc1b34d14fc269e1a1fcf2a895892</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411303</data>
</node>
<node id="Immunoglobulin G">
  <data key="d0">Immunoglobulin G</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Immunoglobulin G (IgG) is one of the three major immunoglobulins whose blood level is measured by Immunoelectrophoresis.</data>
  <data key="d3">chunk-6b9fc1b34d14fc269e1a1fcf2a895892</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411303</data>
</node>
<node id="Hysteroscopy">
  <data key="d0">Hysteroscopy</data>
  <data key="d1">method</data>
  <data key="d2">Hysteroscopy is a surgical procedure that allows a physician to inspect the uterine cavity via the vagina and cervix using a hysteroscope, serving both diagnostic and treatment purposes.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Hysteroscope">
  <data key="d0">Hysteroscope</data>
  <data key="d1">artifact</data>
  <data key="d2">A hysteroscope is a telescopelike instrument used during hysteroscopy to view the interior of the uterus.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Diagnostic Hysteroscopy">
  <data key="d0">Diagnostic Hysteroscopy</data>
  <data key="d1">method</data>
  <data key="d2">Diagnostic hysteroscopy is a variant of hysteroscopy performed to evaluate infertility, repeated miscarriages, and locate polyps and fibroids.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Operative Hysteroscopy">
  <data key="d0">Operative Hysteroscopy</data>
  <data key="d1">method</data>
  <data key="d2">Operative hysteroscopy is a variant of hysteroscopy used to treat gynecological conditions.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Carbon Dioxide Gas">
  <data key="d0">Carbon Dioxide Gas</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Carbon dioxide gas is a gas used to inflate the uterus during hysteroscopy for better visualization.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Fluid">
  <data key="d0">Fluid</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Fluid is a substance that can be used to inflate the uterus during hysteroscopy as an alternative to gas.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Infertility">
  <data key="d0">Infertility</data>
  <data key="d1">concept</data>
  <data key="d2">Infertility is a reproductive condition whose cause may be evaluated using diagnostic hysteroscopy.&lt;SEP&gt;Infertility is the condition of being unable to become pregnant after a year of regular, unprotected sexual intercourse.&lt;SEP&gt;Infertility is the inability of a man and woman to achieve pregnancy after at least one year of regular unprotected sexual intercourse.&lt;SEP&gt;Infertility is defined as the inability of a man and a woman to conceive a child through sexual intercourse.&lt;SEP&gt;An inability to conceive, which can result from Chlamydia trachomatis infection.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5&lt;SEP&gt;chunk-929ba0da65b01f36a714e919c35cad8f&lt;SEP&gt;chunk-be7a1c4e1372979af71be73cfdd576ec&lt;SEP&gt;chunk-e6d5f82c915dbc402d1fdeb23f98439f&lt;SEP&gt;chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420095</data>
</node>
<node id="Miscarriages">
  <data key="d0">Miscarriages</data>
  <data key="d1">concept</data>
  <data key="d2">Repeated miscarriages are pregnancy losses whose cause may be evaluated using diagnostic hysteroscopy.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Polyps">
  <data key="d0">Polyps</data>
  <data key="d1">concept</data>
  <data key="d2">Polyps are tissue growths in the uterus that can be located using diagnostic hysteroscopy.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411346</data>
</node>
<node id="Fibroids">
  <data key="d0">Fibroids</data>
  <data key="d1">concept</data>
  <data key="d2">Fibroids are benign uterine tumors that can be located using diagnostic hysteroscopy.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="Gynecological Conditions">
  <data key="d0">Gynecological Conditions</data>
  <data key="d1">concept</data>
  <data key="d2">Gynecological conditions are health issues of the female reproductive system that may be treated with operative hysteroscopy.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="Light Bleeding">
  <data key="d0">Light Bleeding</data>
  <data key="d1">concept</data>
  <data key="d2">Light bleeding is a common post‑operative symptom experienced by women after surgical hysteroscopy.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="Cramping">
  <data key="d0">Cramping</data>
  <data key="d1">concept</data>
  <data key="d2">Cramping or pain is a common post‑operative symptom that may occur after operative hysteroscopy.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="Shoulder Pain">
  <data key="d0">Shoulder Pain</data>
  <data key="d1">concept</data>
  <data key="d2">Shoulder pain may occur after hysteroscopy when carbon dioxide gas is used to inflate the uterus.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="Nonprescription Pain Relievers">
  <data key="d0">Nonprescription Pain Relievers</data>
  <data key="d1">artifact</data>
  <data key="d2">Nonprescription pain relievers are over‑the‑counter medications that may alleviate post‑operative pain following hysteroscopy.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="30 Minutes">
  <data key="d0">30 Minutes</data>
  <data key="d1">data</data>
  <data key="d2">30 minutes is the typical duration of a hysteroscopy procedure.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="Cost Range $750–$4,000">
  <data key="d0">Cost Range $750–$4,000</data>
  <data key="d1">data</data>
  <data key="d2">The cost of hysteroscopy varies between $750 and $4,000 depending on the extent of the procedure.</data>
  <data key="d3">chunk-be7a1c4e1372979af71be73cfdd576ec</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411347</data>
</node>
<node id="Hysterosonography">
  <data key="d0">Hysterosonography</data>
  <data key="d1">method</data>
  <data key="d2">Hysterosonography is a noninvasive technique that involves slow infusion of sterile saline solution into a woman's uterus during ultrasound imaging to evaluate uterine abnormalities.</data>
  <data key="d3">chunk-706b7a1f3ec2b6d533a9af13bf94e765</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411362</data>
</node>
<node id="Sonohysterography">
  <data key="d0">Sonohysterography</data>
  <data key="d1">method</data>
  <data key="d2">Sonohysterography is an alternative name for hysterosonography.</data>
  <data key="d3">chunk-706b7a1f3ec2b6d533a9af13bf94e765</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411362</data>
</node>
<node id="Sterile Saline Solution">
  <data key="d0">Sterile Saline Solution</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Sterile saline solution is a sterile fluid infused into the uterus during hysterosonography.</data>
  <data key="d3">chunk-706b7a1f3ec2b6d533a9af13bf94e765</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411362</data>
</node>
<node id="Safety and Efficacy of Strategic Implantable Cardioverter-Defibrillator Programming to Reduce the Shock Delivery Burden in a Primary Prevention Patient Population">
  <data key="d0">Safety and Efficacy of Strategic Implantable Cardioverter-Defibrillator Programming to Reduce the Shock Delivery Burden in a Primary Prevention Patient Population</data>
  <data key="d1">content</data>
  <data key="d2">This research article by Buber et al. discusses programming of implantable cardioverter-defibrillators to reduce shock burden, cited in the text.</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411410</data>
</node>
<node id="Erectile Dysfunction">
  <data key="d0">Erectile Dysfunction</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a&lt;SEP&gt;chunk-91b63fc7d102b55c2843666075d6ad7e</data>
  <data key="d2">Impotence is often called erectile dysfunction, indicating they refer to the same condition.&lt;SEP&gt;Erectile dysfunction (ED) is a condition of insufficient erection, previously used to classify Peyronie's disease.</data>
  <data key="d1">concept</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420390</data>
</node>
<node id="Impotence">
  <data key="d0">Impotence</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a&lt;SEP&gt;chunk-91b63fc7d102b55c2843666075d6ad7e</data>
  <data key="d2">Impotence is often called erectile dysfunction, indicating they refer to the same condition.&lt;SEP&gt;Impotence, also known as erectile dysfunction, was an early classification for Peyronie's disease.</data>
  <data key="d1">concept</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420390</data>
</node>
<node id="Penile Nerves">
  <data key="d0">Penile Nerves</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">The spinal cord transmits signals to the nerves of the penis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411412</data>
</node>
<node id="Corpora Cavernosa">
  <data key="d0">Corpora Cavernosa</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a&lt;SEP&gt;chunk-91b63fc7d102b55c2843666075d6ad7e</data>
  <data key="d2">Penile nerve endings release neurotransmitters that signal the corpora cavernosa to engorge.&lt;SEP&gt;Corpora cavernosa are the two tubular chambers within the penis that fill with blood during erection.</data>
  <data key="d1">naturalobject</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420389</data>
</node>
<node id="Peyronie's Disease">
  <data key="d0">Peyronie's Disease</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a&lt;SEP&gt;chunk-91b63fc7d102b55c2843666075d6ad7e</data>
  <data key="d2">Peyronie's disease, affecting connective tissue, may prevent normal erection leading to impotence.&lt;SEP&gt;Peyronie's Disease is an acquired inflammatory urological condition characterized by a bent erect penis due to plaque formation in the tunica albuginea.</data>
  <data key="d1">concept</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420389</data>
</node>
<node id="Glucose Test">
  <data key="d0">Glucose Test</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">Glucose testing for diabetes is included in diagnosing impotence.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411416</data>
</node>
<node id="Implantable Cardioverter-Defibrillator">
  <data key="d0">Implantable Cardioverter-Defibrillator</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">The cited study discusses programming strategies for the implantable cardioverter-defibrillator device.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411418</data>
</node>
<node id="Nocturnal Penile Tumescence Testing">
  <data key="d0">Nocturnal Penile Tumescence Testing</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">Nocturnal penile tumescence testing assesses erections during sleep to help diagnose impotence.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411418</data>
</node>
<node id="Implantable Penile Prosthesis">
  <data key="d0">Implantable Penile Prosthesis</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">Implantable penile prosthesis is a standard treatment option for impotence.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411419</data>
</node>
<node id="Long-term Psychotherapy">
  <data key="d0">Long-term Psychotherapy</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">Long-term psychotherapy is used as a treatment approach for impotence, especially when psychological factors are involved.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411420</data>
</node>
<node id="Individual Counseling">
  <data key="d0">Individual Counseling</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">Individual counseling is employed to treat impotence when emotional factors contribute to the condition.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411421</data>
</node>
<node id="Marital Counseling">
  <data key="d0">Marital Counseling</data>
  <data key="d3">chunk-1d92409f9e3722b81f594b7b8d561f3a</data>
  <data key="d2">Marital counseling is used as a treatment method for impotence, addressing relationship dynamics that affect sexual function.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411422</data>
</node>
<node id="Impetigo">
  <data key="d0">Impetigo</data>
  <data key="d1">concept</data>
  <data key="d2">Impetigo is a very localized contagious bacterial skin infection, often affecting the area around the nose and mouth, with bullous and epidemic types.</data>
  <data key="d3">chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411427</data>
</node>
<node id="Mupirocin">
  <data key="d0">Mupirocin</data>
  <data key="d1">artifact</data>
  <data key="d2">Mupirocin is a topical antibiotic cream used to treat uncomplicated impetigo.</data>
  <data key="d3">chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411427</data>
</node>
<node id="Handwashing">
  <data key="d0">Handwashing</data>
  <data key="d1">method</data>
  <data key="d2">Handwashing is a hygiene practice recommended to prevent the spread of impetigo.</data>
  <data key="d3">chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411427</data>
</node>
<node id="Vesicle">
  <data key="d0">Vesicle</data>
  <data key="d1">concept</data>
  <data key="d2">Vesicle is listed as a key term referring to fluid-filled lesions associated with impetigo.</data>
  <data key="d3">chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411428</data>
</node>
<node id="Implantable Cardioverter Defibrillator">
  <data key="d0">Implantable Cardioverter Defibrillator</data>
  <data key="d1">artifact</data>
  <data key="d2">Implantable cardioverter defibrillator is a medical device mentioned as a key term in the impetigo entry.</data>
  <data key="d3">chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411428</data>
</node>
<node id="Bullous Impetigo">
  <data key="d0">Bullous Impetigo</data>
  <data key="d1">concept</data>
  <data key="d2">Bullous impetigo is one of the two types of impetigo, characterized by fluid-filled blisters.&lt;SEP&gt;Bullous Impetigo is a skin infection characterized by fluid-filled vesicles that develop a honey-colored crust.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3&lt;SEP&gt;chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411499</data>
</node>
<node id="Epidemic Impetigo">
  <data key="d0">Epidemic Impetigo</data>
  <data key="d1">concept</data>
  <data key="d2">Epidemic impetigo is the other type of impetigo, often more widespread and contagious.&lt;SEP&gt;Epidemic Impetigo is a highly transmissible form of impetigo caused by staph or strep bacteria.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3&lt;SEP&gt;chunk-5212ecff28a486ed3ab5e22a14c8388f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411499</data>
</node>
<node id="Immunologic Therapy">
  <data key="d0">Immunologic Therapy</data>
  <data key="d1">concept</data>
  <data key="d2">Immunologic therapy is an approach to treating disease by using medicine to stimulate the body’s natural immune response.</data>
  <data key="d3">chunk-4746af750ee6290790a52a00be9ec1c7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411483</data>
</node>
<node id="Immunologic Therapies">
  <data key="d0">Immunologic Therapies</data>
  <data key="d1">concept</data>
  <data key="d2">Immunologic therapies refer to the collection of therapeutic approaches that use medicine to stimulate the immune system against disease.</data>
  <data key="d3">chunk-4746af750ee6290790a52a00be9ec1c7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411483</data>
</node>
<node id="Hepatitis">
  <data key="d0">Hepatitis</data>
  <data key="d1">concept</data>
  <data key="d2">Hepatitis is a disease that immunologic therapy aims to fight by enhancing the immune system’s response.&lt;SEP&gt;Hepatitis represents viral infections that can theoretically be transmitted by piercing and tattooing.&lt;SEP&gt;Hepatitis is inflammation of the liver that can occur as a symptom in Type I polyglandular deficiency syndrome.</data>
  <data key="d3">chunk-4746af750ee6290790a52a00be9ec1c7&lt;SEP&gt;chunk-8db2289714a65b14031455c87d3fc259&lt;SEP&gt;chunk-01a42939570e7d067a66881fea563910</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422229</data>
</node>
<node id="Immune Response">
  <data key="d0">Immune Response</data>
  <data key="d1">concept</data>
  <data key="d2">The immune response is the body’s natural defense mechanism that immunologic therapy seeks to stimulate.</data>
  <data key="d3">chunk-4746af750ee6290790a52a00be9ec1c7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411483</data>
</node>
<node id="Immunosuppression">
  <data key="d0">Immunosuppression</data>
  <data key="d1">concept</data>
  <data key="d2">Immunosuppression is a condition of reduced immune activity that immunologic therapy may help the body recover from.&lt;SEP&gt;Immunosuppression is the act of reducing or restraining the efficacy or activity level of the immune system, occurring naturally, unintentionally, or deliberately.&lt;SEP&gt;Immunosuppression is a key term associated with Primary Biliary Cirrhosis.</data>
  <data key="d3">chunk-eff6cb4281c913c830bd641c706365c5&lt;SEP&gt;chunk-b29429d857edf1192105634eda51b928&lt;SEP&gt;chunk-4746af750ee6290790a52a00be9ec1c7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424271</data>
</node>
<node id="Medicine">
  <data key="d0">Medicine</data>
  <data key="d1">concept</data>
  <data key="d2">Medicine refers to the</data>
  <data key="d3">chunk-4746af750ee6290790a52a00be9ec1c7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411483</data>
</node>
<node id="Impedance Phlebography">
  <data key="d0">Impedance Phlebography</data>
  <data key="d1">method</data>
  <data key="d2">Impedance Phlebography is a noninvasive test that uses electrical monitoring to measure blood flow in veins of the leg for detecting clot-related conditions.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411498</data>
</node>
<node id="Deep Vein Thrombosis">
  <data key="d0">Deep Vein Thrombosis</data>
  <data key="d1">concept</data>
  <data key="d2">Deep Vein Thrombosis is a condition involving blood clots lodged in the deep veins of the leg.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411498</data>
</node>
<node id="Pulmonary Emboli">
  <data key="d0">Pulmonary Emboli</data>
  <data key="d1">concept</data>
  <data key="d2">Pulmonary Emboli are blood clots that travel to and block arteries in the lungs.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411498</data>
</node>
<node id="Plethysmograph">
  <data key="d0">Plethysmograph</data>
  <data key="d1">artifact</data>
  <data key="d2">Plethysmograph is an instrument that records changes in electrical resistance during impedance phlebography.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411498</data>
</node>
<node id="Conductive Jelly">
  <data key="d0">Conductive Jelly</data>
  <data key="d1">artifact</data>
  <data key="d2">Conductive Jelly is a gel applied to the patient's skin to improve electrical contact for electrodes during the test.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411498</data>
</node>
<node id="Calf">
  <data key="d0">Calf</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Calf is the lower part of the leg where electrodes are placed for impedance phlebography.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411498</data>
</node>
<node id="Staph Bacteria">
  <data key="d0">Staph Bacteria</data>
  <data key="d1">creature</data>
  <data key="d2">Staph Bacteria are a type of bacteria that commonly cause bullous impetigo.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411499</data>
</node>
<node id="Strep Bacteria">
  <data key="d0">Strep Bacteria</data>
  <data key="d1">creature</data>
  <data key="d2">Strep Bacteria are a type of bacteria that can cause epidemic impetigo.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411499</data>
</node>
<node id="Humidity">
  <data key="d0">Humidity</data>
  <data key="d1">concept</data>
  <data key="d2">Humidity is an environmental condition that raises the likelihood of impetigo outbreaks.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411499</data>
</node>
<node id="Crowded Conditions">
  <data key="d0">Crowded Conditions</data>
  <data key="d1">concept</data>
  <data key="d2">Crowded Conditions describe densely populated settings that facilitate spread of impetigo.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411499</data>
</node>
<node id="Poor Hygiene">
  <data key="d0">Poor Hygiene</data>
  <data key="d1">concept</data>
  <data key="d2">Poor Hygiene refers to inadequate cleanliness practices that elevate impetigo risk.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411499</data>
</node>
<node id="Blood Clots">
  <data key="d0">Blood Clots</data>
  <data key="d1">concept</data>
  <data key="d2">Blood Clots are aggregations of blood that can obstruct vessels, leading to conditions like deep vein thrombosis and pulmonary emboli.&lt;SEP&gt;Blood Clots are formations within blood vessels that can result from coagulation or surgical procedures.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3&lt;SEP&gt;chunk-ec14d30df69d510d9dcaa9c0f8a32fd9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419126</data>
</node>
<node id="Veins">
  <data key="d0">Veins</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Veins are blood vessels that transport blood toward the heart and are assessed during impedance phlebography.&lt;SEP&gt;Veins are blood vessels that may be affected by Peripheral Vascular Disease.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3&lt;SEP&gt;chunk-2718c6e6fa21ad7d51803e9bd95a0fa3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420076</data>
</node>
<node id="Electrical Impedance">
  <data key="d0">Electrical Impedance</data>
  <data key="d1">concept</data>
  <data key="d2">Electrical Impedance is the resistance to electrical energy transmission that varies with blood volume in veins.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411500</data>
</node>
<node id="Pressure Cuff">
  <data key="d0">Pressure Cuff</data>
  <data key="d1">artifact</data>
  <data key="d2">Pressure Cuff is a device used to inflate pressure on the calf, causing a rise in vein pressure during the test.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411500</data>
</node>
<node id="Electrodes">
  <data key="d0">Electrodes</data>
  <data key="d1">artifact</data>
  <data key="d2">Electrodes are conductive pads placed on the calf that connect to the plethysmograph during impedance phlebography.</data>
  <data key="d3">chunk-3f69c2450b3e8a6ce90d873db565dfb3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411500</data>
</node>
<node id="Immunoglobulin Deficiency Syndromes">
  <data key="d0">Immunoglobulin Deficiency Syndromes</data>
  <data key="d1">concept</data>
  <data key="d2">Immunoglobulin deficiency syndromes are a group of severe immunodeficiency disorders characterized by reduced or absent antibodies.</data>
  <data key="d3">chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="Immunodeficiency Disorders">
  <data key="d0">Immunodeficiency Disorders</data>
  <data key="d1">concept</data>
  <data key="d2">Immunodeficiency disorders are diseases where the immune system's ability to fight infections is compromised.</data>
  <data key="d3">chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="Immunoglobulins">
  <data key="d0">Immunoglobulins</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Immunoglobulins, also known as antibodies, are gamma globulin proteins found in blood and other fluids that neutralize bacteria, viruses, and foreign substances.</data>
  <data key="d3">chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="B Lymphocytes">
  <data key="d0">B Lymphocytes</data>
  <data key="d1">naturalobject</data>
  <data key="d2">B lymphocytes (B cells) are immune cells responsible for producing antibodies and can have congenital development defects.</data>
  <data key="d3">chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="X-Linked Agammaglobulinemia">
  <data key="d0">X-Linked Agammaglobulinemia</data>
  <data key="d1">concept</data>
  <data key="d2">X-linked agammaglobulinemia is a disease example caused by failure of B cells to develop into antibody-producing cells.</data>
  <data key="d3">chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="Intravenous Immunoglobulin Administration">
  <data key="d0">Intravenous Immunoglobulin Administration</data>
  <data key="d1">method</data>
  <data key="d2">Intravenous administration of immunoglobulin is a treatment that temporarily boosts immunity for patients with immunoglobulin deficiency syndromes.</data>
  <data key="d3">chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="Dental Care">
  <data key="d0">Dental Care</data>
  <data key="d1">method</data>
  <data key="d2">Dental care is a health maintenance practice that patients with immunoglobulin deficiency syndromes must follow to stay in good health.</data>
  <data key="d3">chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="In Vitro Fertilization">
  <data key="d0">In Vitro Fertilization</data>
  <data key="d1">method</data>
  <data key="d2">In Vitro Fertilization is a medical procedure that removes eggs from a woman's ovary, fertilizes them with sperm in a laboratory, and returns the resulting embryo to the woman's uterus.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411606</data>
</node>
<node id="Assisted Reproductive Techniques">
  <data key="d0">Assisted Reproductive Techniques</data>
  <data key="d1">concept</data>
  <data key="d2">Assisted Reproductive Techniques are a group of medical methods, including IVF, used to help infertile couples conceive a child.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411606</data>
</node>
<node id="Embryo">
  <data key="d0">Embryo</data>
  <data key="d1">naturalobject</data>
  <data key="d2">An embryo is the fertilized egg created in the laboratory and transferred to the woman's uterus in IVF.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411606</data>
</node>
<node id="Infertile Couples">
  <data key="d0">Infertile Couples</data>
  <data key="d1">person</data>
  <data key="d2">Infertile couples are pairs of individuals who are unable to conceive after one year of unprotected intercourse and may seek IVF.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411606</data>
</node>
<node id="2012 IVF Birth Defect Study">
  <data key="d0">2012 IVF Birth Defect Study</data>
  <data key="d1">content</data>
  <data key="d2">The 2012 study reported that babies conceived through IVF are one-third more likely to have a birth defect compared to naturally conceived babies.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411607</data>
</node>
<node id="Babies Born Using IVF">
  <data key="d0">Babies Born Using IVF</data>
  <data key="d1">person</data>
  <data key="d2">Babies born using IVF are children conceived through the IVF procedure.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411607</data>
</node>
<node id="IVF">
  <data key="d0">IVF</data>
  <data key="d1">method</data>
  <data key="d2">IVF is the abbreviation for In Vitro Fertilization, the assisted reproduction procedure.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411607</data>
</node>
<node id="ART">
  <data key="d0">ART</data>
  <data key="d1">concept</data>
  <data key="d2">ART stands for Assisted Reproductive Techniques, the group of methods that includes IVF.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411607</data>
</node>
<node id="Laboratory Procedure">
  <data key="d0">Laboratory Procedure</data>
  <data key="d1">method</data>
  <data key="d2">Laboratory Procedure refers to the step in IVF where eggs are fertilized with sperm outside the body.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411607</data>
</node>
<node id="Babies Conceived Naturally">
  <data key="d0">Babies Conceived Naturally</data>
  <data key="d1">person</data>
  <data key="d2">Babies conceived naturally are children born without assisted reproductive technologies.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411607</data>
</node>
<node id="Impacted Tooth">
  <data key="d0">Impacted Tooth</data>
  <data key="d1">concept</data>
  <data key="d2">Impacted Tooth is a condition where a tooth fails to reach its normal position due to blockage by tissue, bone, or another tooth.</data>
  <data key="d3">chunk-31523ff9a2a651ce41cbc96e86cccd97</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411623</data>
</node>
<node id="Third Molar">
  <data key="d0">Third Molar</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Third Molar, also called wisdom tooth, is the last tooth to develop and often becomes impacted.</data>
  <data key="d3">chunk-31523ff9a2a651ce41cbc96e86cccd97</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411623</data>
</node>
<node id="Wisdom Tooth">
  <data key="d0">Wisdom Tooth</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Wisdom Tooth refers to the third molars that may become impacted if the jaw is too small.</data>
  <data key="d3">chunk-31523ff9a2a651ce41cbc96e86cccd97</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411623</data>
</node>
<node id="Jawbone">
  <data key="d0">Jawbone</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Jawbone is the bone that can block the eruption of a tooth, causing impaction.</data>
  <data key="d3">chunk-31523ff9a2a651ce41cbc96e86cccd97</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411623</data>
</node>
