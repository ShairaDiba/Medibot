<node id="Pelvic Relaxation">
  <data key="d0">Pelvic Relaxation</data>
  <data key="d1">concept</data>
  <data key="d2">Pelvic relaxation is a severe condition characterized by weakening of the supportive muscles and ligaments of the pelvic floor, affecting women.</data>
  <data key="d3">chunk-2d8fe6834775c118dee9d1addc0b895c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419540</data>
