  <data key="d0">Surgery on Thyroid Gland</data>
  <data key="d1">method</data>
  <data key="d2">Surgical removal of the thyroid gland is a procedure that can cause hypothyroidism.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410681</data>
