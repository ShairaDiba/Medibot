  <data key="d4">unknown_source</data>
  <data key="d5">1786404756</data>
</node>
<node id="Phlebotomy">
  <data key="d0">Phlebotomy</data>
  <data key="d1">method</data>
  <data key="d2">Phlebotomy is a treatment procedure that removes blood to reduce iron levels in patients with hemochromatosis.&lt;SEP&gt;Phlebotomy is a medical procedure that involves drawing or removing blood from the circulatory system through a cut or puncture to obtain a sample for analysis or therapeutic purposes.&lt;SEP&gt;Phlebotomy is a medical procedure that can provoke fear in individuals with phobias.</data>
  <data key="d3">chunk-d89439564ae2dc33beae4237976b40b1&lt;SEP&gt;chunk-5d78fea89c4fad7d739948de01e91d4a&lt;SEP&gt;chunk-af3b4b939a2aeb8a2dffe85570c09b57</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420675</data>
</node>
<node id="Iron and Ferritin Studies">
  <data key="d0">Iron and Ferritin Studies</data>
  <data key="d1">method</data>
  <data key="d2">Iron and ferritin studies are screening methods recommended for relatives of patients with hemochromatosis.</data>
  <data key="d3">chunk-5d78fea89c4fad7d739948de01e91d4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404757</data>
</node>
<node id="Genetic Test">
  <data key="d0">Genetic Test</data>
  <data key="d1">method</data>
  <data key="d2">Genetic testing is a screening method used to identify carriers or affected individuals of hemochromatosis.</data>
  <data key="d3">chunk-5d78fea89c4fad7d739948de01e91d4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404757</data>
</node>
<node id="Screening">
  <data key="d0">Screening</data>
  <data key="d1">method</data>
  <data key="d2">Screening refers to cost‑effective testing of relatives for hemochromatosis using iron, ferritin, or genetic studies.&lt;SEP&gt;Screening is an evaluation process of the colon and rectum that includes physical exam, laboratory tests, and visualization of the lining using X rays or endoscopy, and may involve a digital rectal exam.</data>
  <data key="d3">chunk-5d78fea89c4fad7d739948de01e91d4a&lt;SEP&gt;chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426767</data>
</node>
