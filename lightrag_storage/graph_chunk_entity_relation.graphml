  <data key="d3">chunk-0b6a561225b73fa4827b9e9a8a411e05</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786385825</data>
</node>
<node id="Ergosterol Synthesis">
  <data key="d0">Ergosterol Synthesis</data>
  <data key="d1">concept</data>
  <data key="d2">process in fungal cells whose inhibition by systemic antifungal drugs increases cell wall permeability.</data>
  <data key="d3">chunk-0b6a561225b73fa4827b9e9a8a411e05</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786385825</data>
</node>
<node id="Cell Wall Permeability">
  <data key="d0">Cell Wall Permeability</data>
  <data key="d1">concept</data>
  <data key="d2">increased permeability of fungal cell wall resulting from ergosterol synthesis inhibition, causing leakage of cellular content.</data>
  <data key="d3">chunk-0b6a561225b73fa4827b9e9a8a411e05</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786385825</data>
</node>
<node id="Cellular Content Leakage">
  <data key="d0">Cellular Content Leakage</data>
  <data key="d1">concept</data>
  <data key="d2">leakage of cellular contents from fungal cells due to increased cell wall permeability, leading to cell death.</data>
  <data key="d3">chunk-0b6a561225b73fa4827b9e9a8a411e05</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786385826</data>
</node>
<node id="Fungal Cell Death">
  <data key="d0">Fungal Cell Death</data>
  <data key="d1">concept</data>
  <data key="d2">outcome of inhibited DNA/protein synthesis or cellular content leakage in fungal cells.</data>
  <data key="d3">chunk-0b6a561225b73fa4827b9e9a8a411e05</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786385826</data>
</node>
