  <data key="d4">unknown_source</data>
  <data key="d5">1786403744</data>
</node>
<node id="Shortness of Breath">
  <data key="d0">Shortness of Breath</data>
  <data key="d1">concept</data>
  <data key="d2">Shortness of Breath is a symptom characterized by difficulty breathing during activity or sleep, noted as a classic indicator of heart failure.&lt;SEP&gt;Shortness of breath is a possible symptom experienced by individuals with hypertension.&lt;SEP&gt;Shortness of Breath is a primary symptom experienced by patients with pleural effusion.&lt;SEP&gt;Shortness of breath is a symptom describing difficulty in breathing, whose cause can be identified by pulmonary function tests.</data>
  <data key="d3">chunk-448825a5baf21347c5a8fd84c362669b&lt;SEP&gt;chunk-910d4bcf6932bd29fd1d161e11852b46&lt;SEP&gt;chunk-5b4f1384d965014ddcabd93b7495e501&lt;SEP&gt;chunk-7dcd996730cbdde5a41d3f86b16d8074</data>
