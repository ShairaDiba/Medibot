<node id="Nerves">
  <data key="d0">Nerves</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Nerves are part of the nervous system that can be abnormal and contribute to priapism.</data>
  <data key="d3">chunk-c10fb15c165fb1c6b20b0aa8847da7ef</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423958</data>
</node>
<node id="Medical Emergency">
  <data key="d0">Medical Emergency</data>
  <data key="d1">concept</data>
  <data key="d2">Medical emergency denotes a critical condition requiring immediate emergency room treatment, as with priapism lasting over four hours.</data>
  <data key="d3">chunk-c10fb15c165fb1c6b20b0aa8847da7ef</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423958</data>
</node>
<node id="Prophylaxis">
  <data key="d0">Prophylaxis</data>
  <data key="d1">concept</data>
