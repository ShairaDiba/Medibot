  <data key="d0">Hypnosis</data>
  <data key="d1">concept</data>
  <data key="d2">Hypnosis is the altered state of consciousness used in hypnotherapy to treat health conditions and to anesthetize patients.</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410552</data>
</node>
<node id="Hypnotism">
  <data key="d0">Hypnotism</data>
  <data key="d1">concept</data>
  <data key="d2">Hypnotism is a technique involving hypnosis, described as part of the definition of hypnotherapy.</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410552</data>
</node>
<node id="Prolonged Sleep">
  <data key="d0">Prolonged Sleep</data>
  <data key="d1">concept</data>
  <data key="d2">Prolonged sleep is a state induced in hypnotherapy as an alternative method to treat health conditions.</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410552</data>
</node>
<node id="Performance Anxiety">
  <data key="d0">Performance Anxiety</data>
  <data key="d1">concept</data>
  <data key="d2">Performance anxiety is a condition, such as in sports or public speaking, that hypnotherapy can help alleviate.</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410552</data>
</node>
<node id="Austria">
  <data key="d0">Austria</data>
  <data key="d1">location</data>
  <data key="d2">Austria is the country associated with Franz Mesmer, who is described as an Austrian physician.</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410552</data>
