<node id="Donor Heart">
  <data key="d0">Donor Heart</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Donor Heart is a healthy human heart obtained from a non‑identical donor and used to replace a recipient’s diseased heart in Heart Transplantation.</data>
  <data key="d3">chunk-d99d14117824aa2b5637825772676446</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404041</data>
