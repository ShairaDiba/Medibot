  <data key="d3">chunk-3a5fe7cfd2eb995bee47dc8e7a28fbbf</data>
  <data key="d2">Low haptoglobin levels usually indicate hemolytic anemia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403298</data>
</node>
<node id="Tension-Type Headache">
  <data key="d0">Tension-Type Headache</data>
  <data key="d1">concept</data>
  <data key="d2">Tension-Type Headache is a primary headache type linked to muscular contraction of scalp, face, or neck muscles.</data>
  <data key="d3">chunk-540eabf6d4c3ae30f94409ef704b5804</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403310</data>
</node>
<node id="Migraine">
  <data key="d0">Migraine</data>
  <data key="d1">concept</data>
  <data key="d2">Migraine is a primary vascular headache type associated with blood vessel dilation and often accompanied by nausea, light and sound sensitivity.</data>
  <data key="d3">chunk-540eabf6d4c3ae30f94409ef704b5804</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403310</data>
</node>
<node id="Cluster Headache">
  <data key="d0">Cluster Headache</data>
  <data key="d1">concept</data>
  <data key="d2">Cluster Headache is a primary headache type affecting a small portion of the population, frequently linked to male gender and food allergies.</data>
  <data key="d3">chunk-540eabf6d4c3ae30f94409ef704b5804</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403310</data>
</node>
<node id="Head Injury">
  <data key="d0">Head Injury</data>
  <data key="d1">concept</data>
  <data key="d2">Head Injury is a severe condition involving damage to the scalp, skull, or brain, which may be closed or penetrating and can lead to serious complications.</data>
  <data key="d3">chunk-c57d2e1d2339fe77cd5d3f9d16b31980</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403372</data>
</node>
<node id="Traumatic Brain Injury">
  <data key="d0">Traumatic Brain Injury</data>
  <data key="d1">concept</data>
  <data key="d2">Traumatic Brain Injury is the most important consequence of head trauma, involving damage to brain tissue.</data>
  <data key="d3">chunk-c57d2e1d2339fe77cd5d3f9d16b31980</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403372</data>
</node>
<node id="Closed Head Injury">
  <data key="d0">Closed Head Injury</data>
  <data key="d1">concept</data>
  <data key="d2">Closed Head Injury is a type of head injury caused by impact such as the head hitting a car’s windshield, without penetration of the skull.</data>
  <data key="d3">chunk-c57d2e1d2339fe77cd5d3f9d16b31980</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403372</data>
</node>
<node id="Scalp">
  <data key="d0">Scalp</data>
  <data key="d3">chunk-c57d2e1d2339fe77cd5d3f9d16b31980</data>
  <data key="d2">Head Injury may cause damage to the scalp.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403373</data>
</node>
<node id="Bullet">
  <data key="d0">Bullet</data>
  <data key="d3">chunk-c57d2e1d2339fe77cd5d3f9d16b31980</data>
  <data key="d2">Penetrating Head Injury may occur when a bullet pierces the skull.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403373</data>
</node>
<node id="Penetrating Head Injury">
  <data key="d0">Penetrating Head Injury</data>
  <data key="d3">chunk-c57d2e1d2339fe77cd5d3f9d16b31980</data>
  <data key="d2">Penetrating Head Injury may occur when a bullet pierces the skull.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403373</data>
</node>
<node id="Head and Neck Cancer">
  <data key="d0">Head and Neck Cancer</data>
  <data key="d1">concept</data>
  <data key="d2">Head and Neck Cancer refers to a group of cancers located in the head and neck region, excluding tumors of the eyes, thyroid gland, and brain.&lt;SEP&gt;Head and neck cancer is a malignant disease that can spread to nearby tissues and lymph nodes, often treated with radical neck dissection.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309&lt;SEP&gt;chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426814</data>
</node>
<node id="Oral Cavity">
  <data key="d0">Oral Cavity</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The oral cavity is the mouth region encompassing lips, tongue, teeth, gums, inner lining, floor and roof of the mouth, and area behind wisdom teeth.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403383</data>
</node>
<node id="Larynx">
  <data key="d0">Larynx</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The larynx, or voice box, is a structure in the throat that enables speech and breathing.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403383</data>
</node>
<node id="Pharynx">
  <data key="d0">Pharynx</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The pharynx is the throat region connecting the nasal and oral cavities to the esophagus and larynx.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403383</data>
</node>
<node id="Laryngeal Cancer">
  <data key="d0">Laryngeal Cancer</data>
  <data key="d1">concept</data>
  <data key="d2">Laryngeal Cancer is a malignant disease affecting the larynx (voice box) and is listed among head and neck cancers.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403383</data>
</node>
<node id="Oral Cancer">
  <data key="d0">Oral Cancer</data>
  <data key="d1">concept</data>
  <data key="d2">Oral Cancer is a malignant disease affecting the oral cavity, including lips, tongue, teeth, gums and related structures, and is listed among head and neck cancers.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403383</data>
</node>
<node id="Human Papillomavirus (HPV)">
  <data key="d0">Human Papillomavirus (HPV)</data>
  <data key="d1">concept</data>
  <data key="d2">Human Papillomavirus (HPV) is a virus identified as a recent risk factor for oral cancer, especially the HPV16 strain.&lt;SEP&gt;Human Papillomavirus (HPV) is the virus responsible for cervical cancer, genital warts and other HPV‑related diseases.</data>
  <data key="d3">chunk-08ae2e30c6ce7727579bbfec49efeed5&lt;SEP&gt;chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409264</data>
</node>
<node id="HPV16">
  <data key="d0">HPV16</data>
  <data key="d1">naturalobject</data>
  <data key="d2">HPV16 is a specific high‑risk strain of human papillomavirus linked to oral cancer.</data>
  <data key="d3">chunk-7c54bf8feacba012d420dc1bafe3e309</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403384</data>
</node>
