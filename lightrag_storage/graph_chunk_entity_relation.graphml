  <data key="d0">2002 Sleep in America Poll</data>
  <data key="d1">data</data>
  <data key="d2">The 2002 Sleep in America poll conducted by NSF surveyed American sleep quality and reported insomnia‑related statistics.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Biofeedback">
  <data key="d0">Biofeedback</data>
  <data key="d1">method</data>
  <data key="d2">Biofeedback is a therapeutic method that uses physiological monitoring to help individuals gain control over bodily processes, listed as a key term for insomnia.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Mood Disorder">
  <data key="d0">Mood Disorder</data>
  <data key="d1">concept</data>
  <data key="d2">Mood disorder is a class of mental health conditions related to emotional regulation, noted as a key term associated with insomnia.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Sleep Disorder">
  <data key="d0">Sleep Disorder</data>
  <data key="d1">concept</data>
  <data key="d2">Sleep disorder is a broad category of conditions affecting sleep, with insomnia being a primary example.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Alternative Medicine">
  <data key="d0">Alternative Medicine</data>
  <data key="d1">method</data>
  <data key="d2">Alternative medicine refers to non‑conventional therapeutic approaches sometimes employed to treat insomnia.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Conventional Medicine">
  <data key="d0">Conventional Medicine</data>
  <data key="d1">concept</data>
  <data key="d2">Conventional medicine denotes standard medical practices used in the diagnosis and treatment of insomnia.&lt;SEP&gt;Conventional medicine refers to standard, mainstream medical practice that serves as a reference point for integrative medicine.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0&lt;SEP&gt;chunk-6d18ad91bb57e38afe9e037c977bc3b6</data>
