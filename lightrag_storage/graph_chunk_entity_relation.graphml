  <data key="d5">1786419845</data>
</node>
<node id="Stop Antibiotics">
  <data key="d0">Stop Antibiotics</data>
  <data key="d1">method</data>
  <data key="d2">Stopping antibiotic use is a treatment approach that allows normal intestinal bacteria to repopulate and inhibits overgrowth of Clostridium difficile.</data>
  <data key="d3">chunk-b5a65a1c3cf6b8503607afdabf8b0202</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786384606</data>
