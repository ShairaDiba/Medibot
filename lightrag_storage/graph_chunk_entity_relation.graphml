<node id="Testosterone">
  <data key="d0">Testosterone</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Testosterone is the primary male hormone that stimulates development of male sexual characteristics, bones, and muscle.</data>
  <data key="d3">chunk-170bf8fe0c421cc796fb1a155cc92877</data>
  <data key="d4">unknown_source</data>
