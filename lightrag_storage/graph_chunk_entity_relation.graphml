<node id="Paruresis">
  <data key="d0">Paruresis</data>
  <data key="d1">concept</data>
  <data key="d2">A medical condition, also known as shy or bashful bladder, characterized by the inability or difficulty to urinate in the presence of others, under time pressure, or on vehicles.</data>
  <data key="d3">chunk-f07ae0c28dc0d57b8d89d819ee884b1d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786416615</data>
