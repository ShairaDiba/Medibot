<node id="Percutaneous Transhepatic Cholangiography (PTHC)">
  <data key="d0">Percutaneous Transhepatic Cholangiography (PTHC)</data>
  <data key="d1">method</data>
  <data key="d2">Percutaneous Transhepatic Cholangiography (PTHC) is an x‑ray test used to identify obstructions in the liver or bile ducts that affect bile flow.</data>
  <data key="d3">chunk-6c5e751c6db20a49f7ca0a341eadc654</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419483</data>
