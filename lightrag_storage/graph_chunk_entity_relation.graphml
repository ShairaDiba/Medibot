  <data key="d5">1786426986</data>
</node>
<node id="Lesions">
  <data key="d0">Lesions</data>
  <data key="d1">concept</data>
  <data key="d2">Lesions refer to specific structural abnormalities of the heart that can be classified by blood flow characteristics or obstructions.&lt;SEP&gt;Lesions are tissue damages in the lungs caused by the division of Histoplasma capsulatum after spores lodge there.</data>
  <data key="d3">chunk-56ef10afa5a5d842dfa90eafc05da760&lt;SEP&gt;chunk-3323f3fda2ab71ab254c2a21d7d535a1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786408341</data>
</node>
