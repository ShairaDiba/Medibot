<node id="Pressure Points">
  <data key="d0">Pressure Points</data>
  <data key="d1">concept</data>
  <data key="d2">Pressure points are predefined locations on the hands and feet used in reflexology to apply controlled pressure.</data>
  <data key="d3">chunk-e261bddabf1598318602d5ab776f60c1</data>
