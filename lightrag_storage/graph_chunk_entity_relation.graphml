<node id="Cutis laxa">
  <data key="d0">Cutis laxa</data>
  <data key="d1">concept</data>
  <data key="d2">Cutis laxa is a connective tissue disorder characterized by loose, inelastic skin that forms folds.</data>
  <data key="d3">chunk-0412c9964e570b59a9a74a4404773c0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786396916</data>
</node>
<node id="Primary cutis laxa">
  <data key="d0">Primary cutis laxa</data>
  <data key="d1">concept</data>
  <data key="d2">Primary cutis laxa is a hereditary form of cutis laxa present from birth.</data>
  <data key="d3">chunk-0412c9964e570b59a9a74a4404773c0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786396916</data>
</node>
<node id="Secondary cutis laxa">
  <data key="d0">Secondary cutis laxa</data>
  <data key="d1">concept</data>
  <data key="d2">Secondary cutis laxa is a form of cutis laxa that arises later in life and may be hereditary.</data>
  <data key="d3">chunk-0412c9964e570b59a9a74a4404773c0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786396916</data>
</node>
<node id="Acquired cutis laxa">
  <data key="d0">Acquired cutis laxa</data>
  <data key="d1">concept</data>
  <data key="d2">Acquired cutis laxa is a non‑hereditary form of cutis laxa that arises later in life.</data>
  <data key="d3">chunk-0412c9964e570b59a9a74a4404773c0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786396916</data>
</node>
<node id="Sex‑linked cutis laxa">
  <data key="d0">Sex‑linked cutis laxa</data>
  <data key="d1">concept</data>
  <data key="d2">Sex‑linked cutis laxa is caused by a defective gene on the X chromosome.</data>
  <data key="d3">chunk-0412c9964e570b59a9a74a4404773c0b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786396916</data>
</node>
<node id="Autosomal">
  <data key="d0">Autosomal</data>
  <data key="d1">concept</data>
  <data key="d2">Autosomal refers to the 22 pairs of non‑sex chromosomes in humans.&lt;SEP&gt;Autosomal refers to the inheritance pattern of hemochromatosis described as not usually seen in rare autosomal disorders.</data>
  <data key="d3">chunk-0412c9964e570b59a9a74a4404773c0b&lt;SEP&gt;chunk-5d78fea89c4fad7d739948de01e91d4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404755</data>
</node>
<node id="Connective tissue">
  <data key="d0">Connective tissue</data>
  <data key="d1">naturalobject</data>
