  <data key="d1">concept</data>
  <data key="d2">Foul-smelling pus is a symptom of anaerobic infection, indicating bacterial activity.</data>
  <data key="d3">chunk-c1acfa8b3bcf6abb174b1db6c3878690</data>
  <data key="d4">unknown_source</data>
