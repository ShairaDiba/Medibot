  <data key="d0">Paralytic Polio</data>
  <data key="d3">chunk-6a43117074cce1d59c31131832dfa007</data>
  <data key="d2">Patients with paralytic polio may be placed on a respirator to assist breathing.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422253</data>
</node>
<node id="Polarity Therapy">
  <data key="d0">Polarity Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Polarity therapy is a holistic, energy-based system that includes bodywork, diet, exercise, and lifestyle counseling to restore and maintain proper energy flows throughout the body.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422314</data>
</node>
<node id="Randolf Stone">
  <data key="d0">Randolf Stone</data>
  <data key="d1">person</data>
  <data key="d2">Randolf Stone (1888–1981) was an Austrian American chiropractor, osteopath, and naturopath who developed polarity therapy by integrating Eastern and Western healing principles.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422314</data>
</node>
<node id="Ayurvedic Philosophy">
  <data key="d0">Ayurvedic Philosophy</data>
  <data key="d1">concept</data>
  <data key="d2">Ayurvedic philosophy is an ancient Indian system of medicine focusing on balance of bodily energies, studied by Randolph Stone.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422315</data>
</node>
<node id="India">
  <data key="d0">India</data>
  <data key="d1">location</data>
  <data key="d2">India is a country in South Asia where Randolph Stone traveled and discovered Ayurvedic principles.&lt;SEP&gt;India is a country in Asia with a high prevalence of rabies.</data>
  <data key="d3">chunk-04a89a85dc3be8d37412b0c61ebf99cb&lt;SEP&gt;chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426199</data>
</node>
<node id="Reflexology">
  <data key="d0">Reflexology</data>
  <data key="d1">method</data>
  <data key="d2">Reflexology is a therapeutic method involving application of pressure to specific points on the feet, hands, or ears, studied by Randolph Stone.&lt;SEP&gt;Reflexology is a therapeutic method of relieving pain by stimulating predefined pressure points on the feet and hands; it may also promote good health, prevent illness, and relieve symptoms of stress, injury, and illness.</data>
  <data key="d3">chunk-e261bddabf1598318602d5ab776f60c1&lt;SEP&gt;chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426920</data>
</node>
<node id="Ayurvedic Medicine">
  <data key="d0">Ayurvedic Medicine</data>
  <data key="d1">concept</data>
  <data key="d2">Ayurvedic medicine is a practice based on Ayurvedic philosophy, which Randolph Stone interpreted alongside his scientific knowledge.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422315</data>
</node>
<node id="Lifestyle Counseling">
  <data key="d0">Lifestyle Counseling</data>
  <data key="d1">method</data>
  <data key="d2">Lifestyle counseling provides guidance on daily habits, included as a component of polarity therapy.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422316</data>
</node>
<node id="Electromagnetic Force">
  <data key="d0">Electromagnetic Force</data>
  <data key="d1">concept</data>
  <data key="d2">Electromagnetic force is the physical force described as the basis for energy within the human body in the theory of polarity therapy.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422316</data>
</node>
<node id="Disease">
  <data key="d0">Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Disease, in the context of polarity therapy, is described as resulting from improperly dissipated energy.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422316</data>
</node>
<node id="Eastern Healing Principles">
  <data key="d0">Eastern Healing Principles</data>
  <data key="d1">concept</data>
  <data key="d2">Eastern healing principles refer to traditional medical ideas from Eastern cultures that were integrated into polarity therapy by Randolph Stone.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422316</data>
</node>
<node id="Western Healing Principles">
  <data key="d0">Western Healing Principles</data>
  <data key="d1">concept</data>
  <data key="d2">Western healing principles refer to conventional medical concepts from Western medicine that were integrated into polarity therapy by Randolph Stone.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422316</data>
</node>
<node id="Healing Techniques">
  <data key="d0">Healing Techniques</data>
  <data key="d1">concept</data>
  <data key="d2">Healing techniques are methods used in therapy, which in polarity therapy combine Eastern and Western practices.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422316</data>
</node>
<node id="Life Energy">
  <data key="d0">Life Energy</data>
  <data key="d1">concept</data>
  <data key="d2">Life energy is the vital force believed to flow through the human body, which polarity therapy aims to unblock and recharge.&lt;SEP&gt;Life energy, defined as “universal life energy,” is the energy that Reiki seeks to improve the flow of within a person.</data>
  <data key="d3">chunk-75190d071653d27706392e04aa75adb7&lt;SEP&gt;chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426954</data>
</node>
<node id="Scientific and Medical Knowledge">
  <data key="d0">Scientific and Medical Knowledge</data>
  <data key="d1">concept</data>
  <data key="d2">Scientific and medical knowledge represents the conventional scientific understanding that Randolph Stone combined with Ayurvedic principles in developing polarity therapy.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422317</data>
</node>
<node id="Energy-Based System">
  <data key="d0">Energy-Based System</data>
  <data key="d1">concept</data>
  <data key="d2">An energy-based system is a therapeutic framework that focuses on manipulating electromagnetic energy, describing the nature of polarity therapy.</data>
  <data key="d3">chunk-ca4ee33fbe169b1bec7c819c96b35eb6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422317</data>
</node>
<node id="Toxicology">
  <data key="d0">Toxicology</data>
  <data key="d1">concept</data>
  <data key="d2">Toxicology is the branch of medicine that deals with the detection and treatment of poisons.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422325</data>
</node>
