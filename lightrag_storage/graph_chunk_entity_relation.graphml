  <data key="d5">1786426724</data>
</node>
<node id="Radiation Injuries">
  <data key="d0">Radiation Injuries</data>
  <data key="d3">chunk-3a8f2dab345c64ad37c663869bdcf83b</data>
  <data key="d2">Ionizing radiation emitted by various sources causes radiation injuries."</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426724</data>
</node>
<node id="Rectal Cancer">
  <data key="d0">Rectal Cancer</data>
  <data key="d1">concept</data>
  <data key="d2">Rectal Cancer is a malignant disease of the rectum characterized by development of cancerous cells in the rectal lining that can invade local tissue or spread to other organs.&lt;SEP&gt;Rectal cancer is a malignant condition that can arise from untreated benign rectal polyps.</data>
  <data key="d3">chunk-7294fc7c2531b2723bf6002b6e65eee2&lt;SEP&gt;chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786427057</data>
</node>
<node id="Large Bowel">
  <data key="d0">Large Bowel</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The large bowel is the segment of the digestive tract that includes the colon and rectum.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426766</data>
</node>
<node id="Sacrum">
  <data key="d0">Sacrum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The sacrum is the lowest portion of the spine located posterior to the rectum.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426766</data>
</node>
<node id="Hereditary Non-Polyposis Colon Cancer (HNPCC)">
  <data key="d0">Hereditary Non-Polyposis Colon Cancer (HNPCC)</data>
  <data key="d1">concept</data>
  <data key="d2">HNPCC is a hereditary syndrome linked to mutations in DNA mismatch repair genes and associated with increased risk of colon and rectal cancer.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426767</data>
</node>
<node id="p53 Gene">
  <data key="d0">p53 Gene</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The p53 gene is a tumor suppressor gene that is mutated in about 70% of colon or rectal cancer cases.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426767</data>
</node>
<node id="DNA Mismatch Repair">
  <data key="d0">DNA Mismatch Repair</data>
  <data key="d1">concept</data>
  <data key="d2">DNA mismatch repair is a cellular process involving genes whose mutation contributes to HNPCC.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426767</data>
</node>
<node id="Tumor Suppression">
  <data key="d0">Tumor Suppression</data>
  <data key="d1">concept</data>
  <data key="d2">Tumor suppression refers to mechanisms that normally control cell growth, whose defect can lead to early development of colon cancer.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426767</data>
</node>
<node id="Colon Cancer">
  <data key="d0">Colon Cancer</data>
  <data key="d1">concept</data>
  <data key="d2">Colon cancer is a malignant disease of the colon, related to rectal cancer and sharing genetic risk factors.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426767</data>
</node>
<node id="Digital Rectal Exam (DRE)">
  <data key="d0">Digital Rectal Exam (DRE)</data>
  <data key="d1">method</data>
  <data key="d2">Digital Rectal Exam (DRE) is a physical examination where a physician checks stool on the examining glove with a chemical during screening.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426768</data>
</node>
<node id="Endorectal Ultrasound">
  <data key="d0">Endorectal Ultrasound</data>
  <data key="d1">method</data>
  <data key="d2">Endorectal Ultrasound is an imaging procedure performed after diagnosis to assess the clinical stage of rectal cancer.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426768</data>
</node>
<node id="Clinical Staging">
  <data key="d0">Clinical Staging</data>
  <data key="d1">method</data>
  <data key="d2">Clinical Staging is a method that determines the stage of rectal cancer based on tumor characteristics and depth of penetration.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426768</data>
</node>
<node id="Staging">
  <data key="d0">Staging</data>
  <data key="d1">method</data>
  <data key="d2">Staging is the process of assigning a clinical stage to rectal cancer to guide treatment planning and prognosis.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426768</data>
</node>
<node id="Treatment Protocol">
  <data key="d0">Treatment Protocol</data>
  <data key="d1">method</data>
  <data key="d2">Treatment protocol is a planned series of therapeutic actions based on cancer stage to treat rectal cancer.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426768</data>
</node>
<node id="High-Fiber Diet">
  <data key="d0">High-Fiber Diet</data>
  <data key="d1">method</data>
  <data key="d2">High-fiber diet is a preventive dietary approach that may lessen risk of colon and rectal cancer.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426768</data>
</node>
<node id="Familial History">
  <data key="d0">Familial History</data>
  <data key="d1">concept</data>
  <data key="d2">Familial history refers to a family’s history of colon or rectal cancer that can prompt earlier screening and surveillance.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426769</data>
</node>
<node id="Screening and Surveillance Programs">
  <data key="d0">Screening and Surveillance Programs</data>
  <data key="d1">method</data>
  <data key="d2">Screening and surveillance programs are systematic monitoring strategies for individuals with familial history to detect colon or rectal cancer early.</data>
  <data key="d3">chunk-1ccba52c964c301daf559927d7d7c5e0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426769</data>
</node>
<node id="Radical Neck Dissection">
  <data key="d0">Radical Neck Dissection</data>
  <data key="d1">method</data>
  <data key="d2">Radical neck dissection is a surgical operation used to remove cancerous tissue, lymph nodes, and other structures in the head and neck, representing the most extensive type of neck dissection.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426813</data>
</node>
<node id="Custom Medical Stock Photo, Inc.">
  <data key="d0">Custom Medical Stock Photo, Inc.</data>
  <data key="d1">organization</data>
  <data key="d2">Custom Medical Stock Photo, Inc. is the organization credited for the digitized illustration of the human head and chest accompanying the description of radical neck dissection.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426813</data>
</node>
<node id="Barium Swallow">
  <data key="d0">Barium Swallow</data>
  <data key="d1">method</data>
  <data key="d2">Barium swallow is a diagnostic procedure listed as a key term associated with radical neck dissection.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426813</data>
</node>
<node id="Drains">
  <data key="d0">Drains</data>
  <data key="d1">artifact</data>
  <data key="d2">Drains are medical devices inserted under the skin after radical neck dissection to remove accumulated fluid from the neck area.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426813</data>
</node>
<node id="Illustration of Human Head and Chest">
  <data key="d0">Illustration of Human Head and Chest</data>
  <data key="d1">artifact</data>
  <data key="d2">The digitized illustration of the human head and chest showing nasal passages, sinuses, trachea, vascular nerves, ribs, and parts of the lungs is credited to Custom Medical Stock Photo, Inc.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426813</data>
</node>
<node id="Head and Neck">
  <data key="d0">Head and Neck</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Head and neck refer to the anatomical region where radical neck dissection is performed and where cancers often spread.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426814</data>
</node>
<node id="Malignant">
  <data key="d0">Malignant</data>
  <data key="d1">concept</data>
  <data key="d2">Malignant describes tissue that is cancerous or likely to become cancerous, a characteristic of the lymph nodes targeted in radical neck dissection.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426814</data>
</node>
<node id="Metastasize">
  <data key="d0">Metastasize</data>
  <data key="d1">concept</data>
  <data key="d2">Metastasize refers to the process by which cancer spreads from its original site to other parts of the body, such as lymph nodes.</data>
  <data key="d3">chunk-b8ffed90e8805478f1786896b19a574a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426814</data>
</node>
<node id="Radioactive Implants">
  <data key="d0">Radioactive Implants</data>
  <data key="d1">artifact</data>
  <data key="d2">Radioactive implants are devices placed directly within cancerous tissue or tumors to deliver radiation intended to kill cancerous cells.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="Internal Radiation Therapy">
  <data key="d0">Internal Radiation Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Internal radiation therapy places sources of radiation directly into the tumor and surrounding tissue as a form of brachytherapy.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="Brachytherapy">
  <data key="d0">Brachytherapy</data>
  <data key="d1">method</data>
  <data key="d2">Brachytherapy is another term for internal radiation therapy, a form of internal radiation treatment.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="Intracavitary Radiation">
  <data key="d0">Intracavitary Radiation</data>
  <data key="d1">method</data>
  <data key="d2">Intracavitary radiation is a type of brachytherapy where the radioactive source is placed in a body cavity.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="Interstitial Radiation">
  <data key="d0">Interstitial Radiation</data>
  <data key="d1">method</data>
  <data key="d2">Interstitial radiation is a type of brachytherapy involving placement of radioactive material into or near cancerous tissue but not in a body cavity.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="External Radiation Therapy">
  <data key="d0">External Radiation Therapy</data>
  <data key="d1">method</data>
  <data key="d2">External radiation therapy is a radiation treatment applied from outside the body, which can be combined with radioactive implants.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="Gold Seeds">
  <data key="d0">Gold Seeds</data>
  <data key="d1">artifact</data>
  <data key="d2">Gold seeds are permanent radioactive implants, small seeds about the size of a grain, placed directly into an organ as a form of brachytherapy.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="Applicator">
  <data key="d0">Applicator</data>
  <data key="d1">artifact</data>
  <data key="d2">An applicator is a device used to place radioactive implants, which may remain in place and cause discomfort.</data>
  <data key="d3">chunk-fced0eb999ac47a6953e79fd6a6ae9fc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426818</data>
</node>
<node id="Heartbeat Irregularities">
  <data key="d0">Heartbeat Irregularities</data>
  <data key="d1">concept</data>
  <data key="d2">Heartbeat irregularities are symptoms that may occur alongside rashes in severe systemic reactions.</data>
  <data key="d3">chunk-27addf854956380fbaa2c0b20a96027b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426862</data>
</node>
<node id="Breathing Problems">
  <data key="d0">Breathing Problems</data>
  <data key="d1">concept</data>
  <data key="d2">Breathing problems are symptoms that may occur alongside rashes in severe systemic reactions.</data>
  <data key="d3">chunk-27addf854956380fbaa2c0b20a96027b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426862</data>
</node>
<node id="Cloth Diapers">
  <data key="d0">Cloth Diapers</data>
  <data key="d1">artifact</data>
  <data key="d2">Cloth diapers are reusable diapers whose use can help prevent diaper rash by keeping the area clean and dry.</data>
  <data key="d3">chunk-27addf854956380fbaa2c0b20a96027b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426862</data>
</node>
<node id="Rape Crisis Hotline">
  <data key="d0">Rape Crisis Hotline</data>
  <data key="d1">organization</data>
  <data key="d2">A rape crisis hotline is a service recommended for victims to obtain immediate assistance, counseling, and resources after experiencing sexual assault.</data>
  <data key="d3">chunk-760e83c8bef86a017e4d71a5d90ebc93</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426863</data>
</node>
<node id="Multidisciplinary Team">
  <data key="d0">Multidisciplinary Team</data>
  <data key="d1">organization</data>
  <data key="d2">A multidisciplinary team is formed after a sexual assault report to address victims' physical, psychological, and judicial needs, comprising various professionals.</data>
  <data key="d3">chunk-760e83c8bef86a017e4d71a5d90ebc93</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426863</data>
</node>
<node id="Law Enforcement Officers">
  <data key="d0">Law Enforcement Officers</data>
  <data key="d1">organization</data>
  <data key="d2">Law enforcement officers are members of the multidisciplinary team who assist in handling sexual assault cases.</data>
  <data key="d3">chunk-760e83c8bef86a017e4d71a5d90ebc93</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426863</data>
</node>
<node id="Physicians">
  <data key="d0">Physicians</data>
  <data key="d1">organization</data>
  <data key="d2">Physicians are medical doctors included in the multidisciplinary team to provide clinical care to sexual assault victims.</data>
  <data key="d3">chunk-760e83c8bef86a017e4d71a5d90ebc93</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426863</data>
</node>
<node id="Nurses">
  <data key="d0">Nurses</data>
  <data key="d1">organization</data>
  <data key="d2">Nurses are healthcare professionals in the multidisciplinary team who treat sexual assault victims.</data>
  <data key="d3">chunk-760e83c8bef86a017e4d71a5d90ebc93</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426863</data>
</node>
<node id="Breast Feeding">
  <data key="d0">Breast Feeding</data>
  <data key="d1">method</data>
  <data key="d2">Breast feeding is a method that can help prevent diaper rash by providing nutrition and reducing irritation.</data>
  <data key="d3">chunk-27addf854956380fbaa2c0b20a96027b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426863</data>
</node>
<node id="Blistering">
  <data key="d0">Blistering</data>
  <data key="d3">chunk-27addf854956380fbaa2c0b20a96027b</data>
  <data key="d2">Rashes can be described as blistering, a type characterized by raised fluid collections beneath the skin.</data>
