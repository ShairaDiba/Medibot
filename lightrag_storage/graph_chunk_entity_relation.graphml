  <data key="d2">An anal fissure is a tear in the lining of the anus that is usually caused by a hard bowel movement.&lt;SEP&gt;An anal fissure is a tear in the lining of the anus that is usually caused by a hard bowel movement.</data>
  <data key="d3">chunk-7cf07655a8780ee831372742398affa8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786383964</data>
</node>
<node id="Anorexia Nervosa">
  <data key="d0">Anorexia Nervosa</data>
  <data key="d1">concept</data>
  <data key="d2">Anorexia nervosa is a distorted self-image that fuels a refusal to admit to being underweight, even when this is demonstrably true.&lt;SEP&gt;Anorexia nervosa is a distorted self-image that fuels a refusal to admit to being underweight, even when this is demonstrably true.</data>
  <data key="d3">chunk-7cf07655a8780ee831372742398affa8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786383964</data>
</node>
<node id="Anoscope">
  <data key="d0">Anoscope</data>
  <data key="d1">artifact</data>
  <data key="d2">An anoscope is a short instrument that allows the physician to view the inside of the anus.&lt;SEP&gt;An anoscope is a short instrument that allows the physician to view the inside of the anus.</data>
  <data key="d3">chunk-7cf07655a8780ee831372742398affa8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786383964</data>
</node>
<node id="Proctoscope">
  <data key="d0">Proctoscope</data>
  <data key="d1">artifact</data>
  <data key="d2">A proctoscope is a longer, rigid viewing tube of approximately six to ten inches in length, which may be used to look for anorectal disorders.&lt;SEP&gt;A proctoscope is a longer, rigid viewing tube of approximately six to ten inches in length, which may be used to look for anorectal disorders.</data>
  <data key="d3">chunk-7cf07655a8780ee831372742398affa8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786383964</data>
</node>
<node id="Sigmoidoscope">
  <data key="d0">Sigmoidoscope</data>
  <data key="d1">artifact</data>
  <data key="d2">A sigmoidoscope is a longer, flexible tube that allows the physician to view up to about two feet of the inside of the large intestine.&lt;SEP&gt;A sigmoidoscope is a longer, flexible tube that allows the physician to view up to about two feet of the inside of the large intestine.</data>
  <data key="d3">chunk-7cf07655a8780ee831372742398affa8</data>
  <data key="d4">unknown_source</data>
