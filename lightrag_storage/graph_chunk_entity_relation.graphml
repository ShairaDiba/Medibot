<node id="Airborne Substances">
  <data key="d0">Airborne Substances</data>
  <data key="d1">concept</data>
  <data key="d2">Airborne substances are particles such as dander, dust, or pollen that can trigger allergic rhinitis.</data>
  <data key="d3">chunk-60186ecba821e292a6f92302d8c6ca5e</data>
