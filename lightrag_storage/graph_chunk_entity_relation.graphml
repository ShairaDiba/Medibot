  <data key="d3">chunk-25a42943ad0f93e6631565dc2c851d36</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786401778</data>
</node>
<node id="Muscle">
  <data key="d0">Muscle</data>
  <data key="d1">naturalobject</data>
  <data key="d2">tissue where glycogen is stored, sites showing symptoms in GSD.&lt;SEP&gt;Muscle tissue utilizes the majority of glucose with insulin assistance and its activity influences insulin effectiveness.</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9&lt;SEP&gt;chunk-25a42943ad0f93e6631565dc2c851d36</data>
