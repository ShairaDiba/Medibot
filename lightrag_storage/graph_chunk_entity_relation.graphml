  <data key="d4">unknown_source</data>
  <data key="d5">1786377289</data>
</node>
<node id="Joints">
  <data key="d0">Joints</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Joints may become tender and are affected in Allergic Purpura.&lt;SEP&gt;Joints are bodily structures where uric acid crystals can accumulate, causing inflammation in gout.</data>
