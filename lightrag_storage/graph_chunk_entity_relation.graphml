  <data key="d4">unknown_source</data>
  <data key="d5">1786420674</data>
</node>
<node id="Specific Phobia">
  <data key="d0">Specific Phobia</data>
  <data key="d1">concept</data>
  <data key="d2">Specific Phobia refers to a phobia of a particular object or situation, such as fear of snakes, which may be easy to avoid.</data>
