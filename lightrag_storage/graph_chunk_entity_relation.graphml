  <data key="d2">Obstructions are blockages in the liver or bile ducts that impede bile flow.</data>
  <data key="d3">chunk-6c5e751c6db20a49f7ca0a341eadc654</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419483</data>
