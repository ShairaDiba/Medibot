  <data key="d0">Endothelial</data>
  <data key="d1">concept</data>
  <data key="d2">Endothelial refers to cells lining blood vessels, mentioned as a key term associated with antiangiogenic therapy.</data>
  <data key="d3">chunk-43384133dfe3fd1b2a03d01d15878f94</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786384653</data>
