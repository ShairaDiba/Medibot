  <data key="d1">artifact</data>
  <data key="d2">Certain heart medication can contribute to hypothyroidism.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410681</data>
</node>
