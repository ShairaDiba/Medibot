  <data key="d5">1786388402</data>
</node>
<node id="Five Minutes">
  <data key="d0">Five Minutes</data>
  <data key="d3">chunk-af3262684a537f83a047b77ed5ae0b70</data>
  <data key="d2">Apgar Testing is performed again at five minutes after birth.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388403</data>
</node>
<node id="Aortic Valve Insufficiency">
  <data key="d0">Aortic Valve Insufficiency</data>
  <data key="d1">concept</data>
  <data key="d2">Aortic valve insufficiency is a disease where the aortic valve cannot close properly, leading to backflow of blood from the aorta into the left ventricle.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388560</data>
</node>
<node id="Left Ventricle">
  <data key="d0">Left Ventricle</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The left ventricle is the heart chamber that pumps blood into the aorta.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388560</data>
</node>
<node id="Birth Defect">
  <data key="d0">Birth Defect</data>
  <data key="d1">concept</data>
  <data key="d2">A birth defect is a congenital abnormality present at birth that can affect the structure or function of the aortic valve.&lt;SEP&gt;A birth defect is a structural or functional abnormality present at birth, referenced as a possible increased risk for IVF-conceived babies.</data>
  <data key="d3">chunk-929ba0da65b01f36a714e919c35cad8f&lt;SEP&gt;chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411607</data>
</node>
<node id="Rheumatic Fever">
  <data key="d0">Rheumatic Fever</data>
  <data key="d1">concept</data>
  <data key="d2">Rheumatic fever is an inflammatory disease caused by infection with Group A Streptococcus that can damage heart valves.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388561</data>
</node>
<node id="Group A Streptococcus">
  <data key="d0">Group A Streptococcus</data>
  <data key="d1">creature</data>
  <data key="d2">Group A Streptococcus is a bacterium that causes strep throat and can lead to rheumatic fever.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388561</data>
</node>
<node id="Syphilis">
  <data key="d0">Syphilis</data>
  <data key="d1">concept</data>
  <data key="d2">Syphilis is a sexually transmitted bacterial infection that can rarely affect the aortic valve.&lt;SEP&gt;Syphilis is an infection of the central nervous system that can cause hydrocephalus.&lt;SEP&gt;infection to be distinguished from cancerous cells.&lt;SEP&gt;Syphilis is a sexually transmitted disease listed as a cause of Proctitis.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530&lt;SEP&gt;chunk-414a580eb00a7d0d58696314c2aa7dfe&lt;SEP&gt;chunk-2c9e6467acd0c81d0621428aab938849&lt;SEP&gt;chunk-dad561d3742857b36b06aba05376ddc3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424475</data>
</node>
<node id="Chest X-ray">
  <data key="d0">Chest X-ray</data>
  <data key="d1">method</data>
  <data key="d2">Chest X-ray is an imaging technique used to visualize the size of the aorta and detect enlargement in patients with aortic valve insufficiency.&lt;SEP&gt;Chest X-ray is an imaging test that visualizes the chest structures, employed in diagnosing heart failure.&lt;SEP&gt;A chest X‑ray is a diagnostic imaging tool that often first reveals abnormalities leading to Hodgkin’s lymphoma diagnosis.&lt;SEP&gt;Chest X-ray is an imaging method used to detect pleural effusion and assess heart size.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530&lt;SEP&gt;chunk-448825a5baf21347c5a8fd84c362669b&lt;SEP&gt;chunk-910d4bcf6932bd29fd1d161e11852b46&lt;SEP&gt;chunk-d88b3e0c879cd2c524008f697f6859f7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422150</data>
</node>
<node id="Electrocardiogram">
  <data key="d0">Electrocardiogram</data>
  <data key="d1">method</data>
  <data key="d2">Electrocardiogram (ECG) records the electrical activity of the heart and aids in diagnosing aortic valve insufficiency.&lt;SEP&gt;Electrocardiogram (EKG/ECG) is a diagnostic method that records electrical impulses from the heart to detect abnormalities.&lt;SEP&gt;A test that records electrical activity of the heart, typically abnormal in hypertrophic cardiomyopathy.&lt;SEP&gt;Electrocardiogram is a diagnostic test used to detect heart rhythm abnormalities associated with hypokalemia.</data>
  <data key="d3">chunk-f8a0239df88721094e3c51f8a7373134&lt;SEP&gt;chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a&lt;SEP&gt;chunk-e534c2f61dae08dd6e4ae98c00c82c7d&lt;SEP&gt;chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410760</data>
</node>
<node id="Surgical Valve Replacement">
  <data key="d0">Surgical Valve Replacement</data>
  <data key="d1">method</data>
  <data key="d2">Surgical valve replacement is an operation that replaces a defective aortic valve to correct aortic insufficiency.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388561</data>
</node>
<node id="Aortic Valve Stenosis">
  <data key="d0">Aortic Valve Stenosis</data>
  <data key="d3">chunk-95473e1839ed2cb5361d36e7da2217bd</data>
  <data key="d2">Aortic Valve Stenosis causes narrowing of the aortic valve, reducing its normal opening size.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388562</data>
</node>
<node id="Positive Inotropic Drugs">
  <data key="d0">Positive Inotropic Drugs</data>
  <data key="d1">concept</data>
  <data key="d2">Positive inotropic drugs increase the strength of heart contractions and are used to treat aortic valve insufficiency.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388562</data>
</node>
<node id="Dietary Salt Reduction">
  <data key="d0">Dietary Salt Reduction</data>
  <data key="d1">method</data>
  <data key="d2">Dietary salt reduction lowers fluid retention, helping the heart work more efficiently in aortic valve insufficiency.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388562</data>
</node>
<node id="Reduced Pulse">
  <data key="d0">Reduced Pulse</data>
  <data key="d1">concept</data>
  <data key="d2">Reduced or absent pulse in the extremities is a clinical sign observed in patients with aortic valve insufficiency.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388562</data>
</node>
<node id="Murmur">
  <data key="d0">Murmur</data>
  <data key="d1">concept</data>
  <data key="d2">A heart murmur may be heard during auscultation when the aortic dissection is close to the heart in aortic valve insufficiency cases.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388562</data>
</node>
<node id="Enlarged Aorta">
  <data key="d0">Enlarged Aorta</data>
  <data key="d1">concept</data>
  <data key="d2">An enlarged aorta visible on imaging studies is a common finding in aortic valve insufficiency.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388563</data>
</node>
<node id="Aortic Dissection">
  <data key="d0">Aortic Dissection</data>
  <data key="d1">concept</data>
  <data key="d2">Aortic dissection is a tear in the aortic wall that causes severe tearing pain and can be confused with symptoms of aortic valve insufficiency.</data>
  <data key="d3">chunk-83aebc72b8b7f7141e25e88c35f39530</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388563</data>
</node>
<node id="Calcium Deposits">
  <data key="d0">Calcium Deposits</data>
  <data key="d3">chunk-95473e1839ed2cb5361d36e7da2217bd</data>
  <data key="d2">Calcium deposits may form on the aortic valve and contribute to the development of stenosis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388563</data>
</node>
<node id="Echocardiogram">
  <data key="d0">Echocardiogram</data>
  <data key="d3">chunk-95473e1839ed2cb5361d36e7da2217bd&lt;SEP&gt;chunk-d99d14117824aa2b5637825772676446</data>
  <data key="d2">An echocardiogram is employed to assess the heart’s structure and function in the context of aortic valve stenosis.&lt;SEP&gt;Echocardiogram is an imaging method listed as a key term and utilized for evaluating cardiac structure and function in the context of Heart Transplantation.</data>
  <data key="d1">method</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404042</data>
</node>
<node id="Balloon Catheter">
  <data key="d0">Balloon Catheter</data>
  <data key="d3">chunk-95473e1839ed2cb5361d36e7da2217bd</data>
  <data key="d2">A balloon catheter can be inserted through the arteries to inflate at the valve, widening the narrowed opening without surgery.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388565</data>
</node>
<node id="Mechanical Valve">
  <data key="d0">Mechanical Valve</data>
  <data key="d3">chunk-95473e1839ed2cb5361d36e7da2217bd</data>
  <data key="d2">A mechanical valve may replace the diseased aortic valve during open‑heart surgery for severe stenosis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388566</data>
</node>
<node id="Pig Valve">
  <data key="d0">Pig Valve</data>
  <data key="d3">chunk-95473e1839ed2cb5361d36e7da2217bd</data>
  <data key="d2">A pig valve can be used as a prosthetic to replace the aortic valve in severe cases.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388568</data>
</node>
<node id="Pulmonary Valve">
  <data key="d0">Pulmonary Valve</data>
  <data key="d3">chunk-95473e1839ed2cb5361d36e7da2217bd</data>
  <data key="d2">The pulmonary valve can be moved into the aortic position to replace the narrowed aortic valve.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388570</data>
</node>
<node id="Cardiac Catheterization">
  <data key="d0">Cardiac Catheterization</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46&lt;SEP&gt;chunk-95473e1839ed2cb5361d36e7da2217bd&lt;SEP&gt;chunk-f67802df86489f08c4cf899e4cdd599e</data>
  <data key="d2">Cardiac catheterization involves inserting a balloon catheter to the aortic valve to widen it as a therapeutic procedure.&lt;SEP&gt;Cardiac Catheterization is an invasive diagnostic procedure that examines heart function and coronary arteries, used in assessing heart failure.&lt;SEP&gt;Cardiac Catheterization is a diagnostic method listed as a key term related to heart valve procedures.</data>
  <data key="d1">method</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404586</data>
</node>
<node id="Aplastic Anemia">
  <data key="d0">Aplastic Anemia</data>
  <data key="d1">concept</data>
  <data key="d2">Aplastic anemia is a disorder in which the bone marrow significantly decreases or stops production of blood cells, leading to a life‑threatening condition.</data>
  <data key="d3">chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388717</data>
</node>
<node id="Bone Marrow">
  <data key="d0">Bone Marrow</data>
  <data key="d1">location</data>
  <data key="d2">Bone marrow is the soft tissue inside the hard outer shell of bones that produces all types of blood cells.&lt;SEP&gt;Bone Marrow is a tissue rich in immune cells and can cause graft-versus-host disease when transplanted.&lt;SEP&gt;Bone marrow is a primary site of blood cell production and part of the lymphatic/immune system.&lt;SEP&gt;Soft spongy center part of bone that makes blood cells.&lt;SEP&gt;Bone Marrow is the tissue where platelets are produced.</data>
  <data key="d3">chunk-ebc37c967098587c747ad0f9bafa5164&lt;SEP&gt;chunk-7cfde0612413cfdb92dc133bd235f120&lt;SEP&gt;chunk-c07ccd2ac226d52ffc3c4068cddb090e&lt;SEP&gt;chunk-d88b3e0c879cd2c524008f697f6859f7&lt;SEP&gt;chunk-07cc217c989e2af1a805d2ee5017b0b3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421631</data>
</node>
<node id="Platelets">
  <data key="d0">Platelets</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Platelets are mature blood components involved in clotting.&lt;SEP&gt;Platelets are small disk-shaped blood cells (thrombocytes) produced in the bone marrow and involved in blood clotting.</data>
  <data key="d3">chunk-c07ccd2ac226d52ffc3c4068cddb090e&lt;SEP&gt;chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421631</data>
</node>
<node id="Hematopoietic Cells">
  <data key="d0">Hematopoietic Cells</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Hematopoietic cells are the cells in bone marrow responsible for generating all blood cell lineages.</data>
  <data key="d3">chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388717</data>
</node>
<node id="Autoimmune Disease">
  <data key="d0">Autoimmune Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Autoimmune disease refers to a condition in which the immune system mistakenly attacks the body’s own tissues.&lt;SEP&gt;Autoimmune Disease is a disease category where the immune system attacks the body’s own tissues, suspected in Polymyositis and Dermatomyositis.</data>
  <data key="d3">chunk-346dbc5b46cc5130f0b88acb5bdd6aca&lt;SEP&gt;chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422475</data>
</node>
<node id="Bone Marrow Transplantation">
  <data key="d0">Bone Marrow Transplantation</data>
  <data key="d1">method</data>
  <data key="d2">Bone marrow transplantation is a medical procedure that replaces diseased marrow with healthy donor marrow and is the most successful treatment for aplastic anemia.&lt;SEP&gt;Bone Marrow Transplantation is a therapeutic procedure that can cause graft-versus-host disease but also treats acute leukemia.&lt;SEP&gt;Transplant procedure used in selected sickle cell anemia patients.&lt;SEP&gt;Bone marrow transplantation is a medical procedure that can cure some cases of immunodeficiency by replacing defective immune cells.</data>
  <data key="d3">chunk-07cc217c989e2af1a805d2ee5017b0b3&lt;SEP&gt;chunk-19e4810245f812dff5d4b92e29c6f847&lt;SEP&gt;chunk-7cfde0612413cfdb92dc133bd235f120&lt;SEP&gt;chunk-e9348993468d1735d7ee70858031d433</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411546</data>
</node>
<node id="Immunosuppressive Therapy">
  <data key="d0">Immunosuppressive Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Immunosuppressive therapy is a treatment approach that reduces immune system activity, often used in managing aplastic anemia.</data>
  <data key="d3">chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388718</data>
</node>
<node id="Environmental Toxins">
  <data key="d0">Environmental Toxins</data>
  <data key="d1">concept</data>
  <data key="d2">Environmental toxins are harmful substances in the environment that can contribute to the development of acquired aplastic anemia.</data>
  <data key="d3">chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388718</data>
</node>
<node id="HLA‑Matched Sibling Donor">
  <data key="d0">HLA‑Matched Sibling Donor</data>
  <data key="d1">person</data>
  <data key="d2">An HLA‑matched sibling donor is a genetically compatible family member who can provide bone marrow for transplantation.</data>
  <data key="d3">chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388718</data>
</node>
<node id="Blood Transfusion">
  <data key="d0">Blood Transfusion</data>
  <data key="d1">method</data>
  <data key="d2">Blood transfusion is a temporary medical intervention that supplies blood cells to patients but does not address the underlying marrow failure.&lt;SEP&gt;Blood Transfusion is a medical procedure that can lead to graft-versus-host disease when donor immune cells are present.&lt;SEP&gt;Blood transfusion is a supportive treatment that may be required for patients with Hemolytic-Uremic Syndrome.&lt;SEP&gt;Transfer of blood used to treat sickle cell anemia and thalassemias.</data>
  <data key="d3">chunk-19e4810245f812dff5d4b92e29c6f847&lt;SEP&gt;chunk-07cc217c989e2af1a805d2ee5017b0b3&lt;SEP&gt;chunk-434d8d551fe8baa35b0eb7738c2dec25&lt;SEP&gt;chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405021</data>
</node>
<node id="Idiopathic Aplastic Anemia">
  <data key="d0">Idiopathic Aplastic Anemia</data>
  <data key="d1">concept</data>
  <data key="d2">Idiopathic aplastic anemia describes cases where the cause of the disorder is unknown.</data>
  <data key="d3">chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388718</data>
</node>
<node id="Acquired Aplastic Anemia">
  <data key="d0">Acquired Aplastic Anemia</data>
  <data key="d1">concept</data>
  <data key="d2">Acquired aplastic anemia refers to cases linked to environmental factors or physical conditions.</data>
  <data key="d3">chunk-7cfde0612413cfdb92dc133bd235f120</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388718</data>
</node>
<node id="Arterial Embolism">
  <data key="d0">Arterial Embolism</data>
  <data key="d1">concept</data>
  <data key="d2">Arterial embolism is a critical condition where an embolus blocks an artery, depriving downstream tissues of blood and oxygen.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388824</data>
</node>
<node id="Embolus">
  <data key="d0">Embolus</data>
  <data key="d1">concept</data>
  <data key="d2">An embolus is a blood clot, tissue fragment, tumor, gas bubble, or other foreign body that travels in the bloodstream and can become lodged in a blood vessel.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388824</data>
</node>
<node id="Thrombosis">
  <data key="d0">Thrombosis</data>
  <data key="d1">concept</data>
  <data key="d2">Thrombosis is the formation of a blood clot that remains in place within an artery.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388824</data>
</node>
<node id="Fat Cells">
  <data key="d0">Fat Cells</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Fat cells are lipid cells that can enter the bloodstream and form emboli, especially after a major bone fracture.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388824</data>
</node>
<node id="Air Bubble">
  <data key="d0">Air Bubble</data>
  <data key="d1">naturalobject</data>
  <data key="d2">An air bubble is a gas bubble that can travel in the bloodstream and become an embolus.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388824</data>
</node>
<node id="Atrial Fibrillation">
  <data key="d0">Atrial Fibrillation</data>
  <data key="d1">concept</data>
  <data key="d2">Atrial fibrillation is an abnormal heart rhythm that can cause blood clots to form, leading to emboli.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388824</data>
</node>
<node id="Heart Attack">
  <data key="d0">Heart Attack</data>
  <data key="d1">concept</data>
  <data key="d2">Heart attack is damage to the heart that can result in clot formation, contributing to emboli.&lt;SEP&gt;Heart Attack is cardiac muscle damage caused by complete blockage of blood flow, listed as a common cause of heart failure and sometimes silent.&lt;SEP&gt;Heart attack is listed as one of the primary conditions comprising heart disease.&lt;SEP&gt;Heart Attack is a critical cardiovascular condition in which heart muscle is damaged or dies due to severely restricted or blocked blood flow.&lt;SEP&gt;Heart attack is a medical event that can lead to the diagnosis of hypercholesterolemia.&lt;SEP&gt;Heart attack is a condition after which therapy is monitored using pulmonary artery catheterization.</data>
  <data key="d3">chunk-5f36c10fba48ed73bf1306763cd71ea5&lt;SEP&gt;chunk-3cd4e9159e066f72729a8b0e6c804cc7&lt;SEP&gt;chunk-895c5e07d9ff1dcdf835a5d197d6cf8c&lt;SEP&gt;chunk-910d4bcf6932bd29fd1d161e11852b46&lt;SEP&gt;chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a&lt;SEP&gt;chunk-3b7e1ff6aefba50b9ab4cb48e8298cf0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425802</data>
</node>
<node id="Noninvasive Vascular Tests">
  <data key="d0">Noninvasive Vascular Tests</data>
  <data key="d1">method</data>
  <data key="d2">Noninvasive vascular tests are diagnostic procedures that measure blood pressure in various locations to assess vascular health.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388825</data>
</node>
<node id="Catheter">
  <data key="d0">Catheter</data>
  <data key="d1">artifact</data>
  <data key="d2">A catheter is a tube used to deliver medication directly into the affected artery.&lt;SEP&gt;A catheter is a medical device inserted before the patient goes to the operating room for a craniotomy.&lt;SEP&gt;device used to relieve obstruction, possibly placed through a restricting prostate.&lt;SEP&gt;Catheter is a thin tube inserted into the uterus through the cervix during hysterosalpingography.&lt;SEP&gt;Catheter is a tubular device used in thoracentesis to facilitate continuous drainage of pleural fluid.&lt;SEP&gt;Catheter is a medical device listed as a key term used in radiology procedures.</data>
  <data key="d3">chunk-448825a5baf21347c5a8fd84c362669b&lt;SEP&gt;chunk-edba93ae4e0e61889c3b13cfe47b1b13&lt;SEP&gt;chunk-6c190f7502921527346a5beaed7b2382&lt;SEP&gt;chunk-2a51c332fdfaf8c96be6ab58c809b221&lt;SEP&gt;chunk-f9caaa60cd1726424ba3202fd3c2999a&lt;SEP&gt;chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426705</data>
</node>
<node id="AV Fistula">
  <data key="d0">AV Fistula</data>
  <data key="d1">concept</data>
  <data key="d2">An arteriovenous fistula is a surgically created connection between an artery and a vein used for hemodialysis access.&lt;SEP&gt;AV Fistula is the abbreviated form of arteriovenous fistula mentioned in the definition.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a&lt;SEP&gt;chunk-eb0c87449453ea18bab3c29a7f3c380f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389069</data>
</node>
<node id="Hemodialysis">
  <data key="d0">Hemodialysis</data>
  <data key="d1">method</data>
  <data key="d2">Hemodialysis is a method of mechanically cleansing the blood when the kidneys have failed.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388825</data>
</node>
<node id="Bone Fracture">
  <data key="d0">Bone Fracture</data>
  <data key="d1">event</data>
  <data key="d2">A bone fracture is a break in a bone that can release fat cells into the bloodstream, potentially forming emboli.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388825</data>
</node>
<node id="Cancer Cells">
  <data key="d0">Cancer Cells</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cancer cells are malignant cells that can enter the bloodstream and form emboli.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388825</data>
</node>
<node id="Gas Bubbles">
  <data key="d0">Gas Bubbles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gas bubbles are small gas pockets that can travel in the bloodstream and become emboli.</data>
  <data key="d3">chunk-d89b7b5832dd7ae55e8a5dd5f4a4a94a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388825</data>
</node>
<node id="Surgical Creation">
  <data key="d0">Surgical Creation</data>
  <data key="d1">method</data>
  <data key="d2">Surgical creation refers to the procedure of forming an arteriovenous fistula by connecting a vein and an artery, typically performed in the forearm.</data>
  <data key="d3">chunk-eb0c87449453ea18bab3c29a7f3c380f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389069</data>
</node>
<node id="Forearm">
  <data key="d0">Forearm</data>
  <data key="d1">location</data>
  <data key="d2">Fore</data>
  <data key="d3">chunk-eb0c87449453ea18bab3c29a7f3c380f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389069</data>
</node>
<node id="Family Education">
  <data key="d0">Family Education</data>
  <data key="d1">method</data>
  <data key="d2">Family education is an important component of apraxia treatment; it involves relatives offering encouragement, supporting in‑home exercises, and sometimes acting as caregivers.</data>
  <data key="d3">chunk-c3d1367f180f5cdbc9f3386cadd299a8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389129</data>
</node>
<node id="Caregiver">
  <data key="d0">Caregiver</data>
  <data key="d1">person</data>
  <data key="d2">A caregiver is a family member who may take on responsibility for assisting a person with apraxia in daily activities and exercises.</data>
  <data key="d3">chunk-c3d1367f180f5cdbc9f3386cadd299a8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389129</data>
</node>
<node id="Apraxia">
  <data key="d0">Apraxia</data>
  <data key="d3">chunk-c3d1367f180f5cdbc9f3386cadd299a8</data>
  <data key="d2">Damage to the brain can cause Apraxia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389131</data>
</node>
<node id="Cerebral Hemispheres">
  <data key="d0">Cerebral Hemispheres</data>
  <data key="d3">chunk-c3d1367f180f5cdbc9f3386cadd299a8</data>
  <data key="d2">Damage to the cerebral hemispheres can result in Apraxia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389132</data>
</node>
<node id="Apraxia of Speech">
  <data key="d0">Apraxia of Speech</data>
  <data key="d3">chunk-c3d1367f180f5cdbc9f3386cadd299a8</data>
  <data key="d2">Apraxia of</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389135</data>
</node>
<node id="Vein">
  <data key="d0">Vein</data>
  <data key="d1">location</data>
  <data key="d2">Arteriovenous Malformation consists of tangled veins as part of its structure.&lt;SEP&gt;Vein is a blood vessel used for intravenous administration of antibiotics and fluids in peritonitis treatment.&lt;SEP&gt;A vein is a blood vessel commonly accessed for phlebotomy, often on the hand or elbow.&lt;SEP&gt;Vein is a blood vessel from which blood is drawn for a more accurate platelet count.</data>
  <data key="d3">chunk-d89439564ae2dc33beae4237976b40b1&lt;SEP&gt;chunk-f45f05d7c26e4d3fdd9cc182e8964493&lt;SEP&gt;chunk-2a3ecc34ed1c5383ab2125e8cf323393&lt;SEP&gt;chunk-c07ccd2ac226d52ffc3c4068cddb090e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421631</data>
</node>
<node id="Capillary">
  <data key="d0">Capillary</data>
  <data key="d1">absence</data>
  <data key="d2">Arteriovenous Malformation lacks a normal capillary bed between arteries and veins.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389252</data>
</node>
<node id="Prenatal Development">
  <data key="d0">Prenatal Development</data>
  <data key="d1">occurrence</data>
  <data key="d2">Arteriovenous Malformation develops before birth during prenatal development.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389252</data>
</node>
<node id="Hemorrhage">
  <data key="d0">Hemorrhage</data>
  <data key="d1">concept</data>
  <data key="d2">Arteriovenous Malformation may hemorrhage, causing bleeding.&lt;SEP&gt;Hemorrhage is a possible complication, including intestinal bleeding, during the toxic stage of paratyphoid fever.</data>
  <data key="d3">chunk-a0e819bfc5f44172772a558ea9a8d451&lt;SEP&gt;chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786418799</data>
</node>
<node id="Severe Headache">
  <data key="d0">Severe Headache</data>
  <data key="d1">symptom,cause</data>
  <data key="d2">Hemorrhage from an AVM produces a sudden, severe headache.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389252</data>
</node>
<node id="Stiff Neck">
  <data key="d0">Stiff Neck</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage can cause a stiff neck.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Sleepiness">
  <data key="d0">Sleepiness</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage can cause sleepiness.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Lethargy">
  <data key="d0">Lethargy</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage can cause lethargy.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Irritability">
  <data key="d0">Irritability</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage can cause irritability.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Weakness">
  <data key="d0">Weakness</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage can cause weakness anywhere in the body.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Seizure">
  <data key="d0">Seizure</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage can lead to seizures in about a quarter of cases.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Vision Impairment">
  <data key="d0">Vision Impairment</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage may cause decreased, double, or blurred vision.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Facial Paralysis">
  <data key="d0">Facial Paralysis</data>
  <data key="d1">symptom</data>
  <data key="d2">Hemorrhage may cause facial paralysis.</data>
  <data key="d3">chunk-f45f05d7c26e4d3fdd9cc182e8964493</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786389253</data>
</node>
<node id="Fainting">
  <data key="d0">Fainting</data>
  <data key="d1">concept</data>
  <data key="d2">Fainting may occur as a symptom when an arteriovenous malformation bleeds.&lt;SEP&gt;Fainting is a temporary loss of consciousness that may occur after a hemoglobin test.</data>
