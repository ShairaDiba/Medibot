  <data key="d0">Gastric Lavage</data>
  <data key="d1">method</data>
  <data key="d2">Gastric Lavage is a technique for washing poison out of the stomach by instilling water or saline and suctioning the contents.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422327</data>
</node>
