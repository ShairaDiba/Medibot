  <data key="d0">Emetic</data>
  <data key="d1">concept</data>
  <data key="d2">An emetic is a substance that induces vomiting to expel ingested poison.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422328</data>
</node>
<node id="Polycystic Ovary Syndrome">
  <data key="d0">Polycystic Ovary Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Polycystic Ovary Syndrome (PCOS) is a disease characterized by ovarian cysts, high androgen levels, chronic anovulation, and metabolic disturbances, affecting about 6% of premenopausal women.</data>
  <data key="d3">chunk-142d840737a92f2ba527c40fc2edcbe2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422404</data>
