<node id="Bicycling">
  <data key="d0">Bicycling</data>
  <data key="d1">method</data>
  <data key="d2">Bicycling is a low‑impact aerobic activity suggested for heart failure patients as part of their exercise regimen.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403746</data>
