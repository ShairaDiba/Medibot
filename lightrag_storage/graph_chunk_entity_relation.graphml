  <data key="d0">Adult</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Adult refers to an adult individual who has lower normal aldolase levels compared to newborns.</data>
  <data key="d3">chunk-919116bb6efe3303887cfaa1a2474f3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377760</data>
</node>
<node id="Allergies">
  <data key="d0">Allergies</data>
  <data key="d1">concept</data>
  <data key="d2">Allergies represent hypersensitive responses of the immune system to otherwise harmless foreign substances (allergens).</data>
  <data key="d3">chunk-fea6119439079b171fb416dd0c1a0f6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377851</data>
</node>
<node id="Lymphocyte">
  <data key="d0">Lymphocyte</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Lymphocytes are immune cells that produce IgE antibodies in allergy sufferers.&lt;SEP&gt;Lymphocytes are a type of white blood cell, broader category that includes B‑lymphocytes and T‑lymphocytes.</data>
  <data key="d3">chunk-59ae7c2e485dd251483e45f48ced8031&lt;SEP&gt;chunk-fea6119439079b171fb416dd0c1a0f6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409382</data>
</node>
