  <data key="d0">Heartland Regional Medical Center</data>
  <data key="d1">organization</data>
  <data key="d2">Heartland Regional Medical Center is a medical facility in St. Joseph, Missouri where Heartland Virus was first identified.</data>
  <data key="d3">chunk-29a876ab478c9008ee3809563b1fa892</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404263</data>
