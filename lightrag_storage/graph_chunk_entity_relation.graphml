  <data key="d2">Blood vessel disease is a condition that raises risk for anaerobic infection.</data>
  <data key="d3">chunk-c1acfa8b3bcf6abb174b1db6c3878690</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786379295</data>
</node>
<node id="Tumors">
  <data key="d0">Tumors</data>
  <data key="d1">concept</data>
  <data key="d2">Tumors are growths that increase risk for anaerobic infection.&lt;SEP&gt;Tumors can cause nasal obstruction or nerve damage leading to anosmia.&lt;SEP&gt;Tumors can cause nasal obstruction or nerve damage leading to anosmia.</data>
  <data key="d3">chunk-c1acfa8b3bcf6abb174b1db6c3878690&lt;SEP&gt;chunk-fb501e7091ee5baf999ac62e451626a7</data>
