  <data key="d0">Anorexia</data>
  <data key="d1">concept</data>
  <data key="d2">Anorexia is a symptom.</data>
  <data key="d3">chunk-79f9159512d902b809ff6ebeca7cf146</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405308</data>
</node>
<node id="White Blood Cell Count">
  <data key="d0">White Blood Cell Count</data>
  <data key="d1">data</data>
  <data key="d2">White blood cell count is a laboratory measurement that typically increases in drug‑induced hepatitis.</data>
  <data key="d3">chunk-79f9159512d902b809ff6ebeca7cf146</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405308</data>
