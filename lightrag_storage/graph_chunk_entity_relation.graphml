  <data key="d3">chunk-588676d8832bc88d23ec31492a9a02db</data>
  <data key="d2">People with pernicious anemia have an increased likelihood of developing autoimmune disorders.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
