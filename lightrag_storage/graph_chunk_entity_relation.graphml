  <data key="d0">Salt Intake Reduction</data>
  <data key="d1">method</data>
  <data key="d2">Salt Intake Reduction is a dietary strategy to lower sodium consumption, helping to reduce swelling associated with heart failure.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403745</data>
</node>
<node id="Walking">
  <data key="d0">Walking</data>
  <data key="d1">method</data>
  <data key="d2">Walking is a low‑impact aerobic activity recommended as part of an exercise program for heart failure patients.</data>
  <data key="d3">chunk-910d4bcf6932bd29fd1d161e11852b46</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403746</data>
