  <data key="d5">1786421098</data>
</node>
<node id="Hospital Stays">
  <data key="d0">Hospital Stays</data>
  <data key="d1">concept</data>
  <data key="d2">Hospital stays refer to the length of postoperative recovery after hysterectomy.</data>
  <data key="d3">chunk-07a9a426a4bb2afd30f9a958bbb935d6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410984</data>
</node>
<node id="Outpatient Basis">
  <data key="d0">Outpatient Basis</data>
  <data key="d1">concept</data>
  <data key="d2">Outpatient basis describes a setting where hysterectomy may be performed with same‑day discharge.</data>
  <data key="d3">chunk-07a9a426a4bb2afd30f9a958bbb935d6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410984</data>
</node>
<node id="Hospital Operating Room">
  <data key="d0">Hospital Operating Room</data>
  <data key="d1">location</data>
  <data key="d2">The hospital operating room is the location where hysterectomies are typically performed.</data>
  <data key="d3">chunk-07a9a426a4bb2afd30f9a958bbb935d6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410984</data>
</node>
<node id="Hysteria">
  <data key="d0">Hysteria</data>
  <data key="d1">concept</data>
  <data key="d2">Hysteria is a disease/condition characterized by physical symptoms with a psychological cause, associated with hysterical disorders and histrionic personality disorder.</data>
  <data key="d3">chunk-011a30caa3696a5321ec2b965fba6473</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411017</data>
</node>
<node id="Hysterical Disorders">
  <data key="d0">Hysterical Disorders</data>
  <data key="d1">concept</data>
  <data key="d2">Hysterical disorders are a group of conditions that include hysteria and histrionic personality disorder, featuring excessive emotions, dramatics, and attention‑seeking behavior.</data>
  <data key="d3">chunk-011a30caa3696a5321ec2b965fba6473</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411017</data>
</node>
<node id="Histrionic Personality Disorder">
  <data key="d0">Histrionic Personality Disorder</data>
  <data key="d1">concept</data>
  <data key="d2">Histrionic Personality Disorder is a personality disorder defined in DSM‑IV, characterized by a need to be the center of attention and inappropriate, sexually seductive or provocative behavior.</data>
  <data key="d3">chunk-011a30caa3696a5321ec2b965fba6473</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411017</data>
</node>
<node id="Jean-Martin Charcot">
  <data key="d0">Jean-Martin Charcot</data>
  <data key="d1">person</data>
  <data key="d2">Jean‑Martin Charcot was a prolific writer and artist (1825–1893) who authored Lectures on the Diseases of the Nervous System.</data>
  <data key="d3">chunk-011a30caa3696a5321ec2b965fba6473</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411017</data>
