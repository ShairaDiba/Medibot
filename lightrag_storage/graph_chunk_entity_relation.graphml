  <data key="d0">Protein–Calorie Malnutrition</data>
  <data key="d1">concept</data>
  <data key="d2">Protein–calorie malnutrition is an alternative name for protein-energy malnutrition.</data>
  <data key="d3">chunk-afbff98c4c1d63870e1df4480f9167fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424859</data>
</node>
<node id="Primary PEM">
  <data key="d0">Primary PEM</data>
  <data key="d1">concept</data>
  <data key="d2">Primary PEM refers to protein-energy malnutrition resulting directly from a diet lacking sufficient protein and calorie sources.</data>
  <data key="d3">chunk-afbff98c4c1d63870e1df4480f9167fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424860</data>
</node>
<node id="Secondary PEM">
  <data key="d0">Secondary PEM</data>
  <data key="d1">concept</data>
  <data key="d2">Secondary PEM refers to protein-energy malnutrition that arises due to underlying illness or inability to absorb nutrients.</data>
  <data key="d3">chunk-afbff98c4c1d63870e1df4480f9167fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424860</data>
</node>
<node id="Tube Feeding">
  <data key="d0">Tube Feeding</data>
  <data key="d1">method</data>
  <data key="d2">Tube feeding is a nutritional delivery method used to provide nutrients to patients unable to eat protein-rich foods.</data>
  <data key="d3">chunk-afbff98c4c1d63870e1df4480f9167fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424861</data>
</node>
<node id="Intravenous Feeding">
  <data key="d0">Intravenous Feeding</data>
  <data key="d1">method</data>
  <data key="d2">Intravenous feeding is a method of supplying nutrients directly into the bloodstream for patients who cannot eat.</data>
