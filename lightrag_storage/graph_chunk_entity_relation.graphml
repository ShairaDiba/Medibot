<node id="Acute Lymphangitis">
  <data key="d0">Acute Lymphangitis</data>
  <data key="d1">concept</data>
  <data key="d2">Acute lymphangitis is a bacterial infection of the lymphatic vessels characterized by painful red streaks and potentially fatal spread to the bloodstream.</data>
  <data key="d3">chunk-bead2f9ad4273b49f336c30d5e85e2f1</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786374570</data>
