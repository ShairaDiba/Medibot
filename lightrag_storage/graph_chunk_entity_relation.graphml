</node>
<node id="Sports Injury">
  <data key="d0">Sports Injury</data>
  <data key="d1">concept</data>
  <data key="d2">Sports injury can cause damage to the tunica albuginea leading to plaque formation in Peyronie's disease.</data>
  <data key="d3">chunk-91b63fc7d102b55c2843666075d6ad7e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420390</data>
</node>
<node id="Fibrosis">
  <data key="d0">Fibrosis</data>
  <data key="d1">concept</data>
  <data key="d2">Fibrosis is excess scar tissue formation that can develop after tunica albuginea injury and lead to inflexible plaques.</data>
  <data key="d3">chunk-91b63fc7d102b55c2843666075d6ad7e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786420390</data>
