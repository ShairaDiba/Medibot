  <data key="d0">Necrosis</data>
  <data key="d1">concept</data>
  <data key="d2">Necrosis is tissue death associated with anaerobic infection.&lt;SEP&gt;Death of pancreatic tissue used as a prognostic indicator in pancreatitis.</data>
  <data key="d3">chunk-c1acfa8b3bcf6abb174b1db6c3878690&lt;SEP&gt;chunk-aeeced344cdde493cb84ba3e9ab7759f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786418494</data>
</node>
