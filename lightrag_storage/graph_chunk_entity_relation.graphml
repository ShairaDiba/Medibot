  <data key="d4">unknown_source</data>
  <data key="d5">1786424861</data>
</node>
<node id="Severe PEM">
  <data key="d0">Severe PEM</data>
  <data key="d1">concept</data>
  <data key="d2">Severe PEM denotes a critical form of protein-energy malnutrition associated with high risk of complications such as heart failure and death.</data>
  <data key="d3">chunk-afbff98c4c1d63870e1df4480f9167fa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424861</data>
</node>
