<node id="Muscle Biopsy">
  <data key="d0">Muscle Biopsy</data>
  <data key="d1">method</data>
  <data key="d2">Muscle Biopsy is a tissue examination method used to diagnose Polymyositis and Dermatomyositis.</data>
