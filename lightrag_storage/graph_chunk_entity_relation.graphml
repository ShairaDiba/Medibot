<node id="Renal Pelvis">
  <data key="d0">Renal Pelvis</data>
  <data key="d1">naturalobject</data>
  <data key="d2">connection of ureter to kidney; can become overfilled with urine in hydronephrosis.</data>
  <data key="d3">chunk-2a51c332fdfaf8c96be6ab58c809b221</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409527</data>
</node>
<node id="Kidney Stones">
  <data key="d0">Kidney Stones</data>
  <data key="d1">concept</data>
  <data key="d2">common cause of hydronephrosis; form in renal pelvis and may lodge at ureterovesical junction.&lt;SEP&gt;Kidney stones are calcified formations in the kidneys that can arise from elevated calcium levels due to hyperparathyroidism.</data>
  <data key="d3">chunk-f6b9322625cf18b963b60cc6bc6ea35e&lt;SEP&gt;chunk-2a51c332fdfaf8c96be6ab58c809b221</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409881</data>
</node>
<node id="Bowel">
