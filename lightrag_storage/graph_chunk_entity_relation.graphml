<node id="Heartland Virus">
  <data key="d0">Heartland Virus</data>
  <data key="d1">concept</data>
  <data key="d2">Heartland Virus is a tick-borne phlebovirus of the Bunyaviridae family that causes severe illness and was first identified in 2009 in Missouri.</data>
  <data key="d3">chunk-29a876ab478c9008ee3809563b1fa892</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404263</data>
