<node id="Urinary Tract">
  <data key="d0">Urinary Tract</data>
  <data key="d1">concept</data>
  <data key="d2">system through which urine flows; obstruction leads to hydronephrosis.</data>
  <data key="d3">chunk-2a51c332fdfaf8c96be6ab58c809b221</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409527</data>
</node>
<node id="Ureter">
  <data key="d0">Ureter</data>
  <data key="d1">naturalobject</data>
  <data key="d2">tube connecting kidney to bladder; can become overfilled and swollen in hydronephrosis.</data>
  <data key="d3">chunk-2a51c332fdfaf8c96be6ab58c809b221</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409527</data>
