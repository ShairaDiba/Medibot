  <data key="d4">unknown_source</data>
  <data key="d5">1786379294</data>
</node>
<node id="Internal Organs">
  <data key="d0">Internal Organs</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Internal organs are body parts that can be infected by anaerobic bacteria in low-oxygen environments.</data>
  <data key="d3">chunk-c1acfa8b3bcf6abb174b1db6c3878690</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786379294</data>
</node>
<node id="Shock">
  <data key="d0">Shock</data>
  <data key="d1">concept</data>
  <data key="d2">Shock is a medical condition that increases risk for anaerobic infection.&lt;SEP&gt;Shock is a life‑threatening circulatory collapse that may occur in severe anaphylaxis.&lt;SEP&gt;Shock is a life‑threatening circulatory collapse that may occur in severe anaphylaxis.</data>
  <data key="d3">chunk-c1acfa8b3bcf6abb174b1db6c3878690&lt;SEP&gt;chunk-e59ab8338831484ea61486c70a6ad038</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786383938</data>
</node>
<node id="Injury">
  <data key="d0">Injury</data>
  <data key="d1">concept</data>
  <data key="d2">Injury is a condition that raises susceptibility to anaerobic infection.&lt;SEP&gt;Injury is physical harm that can cause low blood pressure when severe.&lt;SEP&gt;An injury is a physical trauma that can allow pathogens to enter a joint directly, leading to infectious arthritis.&lt;SEP&gt;Injury is listed as a possible risk associated with physical therapy.&lt;SEP&gt;Injury to the eyelid or nerves can lead to acquired ptosis.&lt;SEP&gt;Injury refers to physical damage whose symptoms may be relieved by reflexology.</data>
  <data key="d3">chunk-c1acfa8b3bcf6abb174b1db6c3878690&lt;SEP&gt;chunk-6a3b3c33dc539d83724153cf8bd92691&lt;SEP&gt;chunk-e7a69ca28e7676455bc1dd105b09f56c&lt;SEP&gt;chunk-e261bddabf1598318602d5ab776f60c1&lt;SEP&gt;chunk-bf2a4a7521a933797a5c97cd08b21a3d&lt;SEP&gt;chunk-e8411522bdeb607aaa222e6502bca7dc</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426921</data>
</node>
