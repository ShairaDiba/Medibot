  <data key="d0">Allograft</data>
  <data key="d1">concept</data>
  <data key="d2">Allograft describes a transplant involving an organ from a genetically nonidentical donor of the same species, as used in Heart Transplantation.</data>
  <data key="d3">chunk-d99d14117824aa2b5637825772676446</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404041</data>
