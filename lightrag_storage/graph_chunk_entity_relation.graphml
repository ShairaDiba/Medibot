<node id="Helicobacter Pylori">
  <data key="d0">Helicobacter Pylori</data>
  <data key="d1">creature</data>
  <data key="d2">Helicobacter pylori is a bacterium that causes recurrent gastric and duodenal ulcers.</data>
  <data key="d3">chunk-de288167dfc93e3a334ec826d0c43f8e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786387475</data>
</node>
<node id="Antibiotic Therapy">
  <data key="d0">Antibiotic Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Antibiotic therapy is a treatment approach combined with gastric acid suppression to eradicate Helicobacter pylori infections.&lt;SEP&gt;Antibiotic Therapy is a treatment initiated to prevent infection and inflammation in patients with Polycystic Kidney Disease.</data>
  <data key="d3">chunk-de288167dfc93e3a334ec826d0c43f8e&lt;SEP&gt;chunk-d855036a34135250bf6b6942f08845d7</data>
