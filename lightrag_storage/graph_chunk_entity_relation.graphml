  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Prolonged QT Syndrome includes inherited forms that are passed genetically.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424545</data>
</node>
<node id="Specific Heart Medications">
  <data key="d0">Specific Heart Medications</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Acquired forms of LQTS can be triggered by specific heart medications.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424547</data>
</node>
<node id="Potassium Supplementation">
  <data key="d0">Potassium Supplementation</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Potassium supplementation is being explored as a possible treatment for Prolonged QT Syndrome.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424548</data>
</node>
<node id="Prickly Heat">
  <data key="d0">Prickly Heat</data>
  <data key="d1">concept</data>
  <data key="d2">Prickly Heat is a common disorder of the sweat glands, also known as sweat retention syndrome or miliaria rubra, characterized by rash due to blocked sweat flow.</data>
  <data key="d3">chunk-3da3e9ecf369a29de0664ed8a629a950</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424550</data>
</node>
<node id="Sweat Retention Syndrome">
  <data key="d0">Sweat Retention Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Sweat Retention Syndrome is an alternate name for prickly heat, describing the condition where sweat is retained in the skin.</data>
  <data key="d3">chunk-3da3e9ecf369a29de0664ed8a629a950</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424550</data>
</node>
<node id="Miliaria Rubra">
  <data key="d0">Miliaria Rubra</data>
  <data key="d1">concept</data>
  <data key="d2">Miliaria rubra is a deeper form of prickly heat where sweat seeps into living layers of skin, causing a rash.</data>
  <data key="d3">chunk-3da3e9ecf369a29de0664ed8a629a950</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424550</data>
</node>
<node id="Miliaria Crystallina">
  <data key="d0">Miliaria Crystallina</data>
  <data key="d1">concept</data>
  <data key="d2">Miliaria crystallina is the most superficial form of sweat gland occlusion, affecting only the thin upper layer of skin and producing tiny blisters.</data>
  <data key="d3">chunk-3da3e9ecf369a29de0664ed8a629a950</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424550</data>
</node>
<node id="Sweat Glands">
  <data key="d0">Sweat Glands</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Sweat glands are coil‑shaped glands deep in the skin that produce sweat and can become plugged, leading to prickly heat.</data>
  <data key="d3">chunk-3da3e9ecf369a29de0664ed8a629a950</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424550</data>
</node>
<node id="Oil Glands">
  <data key="d0">Oil Glands</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Oil glands are skin glands that produce oil, distinct from sweat glands.</data>
  <data key="d3">chunk-3da3e9ecf369a29de0664ed8a629a950</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424550</data>
</node>
<node id="Hexachlorophene">
  <data key="d0">Hexachlorophene</data>
  <data key="d1">artifact</data>
  <data key="d2">Hexachlorophene is a topical antiseptic whose experimental application almost completely prevents sweat retention rashes.</data>
  <data key="d3">chunk-3da3e9ecf369a29de0664ed8a629a950</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424551</data>
</node>
<node id="Infants">
  <data key="d0">Infants</data>
  <data key="d1">person</data>
  <data key="d2">Infants are a population group more likely to develop miliaria rubra than adults.&lt;SEP&gt;Infants are babies in the first several weeks of life who are the primary patients affected by pyloric stenosis.</data>
