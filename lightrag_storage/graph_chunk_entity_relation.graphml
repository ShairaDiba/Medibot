  <data key="d4">unknown_source</data>
  <data key="d5">1786404263</data>
</node>
<node id="Lone Star Tick">
  <data key="d0">Lone Star Tick</data>
  <data key="d1">creature</data>
  <data key="d2">Lone Star Tick (Amblyomma americanum) is a tick species prevalent in the continental United States that transmits Heartland Virus to humans.</data>
  <data key="d3">chunk-29a876ab478c9008ee3809563b1fa892</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404263</data>
