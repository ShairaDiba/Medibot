  <data key="d0">Coronary Bypass Surgery</data>
  <data key="d1">method</data>
  <data key="d2">Coronary bypass surgery involves removal of a leg vein and is listed as a risk factor for acute lymphangitis.</data>
  <data key="d3">chunk-bead2f9ad4273b49f336c30d5e85e2f1</data>
