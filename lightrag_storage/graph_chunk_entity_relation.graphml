  <data key="d3">chunk-246a5f7e2057972c85a02d08655d00e9</data>
  <data key="d2">Croup is also known as laryngotracheitis, describing inflammation of the trachea and larynx.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786397218</data>
</node>
