  <data key="d0">Pomeroy, Ohio</data>
  <data key="d1">location</data>
  <data key="d2">Pomeroy, Ohio is the hometown of George Huntington, the discoverer of Huntington’s disease.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
