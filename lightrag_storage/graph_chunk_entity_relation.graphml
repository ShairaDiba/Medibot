<node id="Discontinuance of Causative Agent">
  <data key="d0">Discontinuance of Causative Agent</data>
  <data key="d1">method</data>
  <data key="d2">Discontinuance of the causative agent involves stopping the drug that caused hepatitis.</data>
  <data key="d3">chunk-79f9159512d902b809ff6ebeca7cf146</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405308</data>
</node>
<node id="Rest">
  <data key="d0">Rest</data>
  <data key="d1">method</data>
  <data key="d2">Rest is recommended during the acute phase of drug‑induced hepatitis to aid recovery.&lt;SEP&gt;Rest is a non‑pharmacological treatment recommended for acute primary Histoplasmosis.</data>
  <data key="d3">chunk-79f9159512d902b809ff6ebeca7cf146&lt;SEP&gt;chunk-3323f3fda2ab71ab254c2a21d7d535a1</data>
