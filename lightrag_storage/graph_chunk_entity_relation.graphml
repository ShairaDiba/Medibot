  <data key="d3">chunk-ea3519af09df48250c19cedc50f317f4</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425689</data>
</node>
<node id="Pulmonary Artery Catheterization">
  <data key="d0">Pulmonary Artery Catheterization</data>
  <data key="d1">method</data>
  <data key="d2">Pulmonary artery catheterization is a diagnostic method where a small catheter is inserted through a vein (neck, arm, chest, or thigh) and advanced into the right side of the heart to measure pressures at various cardiac locations.</data>
  <data key="d3">chunk-3b7e1ff6aefba50b9ab4cb48e8298cf0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425802</data>
</node>
<node id="Right Side of the Heart">
  <data key="d0">Right Side of the Heart</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The right side of the heart is the cardiac region where the catheter is positioned to obtain pressure measurements.</data>
  <data key="d3">chunk-3b7e1ff6aefba50b9ab4cb48e8298cf0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425802</data>
</node>
<node id="Serious Burns">
  <data key="d0">Serious Burns</data>
  <data key="d1">concept</data>
  <data key="d2">Serious burns are a condition for which fluid balance is checked with pulmonary artery catheterization.</data>
  <data key="d3">chunk-3b7e1ff6aefba50b9ab4cb48e8298cf0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425802</data>
</node>
<node id="Heart Surgery">
  <data key="d0">Heart Surgery</data>
  <data key="d1">method</data>
  <data key="d2">Heart surgery is a procedure after which fluid balance is assessed using pulmonary artery catheterization.</data>
  <data key="d3">chunk-3b7e1ff6aefba50b9ab4cb48e8298cf0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425802</data>
</node>
<node id="Medication Effect">
  <data key="d0">Medication Effect</data>
  <data key="d1">concept</data>
  <data key="d2">Medication effect refers to the impact of drugs that is assessed by pulmonary artery catheterization.</data>
  <data key="d3">chunk-3b7e1ff6aefba50b9ab4cb48e8298cf0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425802</data>
</node>
<node id="Cardiac Shunt">
  <data key="d0">Cardiac Shunt</data>
  <data key="d1">concept</data>
  <data key="d2">Cardiac shunt is a key term related to pulmonary artery catheterization.</data>
  <data key="d3">chunk-3b7e1ff6aefba50b9ab4cb48e8298cf0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786425802</data>
</node>
