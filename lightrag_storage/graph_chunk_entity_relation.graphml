<node id="Aldosterone">
  <data key="d0">Aldosterone</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Aldosterone is a hormone released by the adrenal cortex under ACTH influence, involved in sodium balance.&lt;SEP&gt;Aldosterone is a hormone produced by the cortex of the adrenal glands that regulates sodium and potassium balance in the blood.</data>
  <data key="d3">chunk-7913b0884240a87bdd0d8c498ec19f82&lt;SEP&gt;chunk-44b884468a26dc2957843352da600dce</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377737</data>
</node>
