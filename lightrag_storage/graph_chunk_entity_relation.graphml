  <data key="d5">1786420389</data>
</node>
<node id="Blood Clot">
  <data key="d0">Blood Clot</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Blood Clot is a solid mass of blood formed when platelets and fibrin aggregate, potentially blocking blood vessels.&lt;SEP&gt;A clot of blood that can obstruct the pulmonary artery and contribute to pulmonary hypertension.</data>
  <data key="d3">chunk-e1d14811c0b5a6299d4e8dbc3a469d37&lt;SEP&gt;chunk-895c5e07d9ff1dcdf835a5d197d6cf8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786426310</data>
</node>
<node id="Thrombolytic Therapy">
  <data key="d0">Thrombolytic Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Thrombolytic Therapy is a medical treatment that uses intravenous drugs to dissolve blood clots during a heart attack.</data>
  <data key="d3">chunk-895c5e07d9ff1dcdf835a5d197d6cf8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404109</data>
</node>
<node id="Beta‑Blocker">
  <data key="d0">Beta‑Blocker</data>
  <data key="d1">artifact</data>
  <data key="d2">Beta‑Blocker is a class of drugs used to control heart rate and reduce workload on the heart during a heart attack.</data>
  <data key="d3">chunk-895c5e07d9ff1dcdf835a5d197d6cf8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404110</data>
</node>
<node id="Intravenous Drug Therapy">
  <data key="d0">Intravenous Drug Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Intravenous Drug Therapy is the administration of medication through a vein, often used as part of thrombolytic therapy for heart attacks.</data>
  <data key="d3">chunk-895c5e07d9ff1dcdf835a5d197d6cf8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404110</data>
</node>
<node id="Cardiac Rehabilitation Program">
  <data key="d0">Cardiac Rehabilitation Program</data>
  <data key="d1">method</data>
  <data key="d2">Cardiac Rehabilitation Program is a structured secondary‑prevention program involving exercise, education, and counseling for patients after a heart attack</data>
  <data key="d3">chunk-895c5e07d9ff1dcdf835a5d197d6cf8c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404110</data>
</node>
<node id="Heavy Metal Poisoning">
  <data key="d0">Heavy Metal Poisoning</data>
  <data key="d1">other</data>
  <data key="d2">Heavy metal poisoning is the toxic accumulation of heavy metals in soft body tissues, regarded as a medical emergency with varied symptoms and diagnosed via multiple tests, treated primarily with chelation therapy.</data>
  <data key="d3">chunk-37a7bbdf4b8bdf03a0eb8a72a9561fd6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404180</data>
</node>
<node id="Lead">
  <data key="d0">Lead</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Lead is a heavy metal element commonly implicated in accidental poisoning; high blood levels indicate lead poisoning, while lower levels can cause intellectual disabilities.&lt;SEP&gt;Lead is a heavy metal element that can cause poisoning when exposure occurs.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694&lt;SEP&gt;chunk-37a7bbdf4b8bdf03a0eb8a72a9561fd6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422326</data>
</node>
<node id="Mercury">
  <data key="d0">Mercury</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Mercury is a heavy metal element historically linked to hatmakers’ poisoning, giving rise to the expression “mad as a hatter.”</data>
  <data key="d3">chunk-37a7bbdf4b8bdf03a0eb8a72a9561fd6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404180</data>
</node>
<node id="Arsenic">
  <data key="d0">Arsenic</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Arsenic is a heavy metal element formerly used in pest control and associated with accidental poisonings.</data>
  <data key="d3">chunk-37a7bbdf4b8bdf03a0eb8a72a9561fd6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404180</data>
</node>
<node id="Cadmium">
  <data key="d0">Cadmium</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cadmium is a heavy metal element that can cause accidental human poisoning.</data>
  <data key="d3">chunk-37a7bbdf4b8bdf03a0eb8a72a9561fd6</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404180</data>
