<node id="Genetic Counseling">
  <data key="d0">Genetic Counseling</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic counseling is a communication process that translates personal genetic risk information into practical information for families.&lt;SEP&gt;Service that benefits individuals known to carry the disease or have family history.&lt;SEP&gt;Genetic counseling is a referral service mentioned in prepregnancy counseling for patients with a family history of inherited disease.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a&lt;SEP&gt;chunk-e2668ae388ce75891b60c313b7cab62b&lt;SEP&gt;chunk-0562388bfd043886184b76d26796a668</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423559</data>
</node>
<node id="Genetic Counselor">
  <data key="d0">Genetic Counselor</data>
  <data key="d1">person</data>
  <data key="d2">Genetic counselors are healthcare professionals with specialized training and experience in medical genetics and counseling, working as members of a healthcare team.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="Healthcare Team">
  <data key="d0">Healthcare Team</data>
  <data key="d1">organization</data>
  <data key="d2">The healthcare team comprises professionals, including genetic counselors, who provide individuals and families with information on genetic disorders.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="Genetic Disorders">
  <data key="d0">Genetic Disorders</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic disorders are inherited conditions whose nature, inheritance, and implications are explained during genetic counseling.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="Prenatal Genetic Counseling">
  <data key="d0">Prenatal Genetic Counseling</data>
  <data key="d1">method</data>
  <data key="d2">Prenatal genetic counseling is provided to couples with increased risk for birth defects or inherited conditions who are expecting a child or planning a pregnancy.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="Pediatric Genetic Counseling">
  <data key="d0">Pediatric Genetic Counseling</data>
  <data key="d1">method</data>
  <data key="d2">Pediatric genetic counseling is provided to families with children suspected of having or previously diagnosed with a genetic disorder.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="Adult Genetic Counseling">
  <data key="d0">Adult Genetic Counseling</data>
  <data key="d1">method</data>
  <data key="d2">Adult genetic counseling is provided to adults with clinical features of an inherited disease or a family history.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="Cystic Fibrosis">
  <data key="d0">Cystic Fibrosis</data>
  <data key="d1">concept</data>
  <data key="d2">Cystic fibrosis is a genetic disorder for which specific counseling is offered.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="CFTR">
  <data key="d0">CFTR</data>
  <data key="d1">concept</data>
  <data key="d2">CFTR is the gene associated with cystic fibrosis.</data>
  <data key="d3">chunk-d6ec3b15611dc7dd72a22a499011fa4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400191</data>
</node>
<node id="Avoiding Stressors">
  <data key="d0">Avoiding Stressors</data>
  <data key="d1">method</data>
  <data key="d2">Avoiding Stressors is a stress reduction technique that involves eliminating exposure to stress-inducing factors.</data>
  <data key="d3">chunk-9ad30bf77e8797dcdced78f2e2465f87</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400267</data>
</node>
<node id="Changing Reaction to Stressors">
  <data key="d0">Changing Reaction to Stressors</data>
  <data key="d1">method</data>
  <data key="d2">Changing Reaction to Stressors is a stress reduction technique that focuses on modifying one's response to stressful stimuli.</data>
  <data key="d3">chunk-9ad30bf77e8797dcdced78f2e2465f87</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400267</data>
</node>
<node id="Relieving Stress">
  <data key="d0">Relieving Stress</data>
  <data key="d1">method</data>
  <data key="d2">Relieving Stress is a stress reduction technique that involves actions taken after a stressor to alleviate its effects.</data>
  <data key="d3">chunk-9ad30bf77e8797dcdced78f2e2465f87</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400267</data>
</node>
<node id="Stress-Related Physical Illness">
  <data key="d0">Stress-Related Physical Illness</data>
  <data key="d1">concept</data>
  <data key="d2">Stress-related physical illness refers to bodily diseases that arise due to prolonged stress, often associated with General Adaptation Syndrome.</data>
  <data key="d3">chunk-9ad30bf77e8797dcdced78f2e2465f87</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400267</data>
</node>
<node id="Genital Warts">
  <data key="d0">Genital Warts</data>
  <data key="d1">concept</data>
  <data key="d2">Genital warts are growths in the genital area caused by a sexually transmitted papillomavirus, representing the most common STD in the general population.&lt;SEP&gt;Genital Warts are skin growths on the genital area caused by specific strains of Human Papillomavirus.</data>
  <data key="d3">chunk-a3e49cac7d8a89a06ea2ab78d39b9e33&lt;SEP&gt;chunk-42c3c3c73e1fc719b81a2fc054715a4c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409037</data>
</node>
<node id="Condylomata Acuminata">
  <data key="d0">Condylomata Acuminata</data>
  <data key="d1">concept</data>
  <data key="d2">Condylomata acuminata is an alternative name for genital warts.</data>
  <data key="d3">chunk-a3e49cac7d8a89a06ea2ab78d39b9e33</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786400473</data>
</node>
<node id="Venereal Warts">
  <data key="d0">Venereal Warts</data>
  <data key="d1">concept</data>
  <data key="d2">Venereal warts is another alternative name for genital warts.</data>
  <data key="d3">chunk-a3e49cac7d8a89a06ea2ab78d39b9e33</data>
