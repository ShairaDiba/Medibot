  <data key="d0">Bee Sting</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Bee sting is an example of an injury that can trigger acute inflammation.</data>
  <data key="d3">chunk-97c12585544967d7c896d91a36a80447</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786386419</data>
