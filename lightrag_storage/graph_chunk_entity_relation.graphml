  <data key="d0">Antidote</data>
  <data key="d1">concept</data>
  <data key="d2">An antidote is a substance used to counteract the effects of a poison.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422327</data>
</node>
