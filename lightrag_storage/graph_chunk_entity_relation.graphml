  <data key="d4">unknown_source</data>
  <data key="d5">1786409632</data>
</node>
<node id="George Huntington">
  <data key="d0">George Huntington</data>
  <data key="d1">person</data>
  <data key="d2">George Huntington discovered and first described Huntington’s disease and was from Pomeroy, Ohio.</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409632</data>
