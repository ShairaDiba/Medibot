  <data key="d4">unknown_source</data>
  <data key="d5">1786421622</data>
</node>
<node id="Cortex">
  <data key="d0">Cortex</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cortex is the outer part of the adrenal glands where aldosterone is synthesized.</data>
  <data key="d3">chunk-7913b0884240a87bdd0d8c498ec19f82</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377738</data>
</node>
<node id="Aldolase">
  <data key="d0">Aldolase</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Aldolase is an enzyme present throughout the body, especially in muscles, that catalyzes specific chemical reactions to help muscles convert sugar into energy.</data>
  <data key="d3">chunk-919116bb6efe3303887cfaa1a2474f3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377758</data>
</node>
<node id="Aldolase Test">
  <data key="d0">Aldolase Test</data>
  <data key="d1">method</data>
  <data key="d2">Aldolase Test is a diagnostic test that measures the amount of aldolase in a person’s serum to diagnose and monitor skeletal muscle diseases.</data>
  <data key="d3">chunk-919116bb6efe3303887cfaa1a2474f3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377758</data>
</node>
<node id="Skeletal Muscle Disease">
  <data key="d0">Skeletal Muscle Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Skeletal Muscle Disease refers to disorders that affect the muscles attached to bones, causing increased aldolase levels in the blood.</data>
  <data key="d3">chunk-919116bb6efe3303887cfaa1a2474f3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377758</data>
</node>
<node id="Skeletal Muscle">
  <data key="d0">Skeletal Muscle</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Skeletal muscle is a type of muscle attached to bones whose contractions move the skeleton, and it contains high concentrations of aldolase.&lt;SEP&gt;Skeletal muscle is a type of muscle tissue where the majority of the body's potassium is stored intracellularly.</data>
  <data key="d3">chunk-f8a0239df88721094e3c51f8a7373134&lt;SEP&gt;chunk-919116bb6efe3303887cfaa1a2474f3d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410761</data>
</node>
<node id="Serum">
  <data key="d0">Serum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Serum is the liquid component of blood used in the Aldolase Test, mixed with a reagent to trigger a measurable reaction.&lt;SEP&gt;The liquid component of blood from which antibodies are measured in the test.&lt;SEP&gt;Serum is a biological fluid mentioned as the entry term in the document.</data>
  <data key="d3">chunk-9b2f2e3046d0f775744775822b8b1381&lt;SEP&gt;chunk-919116bb6efe3303887cfaa1a2474f3d&lt;SEP&gt;chunk-fb3f69c0e24f7808954b601ab37de0ac</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786396401</data>
