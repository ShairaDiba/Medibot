  <data key="d0">Pulmonary Blood Flow Classification</data>
  <data key="d1">concept</data>
  <data key="d2">Pulmonary blood flow classification categorizes heart lesions based on increased or decreased pulmonary blood flow.</data>
  <data key="d3">chunk-56ef10afa5a5d842dfa90eafc05da760</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403828</data>
</node>
<node id="Obstruction to Blood Flow">
  <data key="d0">Obstruction to Blood Flow</data>
  <data key="d1">concept</data>
  <data key="d2">Obstruction to blood flow classification categorizes heart lesions based on the presence of an obstruction to blood flow.</data>
  <data key="d3">chunk-56ef10afa5a5d842dfa90eafc05da760</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786403828</data>
</node>
