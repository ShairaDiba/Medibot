  <data key="d0">Shampoo</data>
  <data key="d1">artifact</data>
  <data key="d2">Shampoo is a household product not intended for ingestion or inhalation, which can cause poisoning if misused.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422325</data>
