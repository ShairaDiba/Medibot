  <data key="d0">High Liver Enzymes</data>
  <data key="d1">concept</data>
  <data key="d2">Elevated liver enzymes</data>
  <data key="d3">chunk-36c53d0d3d0b154d1cafa4ae311eafc9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405399</data>
</node>
<node id="High-Risk Pregnancy">
  <data key="d0">High-Risk Pregnancy</data>
  <data key="d1">concept</data>
  <data key="d2">High-Risk Pregnancy is a condition in which maternal or fetal complications increase the risk of illness or death for mother or baby, requiring special medical attention.</data>
  <data key="d3">chunk-983b3f2e664e0a36b1b8ee3747b9cc69</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405467</data>
</node>
<node id="Pregnant Woman">
  <data key="d0">Pregnant Woman</data>
  <data key="d1">person</data>
  <data key="d2">Pregnant Woman refers to the female patient experiencing a high-risk pregnancy and undergoing prenatal assessment and care.</data>
  <data key="d3">chunk-983b3f2e664e0a36b1b8ee3747b9cc69</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405467</data>
</node>
<node id="High-Risk Screening">
  <data key="d0">High-Risk Screening</data>
  <data key="d1">method</data>
  <data key="d2">High-Risk Screening is the process conducted at the first prenatal visit to identify risk factors for complications in pregnancy.</data>
  <data key="d3">chunk-983b3f2e664e0a36b1b8ee3747b9cc69</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405467</data>
</node>
<node id="Medical Regimen">
  <data key="d0">Medical Regimen</data>
  <data key="d1">concept</data>
  <data key="d2">Medical Regimen refers to the prescribed treatment plan that a woman with a high-risk pregnancy should strictly adhere to for a positive outcome.</data>
  <data key="d3">chunk-983b3f2e664e0a36b1b8ee3747b9cc69</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405467</data>
</node>
<node id="Nurse">
  <data key="d0">Nurse</data>
  <data key="d3">chunk-d89439564ae2dc33beae4237976b40b1&lt;SEP&gt;chunk-6c5e751c6db20a49f7ca0a341eadc654&lt;SEP&gt;chunk-0562388bfd043886184b76d26796a668&lt;SEP&gt;chunk-983b3f2e664e0a36b1b8ee3747b9cc69</data>
  <data key="d2">The nurse obtains the data necessary to begin the high-risk screening during the first prenatal visit.&lt;SEP&gt;A nurse monitors the patient’s vital signs and watches for itching, flushing, nausea, vomiting, sweating, excessive saliva flow, and possible serious allergic reactions to contrast dye.&lt;SEP&gt;A nurse monitors the patient’s vital signs and watches&lt;SEP&gt;A nurse is a healthcare professional who may perform phlebotomy procedures.&lt;SEP&gt;Nurse is a healthcare professional who can provide prepregnancy counseling.</data>
  <data key="d1">concept</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786423558</data>
</node>
<node id="American Medical Association">
  <data key="d0">American Medical Association</data>
  <data key="d1">organization</data>
  <data key="d2">American Medical Association is a professional organization located at 515 N. State St., Chicago, IL, 60654, contact (800) 621-8335, website http://www.ama-assn.org/.</data>
  <data key="d3">chunk-f763509b52152b64c763dec3d22eaf83</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405475</data>
</node>
<node id="Association of Birth Defect Children">
  <data key="d0">Association of Birth Defect Children</data>
  <data key="d1">organization</data>
  <data key="d2">Association of Birth Defect Children is an organization located at 3526 Emerywood Lane, Orlando, FL, 32806, contact (305) 85.</data>
  <data key="d3">chunk-f763509b52152b64c763dec3d22eaf83</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405475</data>
</node>
<node id="Hereditary Hemorrhagic Telangiectasia">
  <data key="d0">Hereditary Hemorrhagic Telangiectasia</data>
  <data key="d1">concept</data>
  <data key="d2">Hereditary Hemorrhagic Telangiectasia is an inherited disorder characterized by abnormal blood vessel formation and recurrent bleeding, for which no specific treatment exists.&lt;SEP&gt;Inherited condition characterized by abnormal, fragile blood vessels prone to bleeding; autosomal dominant; affects multiple body systems.</data>
  <data key="d3">chunk-e2668ae388ce75891b60c313b7cab62b&lt;SEP&gt;chunk-f763509b52152b64c763dec3d22eaf83</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405557</data>
</node>
<node id="Iron Supplements">
  <data key="d0">Iron Supplements</data>
  <data key="d1">artifact</data>
  <data key="d2">Iron Supplements are nutritional products used to treat iron deficiency anemia resulting from recurrent bleeding in hereditary hemorrhagic telangiectasia.</data>
  <data key="d3">chunk-f763509b52152b64c763dec3d22eaf83</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405475</data>
</node>
<node id="Laser">
  <data key="d0">Laser</data>
  <data key="d1">artifact</data>
  <data key="d2">Laser is a medical device used to destroy abnormal vessels in the treatment of hereditary hemorrhagic telangiectasia.</data>
  <data key="d3">chunk-f763509b52152b64c763dec3d22eaf83</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405475</data>
</node>
<node id="Graft">
  <data key="d0">Graft</data>
  <data key="d1">artifact</data>
  <data key="d2">Graft refers to normal tissue used to plug or cover a leaking artery in severe cases of hereditary hemorrhagic telangiectasia.</data>
  <data key="d3">chunk-f763509b52152b64c763dec3d22eaf83</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405475</data>
</node>
<node id="Femoral Hernia">
  <data key="d0">Femoral Hernia</data>
  <data key="d3">chunk-f763509b52152b64c763dec3d22eaf83</data>
  <data key="d2">Femoral Hernia is a type of hernia related to the femoral canal, classified under the broader condition Hernia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405477</data>
</node>
<node id="Hernia">
  <data key="d0">Hernia</data>
  <data key="d3">chunk-f763509b52152b64c763dec3d22eaf83&lt;SEP&gt;chunk-09934893a08d3cab96095297ececeeb7&lt;SEP&gt;chunk-e12a604aa907a1e42740edfcfafe2583</data>
  <data key="d2">Femoral Hernia is a type of hernia related to the femoral canal, classified under the broader condition Hernia.&lt;SEP&gt;Hernia is a condition where an organ, usually the intestines, bulges through a weakness in the abdominal wall, occurring in children and adults.&lt;SEP&gt;Hernia is a protrusion of an organ through a weakened area of muscle or tissue that can cause mechanical intestinal obstruction.</data>
  <data key="d1">concept</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412491</data>
</node>
<node id="Rendu-Osler-Weber Disease">
  <data key="d0">Rendu-Osler-Weber Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Alternative name for Hereditary Hemorrhagic Telangiectasia.</data>
  <data key="d3">chunk-e2668ae388ce75891b60c313b7cab62b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405557</data>
</node>
