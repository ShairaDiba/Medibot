  <data key="d2">Hand washing is recommended to minimize exposure to Cryptosporidia cysts and prevent Cryptosporidiosis.&lt;SEP&gt;Hand washing is a preventive method recommended for frequent and thorough cleaning to reduce the spread of infectious diseases.</data>
  <data key="d1">method</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786411862</data>
</node>
