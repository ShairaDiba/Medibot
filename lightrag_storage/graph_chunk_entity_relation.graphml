<node id="Paruretics">
  <data key="d0">Paruretics</data>
  <data key="d1">person</data>
  <data key="d2">Individuals who suffer from paruresis and experience difficulty or inability to urinate in public or under social pressure.</data>
  <data key="d3">chunk-f07ae0c28dc0d57b8d89d819ee884b1d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786416615</data>
