  <data key="d5">1786424717</data>
</node>
<node id="QT Interval">
  <data key="d0">QT Interval</data>
  <data key="d1">concept</data>
  <data key="d2">QT interval is the measured time on an electrocardiogram that may be absent in routine tests for Prolonged QT Syndrome.</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424539</data>
</node>
<node id="Gene Mutations">
  <data key="d0">Gene Mutations</data>
  <data key="d1">concept</data>
  <data key="d2">Gene mutations are hereditary alterations that cause inherited forms of Prolonged QT Syndrome and can be passed to offspring.</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424539</data>
</node>
<node id="Syncope">
  <data key="d0">Syncope</data>
  <data key="d1">concept</data>
  <data key="d2">Syncope is a temporary loss of consciousness that individuals with undiagnosed Prolonged QT Syndrome are at increased risk of experiencing.</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424539</data>
</node>
<node id="Prolonged QT Syndrome">
  <data key="d0">Prolonged QT Syndrome</data>
  <data key="d3">chunk-a88e9cf64ee28573945491871b0031d7</data>
  <data key="d2">Prolonged QT Syndrome increases the risk of Sudden Death due to abnormal heartbeats.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424540</data>
</node>
<node id="Acquired Forms of LQTS">
