  <data key="d0">Glycogen</data>
  <data key="d1">naturalobject</data>
  <data key="d2">primary carbohydrate fuel reserve stored in muscles and liver, involved in metabolism disrupted in GSD.</data>
  <data key="d3">chunk-25a42943ad0f93e6631565dc2c851d36</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786401778</data>
