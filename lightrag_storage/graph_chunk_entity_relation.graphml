<node id="Proangiogenic Therapy">
  <data key="d0">Proangiogenic Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Proangiogenic therapy is a medical method that promotes blood vessel growth, contrasted with antiangiogenic therapy.</data>
  <data key="d3">chunk-43384133dfe3fd1b2a03d01d15878f94</data>
  <data key="d4">unknown_source</data>
