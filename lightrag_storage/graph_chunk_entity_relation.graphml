  <data key="d0">Stridor</data>
  <data key="d1">concept</data>
  <data key="d2">Stridor is a high‑pitched breathing sound that may appear in severe Croup cases.</data>
  <data key="d3">chunk-246a5f7e2057972c85a02d08655d00e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786397214</data>
