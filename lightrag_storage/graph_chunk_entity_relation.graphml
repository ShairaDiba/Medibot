  <data key="d0">Continuous Cardiac Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Continuous Cardiac Monitoring is a technique used after Heart Transplantation to diagnose and treat donor heart function.</data>
  <data key="d3">chunk-d99d14117824aa2b5637825772676446</data>
