<node id="Inclusion Body Myositis">
  <data key="d0">Inclusion Body Myositis</data>
  <data key="d1">concept</data>
  <data key="d2">Inclusion Body Myositis is a type of inflammatory muscle disease (myopathy) that progresses gradually.</data>
  <data key="d3">chunk-346dbc5b46cc5130f0b88acb5bdd6aca</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422475</data>
