<node id="Activated Charcoal">
  <data key="d0">Activated Charcoal</data>
  <data key="d1">artifact</data>
  <data key="d2">Activated Charcoal is a treatment that adsorbs toxins like aspirin in the gastrointestinal tract during poisoning.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422327</data>
