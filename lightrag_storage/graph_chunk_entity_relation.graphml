  <data key="d0">Ductus Arteriosus</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The ductus arteriosus is a temporary fetal blood vessel that connects the aorta and the pulmonary artery before birth.</data>
  <data key="d3">chunk-2178c16160f72fcce4eafd8e4952fe8f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419023</data>
