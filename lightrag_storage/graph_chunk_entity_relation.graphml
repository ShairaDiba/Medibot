</node>
<node id="Antiangiogenic Therapy">
  <data key="d0">Antiangiogenic Therapy</data>
  <data key="d1">method</data>
  <data key="d2">Antiangiogenic therapy is a medical method that inhibits the growth of new blood vessels to restore health.</data>
  <data key="d3">chunk-43384133dfe3fd1b2a03d01d15878f94</data>
  <data key="d4">unknown_source</data>
