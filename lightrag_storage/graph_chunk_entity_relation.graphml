  <data key="d1">artifact</data>
  <data key="d2">Bismuth compounds are chemical agents used in combination treatments for ulcers caused by Helicobacter pylori.</data>
  <data key="d3">chunk-de288167dfc93e3a334ec826d0c43f8e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786387475</data>
</node>
<node id="Ulcers">
  <data key="d0">Ulcers</data>
  <data key="d1">concept</data>
  <data key="d2">Ulcers are lesions in the stomach and upper small intestine that result from Helicobacter pylori infection.</data>
