  <data key="d4">unknown_source</data>
  <data key="d5">1786403702</data>
</node>
<node id="Cold Water">
  <data key="d0">Cold Water</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Cold water exposure that, when repeatedly flushed through the ear canal, can stimulate bone overgrowth.&lt;SEP&gt;Cold water is a form of water used in hydrotherapy for its cooling and therapeutic effects.</data>
  <data key="d3">chunk-bafb2bd57a03b4eb45b6b85949d2efef&lt;SEP&gt;chunk-bca77605ecf717ab8187e9673827ff86</data>
