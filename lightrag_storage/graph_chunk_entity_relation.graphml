  <data key="d1">naturalobject</data>
  <data key="d2">Food can become contaminated with HAV virus through human waste, acting as a transmission medium.</data>
  <data key="d3">chunk-97bc31370eb8948b543aaf5f06eb9116</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786405386</data>
