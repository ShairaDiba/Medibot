  <data key="d0">Cirrhosis of the Liver</data>
  <data key="d1">concept</data>
  <data key="d2">Cirrhosis of the liver is a serious health consequence that can result from iron overload caused by hemochromatosis.</data>
  <data key="d3">chunk-5d78fea89c4fad7d739948de01e91d4a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786404755</data>
