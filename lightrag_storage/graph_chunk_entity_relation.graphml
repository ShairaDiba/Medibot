<node id="Nasal Septum">
  <data key="d0">Nasal Septum</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Nasal Septum is the vertical plane of tissue separating the nostrils, composed of cartilage at the front and bone at the back, covered by mucus membranes.</data>
  <data key="d3">chunk-6c5f40938298f68915d43c1e7cdd62e8</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419621</data>
</node>
<node id="Mucus Membranes">
  <data key="d0">Mucus Membranes</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Mucus membranes line both sides of the nasal septum and contain blood vessels that supply nutrition to the cartilage.</data>
