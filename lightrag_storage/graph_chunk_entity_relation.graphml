<edge source="Peripheral Blood Vessels" target="Hands">
  <data key="d6">1.0</data>
  <data key="d7">Spasms in peripheral blood vessels decrease their internal diameter, reducing blood flow to the hands.</data>
  <data key="d8">reduced blood flow,vasoconstriction</data>
