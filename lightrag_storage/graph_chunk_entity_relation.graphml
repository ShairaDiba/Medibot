  <data key="d3">chunk-574b898c062ba598fbc6995f73a3afbf</data>
  <data key="d2">Loperamide, an anti-motility medication, is used to treat diarrhea in Cryptosporidiosis patients.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786397308</data>
</node>
<node id="Diphenoxylate">
  <data key="d0">Diphenoxylate</data>
