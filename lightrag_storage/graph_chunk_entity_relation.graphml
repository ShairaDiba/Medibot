  <data key="d0">IgE Antibody</data>
  <data key="d1">artifact</data>
  <data key="d2">IgE Antibody is a type of antibody produced in large amounts by lymphocytes during allergic reactions.</data>
  <data key="d3">chunk-fea6119439079b171fb416dd0c1a0f6a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786377851</data>
