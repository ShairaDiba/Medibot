  <data key="d0">Acetaminophen (Tylenol)</data>
  <data key="d1">artifact</data>
  <data key="d2">Acetaminophen (Tylenol) is a pain reliever that can cause poisoning if taken in excessive amounts.</data>
  <data key="d3">chunk-13d7186c36bc114fd063d81d9835a694</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422327</data>
