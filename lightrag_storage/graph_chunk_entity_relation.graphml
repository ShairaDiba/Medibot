  <data key="d5">1786388401</data>
</node>
<node id="Male-Dominated Profession">
  <data key="d0">Male-Dominated Profession</data>
  <data key="d3">chunk-af3262684a537f83a047b77ed5ae0b70</data>
  <data key="d2">Virginia Apgar faced challenges due to the male-dominated nature of the surgical profession.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388402</data>
</node>
<node id="One Minute">
  <data key="d0">One Minute</data>
  <data key="d3">chunk-af3262684a537f83a047b77ed5ae0b70</data>
  <data key="d2">Apgar Testing is performed at one minute after birth.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388402</data>
</node>
<node id="Pallor">
  <data key="d0">Pallor</data>
  <data key="d3">chunk-af3262684a537f83a047b77ed5ae0b70</data>
  <data key="d2">Pallor indicates extreme paleness in the color assessment.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786388402</data>
</node>
<node id="Prolonged Observation">
  <data key="d0">Prolonged Observation</data>
  <data key="d3">chunk-af3262684a537f83a047b77ed5ae0b70</data>
  <data key="d2">Complications may flag the need for prolonged observation.</data>
  <data key="d1">UNKNOWN</data>
