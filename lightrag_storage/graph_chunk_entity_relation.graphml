  <data key="d1">concept</data>
  <data key="d2">Intolerance to heat is a symptom reported in women with a hydatidiform mole.</data>
  <data key="d3">chunk-03146cdc1f2091b67696466e08fc65db</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409676</data>
</node>
<node id="Ventricles">
  <data key="d0">Ventricles</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Ventricles are cavities within the brain that contain cerebrospinal fluid; hydrocephalus involves abnormal expansion of these ventricles.&lt;SEP&gt;Lower chambers of the heart that receive impulses from a premature atrial beat during Paroxysmal Atrial Tachycardia.</data>
  <data key="d3">chunk-414a580eb00a7d0d58696314c2aa7dfe&lt;SEP&gt;chunk-5c010d7434431d55a95ba1558562f859</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419041</data>
</node>
<node id="Choroid Plexus">
  <data key="d0">Choroid Plexus</data>
  <data key="d1">naturalobject</data>
  <data key="d2">The choroid plexus is a structure in the brain that produces cerebrospinal fluid by epidermal cells lining the ventricles.</data>
  <data key="d3">chunk-414a580eb00a7d0d58696314c2aa7dfe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409694</data>
</node>
<node id="Aqueductal Stenosis">
  <data key="d0">Aqueductal Stenosis</data>
  <data key="d1">concept</data>
  <data key="d2">Aqueductal stenosis is an obstruction of the cerebral aqueduct and is the most frequent cause of congenital hydrocephalus.</data>
  <data key="d3">chunk-414a580eb00a7d0d58696314c2aa7dfe</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409694</data>
</node>
