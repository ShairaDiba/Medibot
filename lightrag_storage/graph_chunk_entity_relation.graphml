  <data key="d5">1786422231</data>
</node>
<node id="Type 3 Poliovirus">
  <data key="d0">Type 3 Poliovirus</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Type 3 Poliovirus is one of the three known poliovirus strains.</data>
  <data key="d3">chunk-6a43117074cce1d59c31131832dfa007</data>
  <data key="d4">unknown_source</data>
