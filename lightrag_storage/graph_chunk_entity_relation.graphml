  <data key="d0">James Esdaile</data>
  <data key="d1">person</data>
  <data key="d2">James Esdaile is a pioneer who discovered that hypnosis could be successfully used to anesthetize patients for surgeries."</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410551</data>
</node>
<node id="Franz Mesmer">
  <data key="d0">Franz Mesmer</data>
  <data key="d1">person</data>
  <data key="d2">Franz Mesmer is an Austrian physician credited with being the first person to scientifically investigate hypnotherapy in 1779; he studied medicine at the University of Vienna and received his medical degree in 1766."</data>
  <data key="d3">chunk-f969285e863e5fae013c6c554aef0830</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410551</data>
