  <data key="d5">1786410552</data>
</node>
<node id="Hypochondriacal Neurosis">
  <data key="d0">Hypochondriacal Neurosis</data>
  <data key="d1">concept</data>
  <data key="d2">Hypochondriacal Neurosis is the former name for the condition now known as Hypochondriasis.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410601</data>
</node>
<node id="Adolescents">
  <data key="d0">Adolescents</data>
  <data key="d1">concept</data>
  <data key="d2">Adolescents are a population group in which hypochondriasis is increasingly recognized.&lt;SEP&gt;Adolescents are a demographic group that Proctitis mainly affects.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c&lt;SEP&gt;chunk-dad561d3742857b36b06aba05376ddc3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424474</data>
</node>
<node id="Elderly People">
  <data key="d0">Elderly People</data>
  <data key="d1">concept</data>
  <data key="d2">Elderly People are a population group that may develop hypochondriasis without prior health‑related fears.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410601</data>
</node>
<node id="Men">
  <data key="d0">Men</data>
  <data key="d1">concept</data>
  <data key="d2">Men are a gender group in which hypochondriasis is reported to be equally common.&lt;SEP&gt;Male individuals who can become infected and transmit many perinatal infections.&lt;SEP&gt;Men are a gender group referenced in comparison to women regarding serotonin levels.&lt;SEP&gt;Men, particularly around age 30, are the most commonly affected demographic for Proctitis.</data>
  <data key="d3">chunk-2679367b0beba9113c18be86c1ebf3c5&lt;SEP&gt;chunk-684465558da6f22c66a6b34b82cea78c&lt;SEP&gt;chunk-9102756028539b9228bf8362c3e96772&lt;SEP&gt;chunk-dad561d3742857b36b06aba05376ddc3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786424474</data>
</node>
<node id="Psychiatric Patients">
  <data key="d0">Psychiatric Patients</data>
  <data key="d1">concept</data>
  <data key="d2">Psychiatric Patients represent the patient population of which about 5 % have hypochondriasis.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410602</data>
</node>
<node id="Panic Disorder">
  <data key="d0">Panic Disorder</data>
  <data key="d1">concept</data>
  <data key="d2">Panic Disorder is an anxiety disorder listed as a differential diagnosis to be ruled out in hypochondriasis assessment.&lt;SEP&gt;A psychological state characterized by acute, rapid-onset feelings of intense fear, discomfort, and a deep sense of destruction or death.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c&lt;SEP&gt;chunk-85e93febb58ca4aaa7f3d9330268ffbf</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786416556</data>
</node>
<node id="Complete Medical Workup">
  <data key="d0">Complete Medical Workup</data>
  <data key="d1">method</data>
  <data key="d2">Complete Medical Workup is a diagnostic method ordered to rule out physical disease when hypochondriasis is suspected.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410602</data>
</node>
<node id="Psychological Evaluation">
  <data key="d0">Psychological Evaluation</data>
  <data key="d1">method</data>
  <data key="d2">Psychological Evaluation is a diagnostic method used to rule out other psychiatric disorders in patients suspected of hypochondriasis.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410602</data>
</node>
<node id="Supportive Treatment">
  <data key="d0">Supportive Treatment</data>
  <data key="d1">method</data>
  <data key="d2">Supportive Treatment is a therapeutic approach aimed at helping patients live with symptoms and modify reinforcing behaviors in hypochondriasis.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410603</data>
</node>
<node id="Insight‑Oriented Treatment">
  <data key="d0">Insight‑Oriented Treatment</data>
  <data key="d1">method</data>
  <data key="d2">Insight‑Oriented Treatment is a therapeutic approach contrasted with supportive treatment for hypochondriasis.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410603</data>
</node>
<node id="Antidepressants">
  <data key="d0">Antidepressants</data>
  <data key="d1">artifact</data>
  <data key="d2">Antidepressants are medication artifacts used to treat masked depression and relieve anxiety in hypochondriasis patients.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410603</data>
</node>
<node id="Masked Depression">
  <data key="d0">Masked Depression</data>
  <data key="d1">concept</data>
  <data key="d2">Masked Depression is a form of depression that may be concealed in hypochondriasis and treated with antidepressants.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410603</data>
</node>
<node id="Prognosis Improvement Rate">
  <data key="d0">Prognosis Improvement Rate</data>
  <data key="d1">data</data>
  <data key="d2">Prognosis Improvement Rate indicates that 33 % to 55 % of patients with hypochondriasis experience significant improvement with current treatment methods.</data>
  <data key="d3">chunk-684465558da6f22c66a6b34b82cea78c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410603</data>
</node>
<node id="Hypothyroidism">
  <data key="d0">Hypothyroidism</data>
  <data key="d1">concept</data>
  <data key="d2">Hypothyroidism is a condition in which a person’s thyroid gland is not producing enough hormone.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410680</data>
</node>
<node id="Primary Hypothyroidism">
  <data key="d0">Primary Hypothyroidism</data>
  <data key="d1">concept</data>
  <data key="d2">Primary hypothyroidism is a type of hypothyroidism in which the thyroid does not produce an adequate amount of T4.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410680</data>
</node>
<node id="Secondary Hypothyroidism">
  <data key="d0">Secondary Hypothyroidism</data>
  <data key="d1">concept</data>
  <data key="d2">Secondary hypothyroidism develops when the pituitary gland does not.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410680</data>
</node>
<node id="T4">
  <data key="d0">T4</data>
  <data key="d1">concept</data>
  <data key="d2">T4 is the primary thyroid hormone whose production is insufficient in primary hypothyroidism.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410680</data>
</node>
<node id="TSH Level">
  <data key="d0">TSH Level</data>
  <data key="d1">data</data>
  <data key="d2">TSH level is a blood measurement used to monitor thyroid function and adjust medication dosage.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410680</data>
</node>
<node id="Hashimotos Disease">
  <data key="d0">Hashimotos Disease</data>
  <data key="d1">concept</data>
  <data key="d2">Hashimoto’s disease is an autoimmune disorder that attacks the thyroid gland, leading to tissue destruction and hypothyroidism.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410680</data>
</node>
<node id="Radioactive Iodine (Iodine-131)">
  <data key="d0">Radioactive Iodine (Iodine-131)</data>
  <data key="d1">artifact</data>
  <data key="d2">Radioactive iodine (iodine-131) is used to treat hyperthyroidism and may cause loss of thyroid hormone production.</data>
  <data key="d3">chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786410681</data>
</node>
<node id="Lithium">
  <data key="d0">Lithium</data>
  <data key="d1">artifact</data>
  <data key="d2">Lithium is a medication that can contribute to hypothyroidism.&lt;SEP&gt;Lithium is a medication used to treat depression that can increase amniotic fluid levels.</data>
  <data key="d3">chunk-9ec71b0a5c34e36d6cca673cad0a2921&lt;SEP&gt;chunk-b1385133e299def4ed989633bdbd7168</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786422809</data>
</node>
