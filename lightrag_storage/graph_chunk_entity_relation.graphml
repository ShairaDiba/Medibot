  <data key="d0">Itching</data>
  <data key="d1">concept</data>
  <data key="d2">Itching is a symptom associated with bacterial infection of wounds.&lt;SEP&gt;Itching is a symptom that nurses watch for after PTHC.</data>
  <data key="d3">chunk-6c5e751c6db20a49f7ca0a341eadc654&lt;SEP&gt;chunk-691c137b75421e29ad257ff721c4b853</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786419485</data>
