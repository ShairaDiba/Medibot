  <data key="d0">Huntingtons Disease Society of America</data>
  <data key="d1">organization</data>
  <data key="d2">The Huntington’s Disease Society of America provides pre‑test and post‑test counseling information for families affected by Huntington’s</data>
  <data key="d3">chunk-9ffb6a5b83f2819f01300f27ca7ca1b2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409633</data>
</node>
<node id="Increased Appetite">
  <data key="d0">Increased Appetite</data>
  <data key="d1">concept</data>
  <data key="d2">Increased appetite is a symptom reported in women with a hydatidiform mole.</data>
  <data key="d3">chunk-03146cdc1f2091b67696466e08fc65db</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786409676</data>
</node>
