</node>
<node id="Gamete">
  <data key="d0">Gamete</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Gamete is a general term for reproductive cells, such as sperm or egg, relevant to conception.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412231</data>
</node>
<node id="Laparoscopy">
  <data key="d0">Laparoscopy</data>
  <data key="d1">method</data>
  <data key="d2">Laparoscopy is a minimally invasive surgical method mentioned for treating endometriosis.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412231</data>
</node>
<node id="Zygote">
  <data key="d0">Zygote</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Zygote is the cell formed when a sperm fertilizes an egg, representing the earliest stage of embryonic development.</data>
  <data key="d3">chunk-ed0aad3bf0cbd3eab10e7535f31d9a6e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412231</data>
</node>
<node id="Insulin Resistance">
  <data key="d0">Insulin Resistance</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin resistance is a condition where body tissues have a lowered response to insulin, prompting higher insulin production to maintain normal blood glucose levels.</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412241</data>
</node>
<node id="Insulin Receptors">
  <data key="d0">Insulin Receptors</data>
  <data key="d1">concept</data>
  <data key="d2">Insulin receptors are cell surface proteins that bind insulin, enabling glucose uptake; their number can be reduced by obesity.</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412243</data>
</node>
<node id="Physical Activity">
  <data key="d0">Physical Activity</data>
  <data key="d1">concept</data>
  <data key="d2">Physical activity refers to the level of bodily movement, where low activity reduces muscle’s ability to use insulin effectively.&lt;SEP&gt;Physical activity refers to bodily exercise, which the text states has no restrictions before or after parentage testing.</data>
  <data key="d3">chunk-b785ff55416d26c9c9d2574c29ca4711&lt;SEP&gt;chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786418836</data>
</node>
<node id="Cushing Syndrome">
  <data key="d0">Cushing Syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Cushing syndrome is a disorder mentioned as a notable disease associated with insulin resistance.</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412243</data>
</node>
<node id="Genetic Mutations">
  <data key="d0">Genetic Mutations</data>
  <data key="d1">concept</data>
  <data key="d2">Genetic mutations may affect insulin receptors,</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412244</data>
</node>
<node id="Signaling Proteins">
  <data key="d0">Signaling Proteins</data>
  <data key="d1">concept</data>
  <data key="d2">Signaling proteins are intracellular molecules whose function may be altered by genetic mutations, influencing insulin signaling pathways.</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412244</data>
</node>
<node id="Glucose Transport">
  <data key="d0">Glucose Transport</data>
  <data key="d1">concept</data>
  <data key="d2">Glucose transport refers to the mechanisms by which glucose moves into cells, a process whose efficiency can be reduced by aging and genetic mutations.</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412244</data>
</node>
<node id="National Institute of Diabetes and Digestive and Kidney Diseases">
  <data key="d0">National Institute of Diabetes and Digestive and Kidney Diseases</data>
  <data key="d1">organization</data>
  <data key="d2">The National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK) issues guidelines recommending testing for type 2 diabetes and related risk factors.</data>
  <data key="d3">chunk-7e04fc4d9139221a4e00a150baf448e9</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412244</data>
</node>
<node id="Insomnia">
  <data key="d0">Insomnia</data>
  <data key="d1">concept</data>
  <data key="d2">Insomnia is the inability to obtain an adequate amount or quality of sleep, characterized by difficulty falling asleep, staying asleep, or early awakening.&lt;SEP&gt;Insomnia is a sleep disorder occasionally treated with phototherapy.</data>
  <data key="d3">chunk-a63b2129b947c78015eda0d29076ec61&lt;SEP&gt;chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421117</data>
</node>
<node id="Acute Insomnia">
  <data key="d0">Acute Insomnia</data>
  <data key="d1">concept</data>
  <data key="d2">Acute Insomnia, also called transient insomnia, is a short‑term form of insomnia lasting a reasonably brief period.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Chronic Insomnia">
  <data key="d0">Chronic Insomnia</data>
  <data key="d1">concept</data>
  <data key="d2">Chronic Insomnia is a long‑term form of insomnia diagnosed when symptoms persist for more than one month.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Primary Insomnia">
  <data key="d0">Primary Insomnia</data>
  <data key="d1">concept</data>
  <data key="d2">Primary Insomnia is a sleep disorder that cannot be attributed to another medical condition or disorder.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Secondary Insomnia">
  <data key="d0">Secondary Insomnia</data>
  <data key="d1">concept</data>
  <data key="d2">Secondary Insomnia is a sleep disorder that arises secondary to another condition, medication, or substance use.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Psychophysiological Insomnia">
  <data key="d0">Psychophysiological Insomnia</data>
  <data key="d1">concept</data>
  <data key="d2">Psychophysiological Insomnia is a form of insomnia triggered by anxiety and bedtime rituals that exacerbate sleep difficulty.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Sleep Diary">
  <data key="d0">Sleep Diary</data>
  <data key="d1">artifact</data>
  <data key="d2">A sleep diary is a self‑recorded log where patients note bedtimes, awakenings, and pre‑sleep activities, used to help diagnose insomnia.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
<node id="Sleep Apnea">
  <data key="d0">Sleep Apnea</data>
  <data key="d1">concept</data>
  <data key="d2">Sleep Apnea is a potentially serious breathing disorder related to insomnia and chronic lung conditions.&lt;SEP&gt;Sleep apnea is the major health problem...</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0&lt;SEP&gt;chunk-9afe775e3de6a2ede3813b294c2d7085</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786421098</data>
</node>
<node id="September 11, 2001 Terrorist Attacks">
  <data key="d0">September 11, 2001 Terrorist Attacks</data>
  <data key="d1">event</data>
  <data key="d2">The September 11, 2001 terrorist attacks are a historical event linked to increased insomnia prevalence in some individuals.</data>
  <data key="d3">chunk-534d6ba3b100e1635acf1b4b824578b0</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1786412300</data>
</node>
