  <data key="d2">Coronary Artery is a blood vessel that supplies oxygen‑rich blood to the heart muscle.</data>
  <data key="d3">chunk-895c5e07d9ff1dcdf835a5d197d6cf8c</data>
  <data key="d4">unknown_source</data>
