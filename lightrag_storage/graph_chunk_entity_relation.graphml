  <data key="d0">Fibroblasts</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Fibroblasts are connective tissue cells that are part of the composition of adhesions.&lt;SEP&gt;Fibroblasts are connective tissue cells that can accumulate very long chain fatty acids in Adrenoleukodystrophy.</data>
  <data key="d3">chunk-4c6845350ae9cecf9ea358b18b2d581b&lt;SEP&gt;chunk-b1571076590b816bc3bb0de3b67b9a10</data>
  <data key="d4">unknown_source</data>
